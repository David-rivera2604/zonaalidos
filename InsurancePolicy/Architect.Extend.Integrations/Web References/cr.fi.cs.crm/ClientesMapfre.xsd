<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:enc="http://www.coopeservidores.fi.cr/soa/UtilitariosCS/EncabezadoRespuesta" elementFormDefault="qualified" targetNamespace="http://www.coopeservidores.fi.cr/soa/UtilitariosCS/EncabezadoRespuesta" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <xsd:complexType name="EncabezadoRespuesta">
    <xsd:sequence>
      <xsd:element maxOccurs="1" name="idMensaje" type="xsd:string" />
      <xsd:element maxOccurs="1" name="fechaHora" type="xsd:dateTime" />
      <xsd:element minOccurs="0" maxOccurs="1" name="extensionServicio" nillable="true" type="enc:ExtensionServicio" />
      <xsd:element maxOccurs="1" name="estado" nillable="true" type="enc:EstadoRespuesta" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="ExtensionServicio">
    <xsd:sequence>
      <xsd:element minOccurs="0" maxOccurs="unbounded" name="extension" nillable="true" type="enc:Extension" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="Extension">
    <xsd:sequence>
      <xsd:element maxOccurs="1" name="clave" nillable="true" type="xsd:string" />
      <xsd:element maxOccurs="1" name="valor" nillable="true" type="xsd:string" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="EstadoRespuesta">
    <xsd:sequence>
      <xsd:element maxOccurs="unbounded" name="extension" nillable="true" type="enc:Extension" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:element name="encabezado" type="enc:EncabezadoRespuesta" />
</xsd:schema>