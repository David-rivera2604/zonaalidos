            <Item20 Ref="333" ControlType="XRLabel" Name="Texto251" Multiline="true" CanGrow="false" Text="MEDIO DE PAGO" TextAlignment="TopLeft" SizeF="800,17" LocationFloat="0,615" Font="Arial, 8.2pt, style=Bold" ForeColor="White" BackColor="255,239,0,49" Padding="4,4,2,2,100" Borders="All" BorderWidth="0.6" />
            <Item21 Ref="334" ControlType="XRTable" Name="Tabla252" SizeF="800,30" LocationFloat="0,632" Font="Arial, 8.3pt" Padding="5,5,2,2,100" Borders="All" BorderWidth="0.6">
              <Rows>
                <Item1 Ref="335" ControlType="XRTableRow" Weight="1">
                  <Cells>
                    <Item1 Ref="336" ControlType="XRTableCell" Name="Celda253" Weight="1" CanGrow="false" Multiline="true" TextAlignment="MiddleLeft">
