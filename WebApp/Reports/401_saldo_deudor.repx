        <Item18 Ref="104" ControlType="XRTable" Name="Tabla73" SizeF="800,50" LocationFloat="0,400" Font="Arial, 8.3pt" Padding="5,5,2,2,100" Borders="All" BorderWidth="0.6">
          <Rows>
            <Item1 Ref="105" ControlType="XRTableRow" Weight="1">
              <Cells>
                <Item1 Ref="106" ControlType="XRTableCell" Name="Celda74" Weight="1" CanGrow="false" Multiline="true" TextFitMode="ShrinkOnly" TextAlignment="MiddleLeft">
                  <ExpressionBindings>
                    <Item1 Ref="107" EventName="BeforePrint" PropertyName="Text" Expression="Concat(Iif([NUM_CONTRATO] &gt; 0, Concat('Contrato: ', [NUM_CONTRATO], ' - ', IsNull([NUM_CONTRATODesc], ''), '&#xA;'), ''), 'Préstamo: ', IsNull([NUM_PRESTAMO], ''), '  |  Inicio: ', Iif(IsNull([INI_PRESTAMO]) Or GetYear([INI_PRESTAMO]) &lt;= 1, '', FormatString('{0:dd/MM/yyyy}', [INI_PRESTAMO])), '  |  Vencimiento: ', Iif(IsNull([VCTO_PRESTAMO]) Or GetYear([VCTO_PRESTAMO]) &lt;= 1, '', FormatString('{0:dd/MM/yyyy}', [VCTO_PRESTAMO])), '&#xA;Suma asegurada informada: ', Iif(IsNull([IMP_SUMA_ASEG]) Or [IMP_SUMA_ASEG] &lt;= 0, '', FormatString('{0:n2}', [IMP_SUMA_ASEG])), '  |  Prima informada: ', Iif(IsNull([IMP_PRIMA_INFORMADA]) Or [IMP_PRIMA_INFORMADA] &lt;= 0, '', FormatString('{0:n2}', [IMP_PRIMA_INFORMADA])))" />
                  </ExpressionBindings>
                </Item1>
              </Cells>
            </Item1>
          </Rows>
        </Item18>
        <Item19 Ref="108" ControlType="XRLabel" Name="Texto75" Multiline="true" CanGrow="false" Text="ASPECTOS RELATIVOS AL RIESGO" TextAlignment="TopLeft" SizeF="800,17" LocationFloat="0,456" Font="Arial, 8.2pt, style=Bold" ForeColor="White" BackColor="255,239,0,49" Padding="4,4,2,2,100" Borders="All" BorderWidth="0.6" />
        <Item20 Ref="109" ControlType="XRLabel" Name="Texto76" Multiline="true" Text="¿Alguna vez ha tenido alguna(s) condición(es), signo(s) o síntomas(s) manifestados y/o evidentes que aún no ha recibido atención médica, ha padecido, ha sido informado que ha padecido, o ha recibido consejo o tratamiento o cirugía por alguna de las siguientes condiciones?" TextAlignment="TopLeft" SizeF="800,36" LocationFloat="0,473" Font="Arial, 8.1pt" Padding="4,4,2,2,100" Borders="All" BorderWidth="0.6" />
        <Item21 Ref="110" ControlType="XRTable" Name="Tabla77" SizeF="800,18" LocationFloat="0,509" Font="Arial, 8.1pt, style=Bold" Padding="5,5,2,2,100" Borders="All" BorderWidth="0.6">
          <Rows>
            <Item1 Ref="111" ControlType="XRTableRow" Weight="1">
              <Cells>
                <Item1 Ref="112" ControlType="XRTableCell" Name="Celda78" Weight="0.875" CanGrow="false" Multiline="true" Text="Marque con una X su respuesta" TextAlignment="MiddleLeft" />
                <Item2 Ref="113" ControlType="XRTableCell" Name="Celda79" Weight="0.0625" CanGrow="false" Multiline="true" Text="SI" TextAlignment="MiddleLeft" />
