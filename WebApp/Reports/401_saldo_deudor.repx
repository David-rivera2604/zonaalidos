                        <Item1 Ref="337" ControlType="XRLabel" Name="Texto254" Multiline="true" CanGrow="false" Text="PERIODICIDAD:" TextAlignment="TopLeft" SizeF="105,23" LocationFloat="3,5" Font="Arial, 8.3pt, style=Bold" Padding="4,4,2,2,100" Borders="None" />
                        <Item2 Ref="338" ControlType="XRCheckBox" Name="Casilla255" Text="Mensual" SizeF="100,19" LocationFloat="112,7" Font="Arial, 7.5pt, style=Bold" Borders="None" />
                        <Item3 Ref="339" ControlType="XRLabel" Name="Texto256" Multiline="true" CanGrow="false" Text="FORMA DE PAGO:" TextAlignment="TopLeft" SizeF="300,23" LocationFloat="220,5" Font="Arial, 8.3pt, style=Bold" Padding="4,4,2,2,100" Borders="None" />
