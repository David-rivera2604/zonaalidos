        <Item22 Ref="115" ControlType="XRTable" Name="SaludPregunta01" SizeF="800,62" LocationFloat="0,527" Font="Arial, 8.1pt" Padding="5,5,2,2,100" Borders="All" BorderWidth="0.6">
          <Rows>
            <Item1 Ref="116" ControlType="XRTableRow" Weight="1">
              <Cells>
                <Item1 Ref="117" ControlType="XRTableCell" Name="Celda82" Weight="0.875" CanGrow="false" Multiline="true" Text="¿Cualquier desorden neurológico, sistema nervioso depresión, ansiedad, epilepsia y otros, sistema respiratorio, gastrointestinal, endocrinólogos o genito-urinario, diabetes, hipertensión, angina de pecho, colesterol o triglicéridos altos, trastornos de las arterias coronarias,  problemas cardíacos o del sistema cardiovascular o los vasos sanguíneos, desorden de la sangre, transfusión de sangre problemas con la columna vertebral y/o los discos intervertebrales?" TextAlignment="MiddleLeft" />
                <Item2 Ref="118" ControlType="XRTableCell" Name="Celda83" Weight="0.0625" CanGrow="false" Multiline="true" TextAlignment="MiddleLeft" />
