@model IEnumerable<aliados.Models.Masivos.PlantillaDocumentoViewModel>

<div class="modal inmodal" id="plantillasModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content animated bounceInRight">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">Cerrar</span></button>
                <h4 class="modal-title">Plantillas disponibles</h4>
                <small class="font-bold">Documentos guía disponibles para descarga.</small>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table id="plantillasTbl" class="table table-striped table-bordered" style="font-size: 11px;">
                        <thead>
                            <tr>
                                <th>Nombre del documento</th>
                                <th>Descargar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var plantilla in Model)
                                {
                                    <tr>
                                        <td>@plantilla.NombreDocumento</td>
                                        <td><a href="@plantilla.UrlDescarga">Descargar</a></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2" class="text-center text-muted">No hay plantillas disponibles.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-white" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
