@model IEnumerable<aliados.Models.Masivos.PlantillaDocumentoViewModel>
@{
    Layout = "~/Views/_Layout.cshtml";
}
@Styles.Render("~/Content/cssCRUD")

<div class="row">
    <div id="mainBlock" class="col-md-12 p-0">
        <div class="ibox">
            <div class="ibox-title p-0">
                <div class="Title_Prin py-2">
                    <div class="title_design T1">
                        <h5><i class="fa fa-upload"></i> <span id="PageTitle">Masivos</span></h5><br>
                        <small class="m-l-sm"><span id="PageSubTitle"> Carga de plantillas CSV.</span></small>
                    </div>
                    <div class="title_partner T2">
                        <p class="text-muted small" id="MasivosIntroText">
                            Gestión de plantillas para carga masiva y procesamiento de registros.
                        </p>
                        <h4 class="text-muted" style="color: #c31f09" id="MasivosRequiredFieldsText">
                            Los campos marcados con asterisco rojo son obligatorios.
                        </h4>
                    </div>
                    <div class="title_partner T3 text-center">
                        <a id="MasivosLinkText" href="#" onclick="return false;">Plantillas de carga</a>
                        <p id="MasivosSloganText" class="mt-2 text-center">
                            Seleccione el ramo, cargue el archivo CSV y procese los registros pendientes.
                        </p>
                    </div>
                </div>
            </div>
            <div class="ibox-content box_design">
                <div class="sk-spinner sk-spinner-wave">
                    <div class="sk-rect1"></div>
                    <div class="sk-rect2"></div>
                    <div class="sk-rect3"></div>
                    <div class="sk-rect4"></div>
                    <div class="sk-rect5"></div>
                </div>

                <div id="generalNotify"></div>

                <div class="form-row">
                    <div class="col-md-12 m-2">
                        <div id="MasivosEdt" class="animated fadeInRight">
                            <form id="MasivosEdtForm" class="form-horizontal" data-toggle="validator">
                                <fieldset>
                                    <div class="form-row">
                                        <div class="col-md-12">
                                            <h4><i class="fa fa-folder-open"></i> <span id="MasivosCargaTitle">Datos de carga</span></h4>
                                            <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                            <div class="form-row">
                                                <div class="col-sm-3 col-md-3">
                                                    <div class="form-group">
                                                        <label class="control-label" for="cod_ramo">Código de ramo<span class="required-mark" title="Este campo debe ser llenado de forma obligatoria">*</span></label>
                                                        <select id="cod_ramo" name="cod_ramo" class="form-control">
                                                            <option value="">Seleccione</option>
                                                            <option value="302">302 - Emisor Masivo MAPFREMas</option>
                                                            <option value="207">207 - Emisor Masivo Todo Riesgo Material</option>
                                                            <option value="201">201 - Emisor Masivo Hogar Acreedor</option>
                                                            <option value="202">202 - Emisor Masivo Multirriesgo Acreedor</option>
                                                        </select>
                                                    </div>
                                                </div>

                                                <div class="col-sm-5 col-md-5">
                                                    <div class="form-group">
                                                        <label class="control-label" for="archivoCsv">Archivo CSV<span class="required-mark" title="Este campo debe ser llenado de forma obligatoria">*</span></label>
                                                        <div class="input-group">
                                                            <input id="archivoCsv" name="archivoCsv" type="text" class="form-control" placeholder="Seleccione un archivo CSV" readonly>
                                                            <div class="input-group-append">
                                                                <span class="btn btn-default fileinput-button" title="Permite seleccionar el archivo CSV a cargar">
                                                                    <span>Examinar...</span>
                                                                    <input id="fileUpload" type="file" accept=".csv,text/csv">
                                                                </span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-sm-4 col-md-4">
                                                    <div class="form-group">
                                                        <label class="control-label" for="txt_archivo_carga">Nombre del archivo</label>
                                                        <input type="text" id="txt_archivo_carga" name="txt_archivo_carga" class="form-control" maxlength="255" readonly />
                                                    </div>
                                                </div>

                                                <div class="col-sm-12 col-md-12 text-right" style="margin-top: 8px;">
                                                    <button id="btnVerPlantillas" type="button" class="btn btn-white">
                                                        <i class="fa fa-list"></i> Ver plantillas
                                                    </button>
                                                    <button id="btnCargarCsv" type="button" class="btn btn-primary">
                                                        <i class="fa fa-cloud-upload"></i> Cargar CSV
                                                    </button>
                                                    <button id="btnProcesar" type="button" class="btn btn-primary">
                                                        <i class="fa fa-gears"></i> Procesar
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-row">
                                        <div class="col-lg-12">
                                            <h4><i class="fa fa-table"></i> <span id="MasivosListadoTitle">Cargas registradas</span></h4>
                                            <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                            <div class="form-row">
                                                <div class="col-md-12" style="padding-bottom: 20px">
                                                    <div class="table-responsive">
                                                        <table id="masivosTbl" class="table table-striped table-bordered" style="font-size: 11px;">
                                                            <thead>
                                                                <tr>
                                                                    <th>ID</th>
                                                                    <th>Ramo</th>
                                                                    <th>Estructura</th>
                                                                    <th>Archivo</th>
                                                                    <th>Tamaño</th>
                                                                    <th>Usuario</th>
                                                                    <th>Fecha</th>
                                                                    <th>Estado</th>
                                                                    <th>Acción</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <tr>
                                                                    <td colspan="9" class="text-center text-muted">Aún no hay registros para mostrar.</td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.Partial("_PlantillasModal", Model)

@section Scripts {
    @Scripts.Render("~/bundles/jsCRUD")
    <script src="@Url.Content("~/Scripts/Masivos.js")"></script>
    <script src="@Url.Content("~/Scripts/Masivos.Api.js")"></script>
    <script src="@Url.Content("~/Scripts/Masivos.Ui.js")"></script>
}
