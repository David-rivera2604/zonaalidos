@{
    Layout = null;
}

<!DOCTYPE html>
<html>

<head>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Zona de Aliados | Acceso</title>

    @Styles.Render("~/Content/cssBase")
    @Scripts.Render("~/bundles/jsMaster")
    @Styles.Render("~/app/css/Login.css")
    <link rel="shortcut icon" href="~/images/favicon.png" />

    <style>
        .entraid-separator {
            display: flex;
            align-items: center;
            text-align: center;
            margin: 12px 0;
            color: #aaa;
            font-size: 13px;
        }

            .entraid-separator::before,
            .entraid-separator::after {
                content: '';
                flex: 1;
                border-bottom: 1px solid #ddd;
            }

            .entraid-separator span {
                padding: 0 10px;
            }

        .entraid-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            padding: 10px;
            background: #fff;
            color: #444;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.2s, box-shadow 0.2s;
            margin-bottom: 10px;
        }

            .entraid-btn:hover {
                background: #f5f5f5;
                box-shadow: 0 1px 4px rgba(0,0,0,0.15);
            }
    </style>

    <!-- Google Tag Manager -->
    <script>
        (function (w, d, s, l, i) {
            w[l] = w[l] || []; w[l].push({
                'gtm.start':
                    new Date().getTime(), event: 'gtm.js'
            }); var f = d.getElementsByTagName(s)[0],
                j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : ''; j.async = true; j.src =
                    'https://www.googletagmanager.com/gtm.js?id=' + i + dl; f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', 'GTM-NL4F2ZN');</script>
    <!-- End Google Tag Manager -->

</head>
<body class="gray-bg Mapfre @ViewBag.theme" style="--mapfrered1: rgb(255, 0, 45); --mapfrered2: rgb(255, 0, 45); ">

    <!-- Google Tag Manager (noscript) -->
    <noscript>
        <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NL4F2ZN"
                height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    <div class="container">
        <div class="alert alert-info alert-dismissable fade show di_aleLog d-none ">
            <button data-dismiss="alert" class="close" type="button">×</button>
            <span id="SessionExpiredMessage">Usted ha sido redireccionado a esta página debido a que su sesión de usuario ha superado el tiempo máximo de inactividad.</span>
        </div>

        <form id="LoginEdtForm">

            <img class="logohorizontal" src="~/images/Mapfre-logo.png">
            <h3 id="LoginWelcomeTitle">Bienvenido a nuestra Zona de Aliados</h3>

            <div class="form-group">
                <div class="input-group Mydis">
                    <input id="Tenant" name="Tenant" type="text" maxlength="60" required="" autocomplete="off" value="MAPFRE" title="Nombre o código del aliado" placeholder="Nombre del Aliado" disabled>
                </div>
                <div id='Tenant_validate'></div>
            </div>
            <div class="entraid-separator">
                <span>o</span>
            </div>
            <button id="EntraIdLogin" type="button" class="entraid-btn" title="Autenticar con cuenta Microsoft Entra ID">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 21 21">
                    <rect x="1" y="1" width="9" height="9" fill="#f25022" />
                    <rect x="11" y="1" width="9" height="9" fill="#7fba00" />
                    <rect x="1" y="11" width="9" height="9" fill="#00a4ef" />
                    <rect x="11" y="11" width="9" height="9" fill="#ffb900" />
                </svg>
                Continuar con Microsoft
            </button>
        </form>

    </div>

    <script src="@Url.Content("~/app/js/core.language.js")"></script>
    <script src="@Url.Content("~/Scripts/Acceso/Ingreso.js")"></script>
    <script>

        // ─── Microsoft Entra ID – OAuth 2.0 Authorization Code Flow ──────────────
        document.getElementById("EntraIdLogin").addEventListener("click", function () {
            window.location.href = "@Url.Action("Login", "EntraID", new { tenant = "mapfre" })";
        });
        // ─────────────────────────────────────────────────────────────────────────

    </script>


</body>

</html>

