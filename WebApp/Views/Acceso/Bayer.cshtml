@{
    Layout = null;
}

<!DOCTYPE html>
<html>

<head>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Zona de Aliados | Acceso Bayer</title>

    @Styles.Render("~/Content/cssBase")
    @Scripts.Render("~/bundles/jsMaster")
    @Styles.Render("~/app/css/Login.css")
    <link rel="shortcut icon" href="~/images/favicon.png" />

    <style>
        .okta-separator {
            display: flex;
            align-items: center;
            text-align: center;
            margin: 12px 0;
            color: #aaa;
            font-size: 13px;
        }

            .okta-separator::before,
            .okta-separator::after {
                content: '';
                flex: 1;
                border-bottom: 1px solid #ddd;
            }

            .okta-separator span {
                padding: 0 10px;
            }

        .okta-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            padding: 10px;
            background: #fff;
            color: #444;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.2s, box-shadow 0.2s;
            margin-bottom: 10px;
        }

            .okta-btn:hover {
                background: #f5f5f5;
                box-shadow: 0 1px 4px rgba(0,0,0,0.15);
            }
    </style>

</head>
<body class="gray-bg Bayer @ViewBag.theme">

    <div class="container">
        <div class="alert alert-info alert-dismissable fade show di_aleLog d-none ">
            <button data-dismiss="alert" class="close" type="button">×</button>
            <span id="SessionExpiredMessage">Usted ha sido redireccionado a esta página debido a que su sesión de usuario ha superado el tiempo máximo de inactividad.</span>
        </div>

        <form id="LoginEdtForm">

            <img class="logohorizontal" src="~/images/Mapfre-logo.png">
            <h3 id="LoginWelcomeTitle">Bienvenido a la Zona Bayer</h3>

            <div class="form-group">
                <div class="input-group Mydis">
                    <input id="Tenant" name="Tenant" type="text" maxlength="60" required="" autocomplete="off" value="Bayer" title="Nombre o código del aliado" placeholder="Nombre del Aliado" disabled>
                </div>
                <div id='Tenant_validate'></div>
            </div>

            <div class="okta-separator">
                <span>Acceso seguro</span>
            </div>

            <button id="OktaLogin" type="button" class="okta-btn" title="Autenticar con cuenta Okta">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24">
                    <path fill="#007DC1" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 15a5 5 0 1 1 0-10 5 5 0 0 1 0 10z"/>
                </svg>
                Continuar con Okta
            </button>
        </form>

    </div>

    <script src="@Url.Content("~/app/js/core.language.js")"></script>
    <script src="@Url.Content("~/Scripts/Acceso/Ingreso.js")"></script>
    <script>

        // ─── Okta – OAuth 2.0 / OIDC Authorization Code Flow ─────────────────────
        document.getElementById("OktaLogin").addEventListener("click", function () {
            window.location.href = "@Url.Action("Login", "Okta", new { tenant = "bayer" })";
        });
        // ─────────────────────────────────────────────────────────────────────────

    </script>


</body>

</html>
