<configuration>
	<appSettings>
		<!-- Security -->
		<add key="Token.Mode" value="JWT" />
		<add key="Jwt:SecretKey" value="GearSoftJcv1821@t74" />
		<add key="Jwt:Issuer" value="Issuer" />
		<add key="Jwt:https" value="AliadosKey" />
		<add key="Jwt:Audience" value="Audience" />
		<add key="Security.Password.Expiration" value="180" />
		<!-- Kernel -->
		<add key="Architect.DataFactory.Log.MultiThread" value="true" />
		<add key="Architect.DataFactory.Cache.Expiration" value="10" />
		<add key="Architect.DataFactory.Trace.Enabled" value="True" />
		<!-- Ruta usada para almacenar los archivo generado por el llamado a traza, error, warnings usando la clase LogHandler -->
		<add key="Path.Logs" value="C:\bitbucket\aliados\webapp\logs" />
		<!-- Habilita (True) o no (False) la creación de traza en el código -->
		<add key="FrontOffice.Debug" value="True" />
		<!-- Indica si la traza solo se debe hace en disco (File) o si adicionalmente se hará en la base de datos -->
		<add key="FrontOffice.Debug.Mode" value="File" />
		<!-- Development, Quality, Production -->
		<add key="Working.Mode" value="Development" />
		<!-- Permite habilitar el modo de ejecución del servicio de datos, 'Local' para ejecutar de forma directa o 'Remote' para ejecutar por medio de WebService -->
		<add key="DataManager.Mode" value="Local" />
		<!-- Habilita (True) o no (False) la creación de traza por cual quien acceso a datos por medio de la librería DataAccessLayer -->
		<add key="DataAccessLayer.Debug" value="True" />
		<!-- Habilita (True) o no (False) mayor detalle para la traza -->
		<add key="DataAccessLayer.Debug.DetailsCall" value="True" />
		<!-- Zona aliados tron -->
		<add key="Mapfre.Tron.cod_cia" value="1" />
		<add key="Mapfre.Tron.cod_nivel1" value="1" />
		<add key="Mapfre.Tron.cod_nivel2" value="101" />
		<add key="Mapfre.Tron.cod_nivel3" value="1011" />
		<add key="Mapfre.Tron.cod_modalidad" value="99999" />
		<add key="Mapfre.Tron.RutaImpresion" value="http://10.115.30.131:8082" />
		<!-- Net -->
		<add key="webpages:Version" value="3.0.0.0" />
		<add key="webpages:Enabled" value="false" />
		<add key="ClientValidationEnabled" value="true" />
		<add key="UnobtrusiveJavaScriptEnabled" value="true" />
	</appSettings>
	<connectionStrings>
		<!-- LOCAL
		<add name="Research" connectionString="Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=localhost)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=XE)));User ID=ALIADOS;Password=ALIADOS2021;Min Pool Size=1;Incr Pool Size=1;Decr Pool Size=1;Connection Lifetime=15;Statement Cache Size=100;" providerName="Oracle.DataAccess.Client" />
		<add name="Tron" connectionString="Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=10.114.20.68)(PORT=1525))(CONNECT_DATA=(SERVICE_NAME=DESCR)));User ID=TRON2000;Password=TRON2000CA;Min Pool Size=1;Incr Pool Size=1;Decr Pool Size=1;Connection Lifetime=15;Statement Cache Size=100;" providerName="Oracle.DataAccess.Client" />
		-->
		<!-- QA -->
		<add name="research" connectionString="Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=10.115.30.131)(PORT=1525))(CONNECT_DATA=(SERVICE_NAME=OF0)));User ID=ALIADOS;Password=ALIADOS2021;" providerName="oracle.dataaccess.client" />
		<add name="Tron" connectionString="Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=10.115.30.131)(PORT=1525))(CONNECT_DATA=(SERVICE_NAME=OF0)));User ID=TRON2000;Password=WARAIRA2022;Min Pool Size=1;Incr Pool Size=1;Decr Pool Size=1;Connection Lifetime=15;Statement Cache Size=100;" providerName="Oracle.DataAccess.Client" />
	</connectionStrings>
	<system.web>
		<customErrors mode="Off" />
		<compilation debug="true" targetFramework="4.8" />
		<httpRuntime targetFramework="4.8" />
	</system.web>
	<system.webServer>
		<handlers>
			<remove name="ExtensionlessUrlHandler-Integrated-4.0" />
			<remove name="OPTIONSVerbHandler" />
			<remove name="TRACEVerbHandler" />
			<add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
		</handlers>
	</system.webServer>
