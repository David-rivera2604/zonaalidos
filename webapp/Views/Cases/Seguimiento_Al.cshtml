@{
    Layout = "~/Views/_Layout.cshtml";
}
@Styles.Render("~/Content/cssCRUD")

<div class="row">
    <div class="col-md-5">
        <div class="row">

            <div class="Casos_St">
                <div class="Inputs" style=" align-items: baseline; display: flex;">
                    <div class="input-bx buscaCa">
                        <input class="form-control search-input" type="text" autocomplete="off" id="Buscador">
                        <span>Búsqueda</span>
                        <i class="bi bi-search"></i>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="input-icon" viewBox="0 0 16 16">
                            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"></path>
                        </svg>
                    </div>
                    <div style="height: 10px;position: relative;margin-left: 10px;width: 23%;">
                        <div class='form-group'>
                            <label class='control-label' for='Estado'>Estado</label>
                            <select id='Estado' name='Estado' class='form-control'>
                                <option value="No" selected>Todos</option>
                                <option value="Inicio">Inicio</option>
                                <option value="En progreso">En progreso</option>
                                <option value="Finalizado">Finalizado</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="ibox-title">
                    <h5><i class="fa fa-address-card"></i> Casos</h5>

                </div>
                <div class="Title_Caso">
                    <div class="Column_Case CodTi">
                        <p>Codigo</p>
                    </div>
                    <div class="Column_Case a2">
                        <p>Asunto</p>
                    </div>

                    <div class="Column_Case">
                        <p>Estado</p>
                    </div>
                </div>
                <div class="ibox ult_in">
                    <div class="ibox-content CasesBox">
                        <div>
                            <div id="Casos_Lista" class="table1">

                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>

    </div>
    <div id="Cases_Info" class="col-md-7 d-none XEspeCaseBox">

        <div class="row">
            <div class="col-md-12">
                <div class="row animated fadeInRight">
                    <div class="ibox-title EstTi">
                        <h5><i class="fa fa-th-list" aria-hidden="true"></i> Estado del Caso</h5>
                    </div>
                    <div class="animated fadeInRight" id="ContenCase" style="width: 96%;">
                        <div class="col-sm-12">
                            <!-- ProcessCase -->
                            <div class="ibox">
                                <div class="Title_Case">
                                    <h5>
                                        <i class="fa fa-inbox"></i> <span id="Title" title="Descripción del caso"></span>
                                        <small class="m-l-sm"><span id="FlowIdDesc" title="Proceso asociado al caso"></span></small>
                                    </h5>

                                </div>
                                <div class="row">
                                    <div class="Progres_Bar">
                                        <div class="col infoCase">
                                            <small class="stats-label">Etapa actual</small>
                                            <p id="CurrentStep" class="fw-600"></p>
                                        </div>
                                        <div class="col infoCase">
                                            <small class="stats-label">Progreso</small>
                                            <div class="progress" style="margin: 0px 2px 20px 2px;">
                                                <div style="width: 0%;" class="progress-bar progress-bar-danger ProgreCase"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="row ">
                                <div class="col-lg-12">
                                    <div id="tabs" class="tabs-container">
                                        <ul class="nav nav-tabs" role="tablist">
                                            <li><a class="nav-link" data-toggle="tab" href="#Seguimiento"><i class="fa fa-sitemap"></i> Seguimiento</a></li>
                                            <li><a class="nav-link" data-toggle="tab" href="#Notas"><i class="fa fa-edit"></i> Notas</a></li>
                                            <li><a class="nav-link" data-toggle="tab" href="#Adjuntos"><i class="fa fa-paperclip"></i> Adjuntos</a></li>
                                        </ul>
                                        <div class="tab-content">
                                            <!-- Seguimiento -->
                                            <div role="tabpanel" id="Seguimiento" class="tab-pane active">
                                                <div class="panel-body CaseTab">
                                                    <div class='row'>
                                                        <div id="Stages" class='col-md-12'>
                                                            <div class="table-responsive Table_State" style="padding: 0px 2px 0px 2px; overflow-x:unset;">
                                                                <table id="ProcessGridTbl" style="font-size: 12px" class="table table-bordered table-hover table-index "></table>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <!-- Notas -->
                                            <div role="tabpanel" id="Notas" class="tab-pane">
                                                <div class="panel-body">
                                                    <!-- Attachments Grid -->
                                                    @Html.Partial("../Common/_notes")
                                                </div>
                                            </div>

                                            <!-- Adjuntos -->
                                            <div role="tabpanel" id="Adjuntos" class="tab-pane">
                                                <div class="panel-body">
                                                    @Html.Partial("../Common/_attachments_grid")
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
    <!-- Attachments Grid Modal -->
    @Html.Partial("../Common/_attachments_modal")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jsCRUD")

    <script src="@Url.Content("~/assets/apexcharts/apexcharts.min.js")"></script>
    <script src="@Url.Content("~/assets/tableExport.jquery.plugin/tableExport.min.js")"></script>
    <script src="@Url.Content("~/assets/bootstrap-table/extensions/export/bootstrap-table-export.js")"></script>
    <script src="@Url.Content("~/assets/template7/template7.min.js")"></script>
    <script src="@Url.Content("~/Scripts/Common.Attachments.js")"></script>
    <script src="@Url.Content("~/Scripts/Common.Notes.js")"></script>
    <script src="@Url.Content("~/Scripts/Seguimiento_Aliados.js")"></script>
    <script src="@Url.Content("~/Scripts/CreateCase_Aliados.js")"></script>
    <script src="@Url.Content("~/Scripts/ManagerLinks.UI.js")"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            app.CaseInfo.Init();
            app.EspecifiCase.Init();
        });
    </script>
}
