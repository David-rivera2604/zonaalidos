                            <div class="col-md-2 d-none">
                                <small id="ReferenceCaption6" class="stats-label"></small>
                                <p id="Reference6" class="fw-600"></p>
                            </div>
                            <div class="col-md-3 d-none">
                                <small id="ReferenceCaption7" class="stats-label"></small>
                                <p id="Reference7" class="fw-600"></p>
