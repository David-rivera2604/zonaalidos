@{
    Layout = "~/Views/_LayoutEx.cshtml";
}
@Styles.Render("~/Content/cssCRUD")
<link href="~/assets/dropzone/css/dropzone.min.css" rel="stylesheet" />
<link href="~/assets/animatecss/animate.min.css" rel="stylesheet" />

<div class="row animated fadeInRight">
    <div class="col-sm-12">
        <!-- ProcessCase -->
        <div class="ibox">
            <div class="ibox-title">
                <h5>
                    <i class="fa fa-inbox"></i> <span id="Title" title="Descripción del caso"></span>
                    <small class="m-l-sm"><span id="FlowIdDesc" title="Proceso asociado al caso"></span></small>
                </h5>
                <div class="ibox-tools">
                    <span id="StatusDesc" class="label" title="Estado/Etiqueta actual"></span>
                    <a class="collapse-link" href="">
                        <i class="fa fa-chevron-down"></i>
                    </a>
                    <a href="" class="Historial-link" title="Historial">
                        <i class="fa fa-clock-o"></i>
                    </a>
                    <a id="ExternalLinksParent" class="dropdown-toggle d-none" data-toggle="dropdown" href="#" title="Enlaces de interés">
                        <i class="fa fa-bookmark-o"></i>
                    </a>
                    <ul id="ExternalLinks" class="dropdown-menu dropdown-user">
                        @*<li>
                                <a href="#" class="dropdown-item">Config option A</a>
                            </li>
                            <li>
                                <a href="#" class="dropdown-item">Config option B</a>
                            </li>*@
                    </ul>
                </div>
            </div>
            <div class="ibox-content ibox-heading">

                <div class="row">
                    <div class="col-md-2 d-none description-col">
                        <small id="DescriptionLabel" class="stats-label">Descripción</small>
                        <p id="Description" class="fw-600"></p>
                    </div>
                    <div class="col-md-7">
                        <div class="row">
                            <div class="col-md-3">
                                <small id="PriorityLabel" class="stats-label">Prioridad</small>
                                <p id="PriorityDesc" class="fw-600"></p>
                            </div>
                            <div class="col-md-3">
                                <small id="ContactLabel" class="stats-label">Contacto</small>
                                <p id="ContactMainName" class="fw-600"></p>
                            </div>
                            <div class="col-md-3">
                                <small id="ContactMainEmailLabel" class="stats-label">Correo electrónico</small>
                                <p id="ContactMainEmail" class="fw-600"></p>
                            </div>
                            <div class="col-md-2">
                                <small id="SLALabel" class="stats-label">Acuerdo de servicio</small>
                                <p id="SLADesc" class="fw-600"></p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3 d-none">
                                <small id="ReferenceCaption1" class="stats-label"></small>
                                <p id="Reference1" class="fw-600"></p>
                            </div>
                            <div class="col-md-3 d-none">
                                <small id="ReferenceCaption2" class="stats-label"></small>
                                <p id="Reference2" class="fw-600"></p>
                            </div>
                            <div class="col-md-3 d-none">
                                <small id="ReferenceCaption3" class="stats-label"></small>
                                <p id="Reference3" class="fw-600"></p>
                            </div>
                            <div class="col-md-2 d-none">
                                <small id="ReferenceCaption4" class="stats-label"></small>
                                <p id="Reference4" class="fw-600"></p>
                            </div>
                            <div class="col-md-2 d-none">
                                <small id="ReferenceCaption5" class="stats-label"></small>
                                <p id="Reference5" class="fw-600"></p>
                            </div>
                            <div class="col-md-2 d-none">
                                <small id="ReferenceCaption6" class="stats-label"></small>
                                <p id="Reference6" class="fw-600"></p>
                            </div>
                            <div class="col-md-3 d-none">
                                <small id="ReferenceCaption7" class="stats-label"></small>
                                <p id="Reference7" class="fw-600"></p>
                            </div>
                            <div class="col-md-3 d-none">
                                <small id="ReferenceCaption8" class="stats-label"></small>
                                <p id="Reference8" class="fw-600"></p>
                            </div>
                            <div class="col-md-2 d-none">
                                <small id="ReferenceCaption9" class="stats-label"></small>
                                <p id="Reference9" class="fw-600"></p>
                            </div>
                            <div class="col-md-2 d-none">
                                <small id="ReferenceCaption10" class="stats-label"></small>
                                <p id="Reference10" class="fw-600"></p>
                            </div>
                        </div>

                    </div>
                    <div class="col-md">
                        <div class="col">
                            <small id="ProgressLabel" class="stats-label">Progreso</small>
                            <div class="progress" style="margin: 0px 2px 3px 2px;">
                                <div style="width: 0%;" class="progress-bar progress-bar-danger"></div>
                            </div>
                        </div>
                        <div class="col">
                            <small id="CurrentStepLabel" class="stats-label">Etapa actual</small>
                            <p id="CurrentStep" class="fw-600"></p>
                        </div>
                        <div class="col">
                            <small id="TotalDaysLabel" class="stats-label">Cantidad de Dias</small>
                            <p id="TotalDays" class="fw-600"></p>
                        </div>
                    </div>
                </div>


            </div>
            @*<div class="ibox-content" >
                </div>*@
            @*<div class="ibox-content">
                    <div class="sk-spinner sk-spinner-wave">
                        <div class="sk-rect1"></div>
                        <div class="sk-rect2"></div>
                        <div class="sk-rect3"></div>
                        <div class="sk-rect4"></div>
                        <div class="sk-rect5"></div>
                    </div>
                    <div id="generalNotify">
                    </div>
                </div>*@
        </div>
    </div>
    <div class="col-md-12">
        <div class="row">
            <div class="col-lg-12">
                <div id="tabs" class="tabs-container">
                    <ul class="nav nav-tabs" role="tablist">
                        <li><a class="nav-link active" data-toggle="tab" href="#Tareas"><i class="fa fa-tasks"></i> Etapa : <span id="StepDescription"></span></a></li>
                        <li><a class="nav-link" data-toggle="tab" href="#Seguimiento"><i class="fa fa-sitemap"></i> Seguimiento</a></li>
                        <li><a class="nav-link" data-toggle="tab" href="#Notas"><i class="fa fa-edit"></i> Notas</a></li>
                        <li><a class="nav-link" data-toggle="tab" href="#Adjuntos"><i class="fa fa-paperclip"></i> Adjuntos</a></li>
                    </ul>
                    <div class="tab-content">
                        <!-- Seguimiento -->
                        <div role="tabpanel" id="Tareas" class="tab-pane active ">
                            <div class="panel-body">

                                <form id='ReferencesEdtForm' class='form-horizontal' data-toggle='validator' style=" margin-left: 10px; margin-right: 10px;margin-top: 6px;">
                                    <fieldset>
                                        @Html.Partial("_references")
                                    </fieldset>

                                </form>

                                <div class='row'>
                                    <div id="ChangeStage" class='col-md-12 d-none'>
                                        <div class='col-md-12'>
                                            <h4>Opciones disponibles para avanzar</h4>
                                            <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                        </div>
                                        <form id='VisualizationsEdtForm' class='form-horizontal' data-toggle='validator' style=" margin-left: 10px; margin-right: 10px;margin-top: 6px;">
                                            <fieldset>
                                                <div class="form-row" id="entry">

                                                    <!-- Tasks -->
                                                    <div class='col-md-12'>
                                                        <div class='form-group'>
                                                            <div class='form-group'>
                                                                <div id='tasks'></div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <!-- Annotation -->
                                                    <div class='col-md-10 mode-simple'>
                                                        <div class='form-group'>
                                                            <label class='control-label' for='Surcharge' style="margin-top: 10px;">
                                                                Comentario:
                                                            </label>
                                                            <div class='form-group'>
                                                                <textarea id='Annotation' name='Annotation' class='form-control' size='350' maxlength='350' rows="2"></textarea>
                                                            </div>
                                                            <div class='form-group tnotify d-none'>
                                                                <div class="custom-control custom-checkbox">
                                                                    <input type="checkbox" class="custom-control-input" id="CustomNotify" checked>
                                                                    <label class="custom-control-label control-label" for="CustomNotify" style="padding-top: 4px;">Enviar notificación al asegurado por correo electrónico</label>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class='col-md-2 mode-simple'>
                                                        <button id="ProcessStepAccept" type="button" class="btn btn-primary mx-auto d-block" data-doing="Procesando..." disabled>Procesar</button>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Seguimiento -->
                        <div role="tabpanel" id="Seguimiento" class="tab-pane ">
                            <div class="panel-body">
                                <div class='row'>
                                    <div id="Stages" class='col-md-12'>
                                        <div class="table-responsive" style="padding: 0px 2px 0px 2px;">
                                            <table id="ProcessGridTbl" style="font-size: 12px" class="table table-bordered table-hover table-index"></table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Notas -->
                        <div role="tabpanel" id="Notas" class="tab-pane">
                            <div class="panel-body">
                                @Html.Partial("../Common/_notes")
                            </div>
                        </div>

                        <!-- Adjuntos -->
                        <div role="tabpanel" id="Adjuntos" class="tab-pane">
                            <div class="panel-body">
                                <!-- Attachments Grid -->
                                @Html.Partial("../Common/_attachments_grid_v2")
                            </div>
                        </div>

                        <!-- Enlaces -->
                        <div role="tabpanel" id="Enlaces" class="tab-pane">
                            <div class="panel-body">
                                <div class='form-row'>
                                    <div class='col-md-12'>
                                        <ul class="tag-list" style="padding: 0; margin-top: -25px">
                                            <li><a href=""><i class="fa fa-link"></i> Family</a></li>
                                            <li><a href=""><i class="fa fa-link"></i> Work</a></li>
                                            <li><a href=""><i class="fa fa-link"></i> Home</a></li>
                                            <li><a href=""><i class="fa fa-external-link"></i> Photography</a></li>
                                            <li><a href=""><i class="fa fa-external-link"></i> Film</a></li>
                                        </ul>
                                        <div class="clearfix"></div>

                                        <ul class="nav nav-tabs" style="margin-top: 6px">
                                            <li>
                                                <a class="nav-link active show" data-toggle="tab" href="#enlace1Tab">
                                                    <i class="fa fa-bookmark-o"></i> Enlace 1
                                                </a>
                                            </li>
                                            <li>
                                                <a class="nav-link" data-toggle="tab" href="#enlace2Tab">
                                                    <i class="fa fa-bookmark-o"></i>
                                                    Enlace 2
                                                </a>
                                            </li>
                                        </ul>
                                        <div class="tab-content" style="padding-top: 10px">
                                            <div id="enlace1Tab" class="tab-pane fade active">1</div>
                                            <div id="enlace2Tab" class="tab-pane fade">2</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Attachments Grid Modal -->
    @Html.Partial("../Common/_attachments_modal")

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jsCRUD")
    <script src="@Url.Content("~/Scripts/Common.Process.js")"></script>
    <script src="@Url.Content("~/Scripts/Common.Attachments.js")"></script>
    <script src="@Url.Content("~/assets/dropzone/js/dropzone.min.js")"></script>
    <script src="@Url.Content("~/app/js/file.uploader.js")"></script>
    <script src="@Url.Content("~/Scripts/Common.Notes.js")"></script>
    <script src="@Url.Content("~/Scripts/ManagerLinks.UI.js")"></script>
    <script src="@Url.Content("~/app/js/core.language.js")"></script>
    <script src="@Url.Content("~/Scripts/General.Case.js")"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            app.GeneralCase.Init();
        });
    </script>
}
