                                        </div>
                                        <div class="text-right">
                                            <button id="saveNote" type="button"
                                                    class="btn btn-sm btn-primary m-t-n-xs">
                                                <strong>Enviar nota</strong>
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <!-- Adjuntos -->
                        <div role="tabpanel" id="Adjuntos" class="tab-pane">
                            <div class="panel-body">
                                <div class="row">
                                    <div class='col'>
