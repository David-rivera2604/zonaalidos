    <!-- @Scripts.Render("~/bundles/jsMaster") -->
    <!-- Handler for local scripts -->
    @RenderSection("scripts", required: false)

    <script src="@Url.Content("~/Scripts/LayoutView.js")"></script>
    <script src='@Url.Content("~/Scripts/jquery.signalR-2.4.3.min.js")'></script>
    <script src='@Url.Content("~/signalr/hubs")'></script>
    <script src='@Url.Content("~/Scripts/notifications.service.js")'></script>
    <script>
        $(function() {
            function getTokenPayload() { try { var t=localStorage.getItem("Token"); if(!t) return null; return JSON.parse(atob(t.split(".")[1].replace(/-/g,"+").replace(/_/g,"/"))); } catch(e){return null;} }
            var p=getTokenPayload();
            var userId=p?parseInt(p.UserId||p.userId||0,10):0;
            var companyId=p?parseInt(p.CompanyId||p.companyId||0,10):0;
            if(userId>0){ Aliados.Notifications.init(userId,companyId); }
            $(document).on("show.bs.dropdown","#notificationDropdown",function(){Aliados.Notifications.reload();});
        });
    </script>
</body>

</html>
