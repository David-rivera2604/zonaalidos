        <hr />
        <h3>First slide</h3>
        <hr />

        <div class="clients-square">
            <div class="box-img-mant">
                <input type="text" name="name" value="" id="IM_titulo1" class="iputsMant titulosMant" />

                <textarea aria-label="With textarea" id="IM_descripcion1" class="iputsMant descripMant"></textarea>
                <hr />

                <input type="text" name="name" value="" id="IM_frase1" class="iputsMant fraseMant" />

                <hr />
                <input type="text" name="name" value="" id="IM_link1" class="iputsMant linkMant" />
            </div>
            <form class="fileMant fileMant1" action="upload.php" method="POST">
                <input type="file" id="fileimg1" class="file-img" />
                <label>Imagen Click or Drag</label>
                <p>Dimensiones recomendadas 1320 x 500</p>
            </form>
            <img src="~/app/img/undefined.svg" id="IM_img1" alt="First slide">
