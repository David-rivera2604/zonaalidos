@{
    Layout = "~/Views/_Layout.cshtml";
}
@Styles.Render("~/Content/cssCRUD")

<div class="ibox">
    <div class="ibox-title">
        <h5>Actualizar datos del cliente</h5>
    </div>
    <div class="ibox-content">
        <div class='form-row'>
            <div class='col-md-12'>
                <div id="clientesEdt" class="animated fadeInRight">
                    <form id='clientesEdtForm' class='form-horizontal' data-toggle='validator'>
                        <fieldset> 
                            <div class="row"> 
                                <div class="col-lg-12">
                                    <div class="row d-flex flex-row justify-content-center text-center">
                                        <!-- DocumentNumber Text -->
                                        <div class='col-sm-3 col-md-3'>
                                            <h4 style="font-weight: 600;">Elija y digite el número de identificación</h4>
                                            <div class='form-group mt-3'> 
                                                <label class='control-label' for='DocumentNumber'>
                                                    Identificación<span class='required-mark'
                                                                        title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                                </label> 
                                                <div class='input-group'>
                                                    <span class='input-group-addon'>
                                                        <span class='glyphicon glyphicon-barcode'></span>
                                                    </span>
                                                    <div class="input-group-prepend">
                                                        <button class="btn btn-default dropdown-toggle" type="button" data-toggle="dropdown"
                                                                aria-haspopup="true" aria-expanded="false" data-value='1' id="DocumentNumberType">
                                                            Cédula
                                                        </button>
                                                        <div class="dropdown-menu" id="DocumentNumberTypeMenu">
                                                            <a class="dropdown-item active" href="#" data-value='1'>Cédula</a>
                                                            <a class="dropdown-item" href="#" data-value='2'>DIMEX</a>
                                                            <a class="dropdown-item" href="#" data-value='3'>Pasaporte</a>
                                                            <a class="dropdown-item" href="#" data-value='4'>Cédula jurídica</a>
                                                        </div>
                                                    </div>
                                                    <input id='DocumentNumber' name='DocumentNumber' type='text' class='form-control'
                                                           size='20' maxlength='20' placeholder="0X-XXXX-XXXX">
                                                </div>
                                                <div id='DocumentNumber_validate'></div>
                                            </div>
                                        </div>
                                    </div>
                                </div> 
                            </div>
                            <div class='form-row'>
                                <!-- nombre Text -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='nombre'>
                                            Nombre<span class='required-mark'
                                                        title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                        </label>
                                        <input type='text' id='nombre' name='nombre' class='form-control' size='100'
                                               maxlength='100' />
                                    </div>
                                </div><!-- apellido1 Text -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='apellido1'>
                                            Apellido 1<span class='required-mark'
                                                            title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                        </label>
                                        <input type='text' id='apellido1' name='apellido1' class='form-control' size='50'
                                               maxlength='50' />
                                    </div>
                                </div><!-- apellido2 Text -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='apellido2'>
                                            Apellido 2<span class='required-mark'
                                                            title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                        </label>
                                        <input type='text' id='apellido2' name='apellido2' class='form-control' size='50'
                                               maxlength='50' />
                                    </div>
                                </div><!-- fechadenacimiento DatePicker -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='fechadenacimiento'>
                                            Fecha de nacimiento<span class='required-mark'
                                                                     title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                        </label>
                                        <div class='input-group date' id='fechadenacimiento_group'>
                                            <input type='text' id='fechadenacimiento' name='fechadenacimiento' class='form-control'
                                                   size='10' maxlength='10' placeholder='día/mes/año' />
                                            <span class='input-group-addon'>
                                                <span class='glyphicon glyphicon-calendar'></span>
                                            </span>
                                        </div>
                                        <div id='fechadenacimiento_validate'></div>
                                    </div>
                                </div>
                                <!-- tercerosMca_sexo DropDownList -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='tercerosMca_sexo'>
                                            Sexo<span class='required-mark'
                                                      title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                        </label>
                                        <select id='tercerosMca_sexo' name='tercerosMca_sexo' class='form-control'>
                                            <option value="0">Femenino</option>
                                            <option value="1">Masculino</option>
                                        </select>
                                    </div>
                                </div>
                                <!-- estadoCivil DropDownList -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='estadoCivil'>
                                            Estado Civil<span class='required-mark'
                                                              title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                        </label>
                                        <select id='estadoCivil' name='estadoCivil' class='form-control'>
                                            <option value="1">Casado(a)</option>
                                            <option value="2">Divorciado(a)</option>
                                            <option value="3">Soltero(a)</option>
                                            <option value="4">Viudo(a)</option>
                                            <option value="5">Otro</option>
                                            <option value="6">Acompañado(a)</option>|
                                        </select>
                                    </div>
                                </div>
                                <!-- numerodetelefono Text -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='numerodetelefono'>
                                            Número de teléfono<span class='required-mark'
                                                                    title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                        </label>
                                        <div class='input-group'>
                                            <span class='input-group-addon'>
                                                <span class='glyphicon glyphicon-earphone'></span>
                                            </span>
                                            <input id='numerodetelefono' name='numerodetelefono' type='text' class='form-control'
                                                   size='9' maxlength='9'>
                                        </div>
                                        <div id='numerodetelefono_validate'></div>
                                    </div>
                                </div><!-- correoelectronico Text -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='correoelectronico'>
                                            Correo electrónico<span class='required-mark'
                                                                    title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                        </label>
                                        <div class='input-group'>
                                            <span class='input-group-addon'>
                                                <span class='glyphicon glyphicon-envelope'></span>
                                            </span>
                                            <input id='correoelectronico' name='correoelectronico' type='text' class='form-control'
                                                   size='80' maxlength='80'>
                                        </div>
                                        <div id='correoelectronico_validate'></div>
                                    </div>
                                </div><!-- cod_pais DropDownList -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='cod_pais'>
                                            País<span class='required-mark'
                                                      title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                        </label>
                                        <select id='cod_pais' name='cod_pais' class='form-control' disabled></select>
                                    </div>
                                </div>
                                <!-- TProvincia DropDownList -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='TProvincia'>
                                            Provincia<span class='required-mark'
                                                           title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                        </label>
                                        <select id='TProvincia' name='TProvincia' class='form-control'></select>
                                    </div>
                                </div>
                                <!-- TCanton DropDownList -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='TCanton'>
                                            Cantón<span class='required-mark'
                                                        title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                        </label>
                                        <select id='TCanton' name='TCanton' class='form-control'></select>
                                    </div>
                                </div>
                                <!-- TDistrito DropDownList -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='TDistrito'>
                                            Distrito<span class='required-mark'
                                                          title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                        </label>
                                        <select id='TDistrito' name='TDistrito' class='form-control'></select>
                                    </div>
                                </div>
                                <!-- otrasenas Text -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='otrasenas'>
                                            Otra señas<span class='required-mark'
                                                            title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                        </label>
                                        <input type='text' id='otrasenas' name='otrasenas' class='form-control' size='100'
                                               maxlength='100' />
                                    </div>
                                </div>
                            </div> 
                        </fieldset>
                        <button class="btn btn-primary" id="actualizarCambios">Actualizar cambios</button>
                        <a href="~/General/Administration"><button class="btn btn-default float-right" type="button">Cancelar</button></a> 
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @Scripts.Render("~/bundles/jsCRUD")
    <script src="@Url.Content("~/Scripts/AdministrarCliente.js")"></script>
}

