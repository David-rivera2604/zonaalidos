@{
    Layout = "~/Views/_Layout.cshtml";
}
@Styles.Render("~/Content/cssCRUD")
<!-- Visualizations -->
<div class="ibox">
    <div class="ibox-title">
        <h5>Visualizaciones</h5>
        <!-- Opciones -->
        <div class="ibox-tools">
            <a class="tool-filter">
                <i class="fa fa-filter" title="Visualiza el filtro avanzado..."></i>
            </a>
            <a class="tool-new">
                <i class="fa fa-plus" title="Crear un nuevo visualizations"></i>
            </a>
            <a class="fullscreen-link">
                <i class="fa fa-expand" title="Expande la zona de trabajo"></i>
            </a>
            <a class="dropdown-toggle" data-toggle="dropdown" href="#" title="Opciones adicionales...">
                <i class="fa fa-wrench"></i>
            </a>
            <ul class="dropdown-menu dropdown-user">
                <li>
                    <a href="#" class="dropdown-item tool-new"><i class="fa fa-plus"></i> Crear un nuevo visualizations</a>
                </li>
                <li>
                    <a href="#" class="dropdown-item tool-filter"><i class="fa fa-filter"></i> Despliega el filtro avanzado...</a>
                </li>
                <li>
                    <a href="#" class="dropdown-item tool-refresh"><i class="fa fa-refresh"></i> Recargar los table0s</a>
                </li>
                <li>
                    <a href="#" class="dropdown-item tool-filter"><i class="fa fa-file-excel-o"></i> Exportar a Excel...</a>
                </li>
                <li>
                    <a href="#" class="dropdown-item tool-audit" data-toggle="modal" data-target="#myModal5"><i class="fa fa-clock-o"></i> Historial...</a>
                </li>
            </ul>
        </div>
    </div>
    <div class="ibox-content">
        <div class="sk-spinner sk-spinner-wave">
            <div class="sk-rect1"></div>
            <div class="sk-rect2"></div>
            <div class="sk-rect3"></div>
            <div class="sk-rect4"></div>
            <div class="sk-rect5"></div>
        </div>
        <div id="generalNotify">
        </div>
        <!-- Filtro -->
        <div class='form-row filter-row'>
            <div class='form-group col-md-12'>
                <div class="input-group placeholder-small">
                    <input id="VisualizationsSearch" type="text" placeholder="Permite filtrar por nombre del rol o descripción" title="Permite filtrar por nombre del rol o descripción" class="form-control form-control-sm" maxlength="40">
                    <span class="input-group-append">
                        <button type="button" class="btn btn btn-primary btn-xs" id="ApplyFilter"> <i class="fa fa-search"></i> Filtrar</button>
                    </span>
                </div>
            </div>
        </div>
        <!-- Filtro avanzado -->
        <div class='form-row d-none advancefilter-row animated fadeInDown'>
            <div class="form-group col-md-6">
                <label class="control-label" for="RecordStatusFlt">Estado</label>
                <select id="RecordStatusFlt" name="RecordStatusFlt" title="" multiple class="form-control form-control-sm">
                </select>
            </div>
        </div>
        <!-- Grid -->
        <div class='form-row'>
            <div class='col-md-12'>
                <div class="table-responsive animated bounceInRight">
                    <table id="VisualizationsGridTbl" style="font-size: 11px;"></table>
                </div>
            </div>
        </div>
        <!-- Edit Form -->
        <div class='form-row'>
            <div class='col-md-12'>
                <div id="VisualizationsEdt" class="animated fadeInRight d-none">
                    <form id='VisualizationsEdtForm' class='form-horizontal' data-toggle='validator'>
                        <fieldset>
                            <div class="form-row">
                                <!-- Id -->
                                <input id='Id' name='Id' type='hidden' value=''>
                                <!-- EntityType -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='EntityType'>Tipo de entidad</label>
                                        <select id='EntityType' name='EntityType' class='form-control'></select>
                                    </div>
                                </div>
                                <!-- Sequence -->
                                <input id='Sequence' name='Sequence' type='hidden' value=''>
                                <!-- Type -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='Type'>Type</label>
                                        <select id='Type' name='Type' class='form-control'></select>
                                    </div>
                                </div>
                                <!-- Caption -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='Caption'>Caption</label>
                                        <input id='Caption' name='Caption' type='text' class='form-control' size='120' maxlength='120'>
                                    </div>
                                </div>
                                <!-- Description -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='Description'>Description</label>
                                        <input id='Description' name='Description' type='text' class='form-control' size='120' maxlength='120'>
                                    </div>
                                </div>
                                <!-- StatementType -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='StatementType'>Tipo de comando</label>
                                        <select id='StatementType' name='StatementType' class='form-control'></select>
                                    </div>
                                </div>
                                <!-- Statement -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='Statement'>Statement</label>
                                        <input id='Statement' name='Statement' type='text' class='form-control' size='512' maxlength='512'>
                                    </div>
                                </div>
                                <!-- Specification -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='Specification'>Especificación</label>
                                        <input id='Specification' name='Specification' type='text' class='form-control' size='2048' maxlength='2048'>
                                    </div>
                                </div>
                                <!-- Icon -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='Icon'>Icon</label>
                                        <input id='Icon' name='Icon' type='text' class='form-control' size='80' maxlength='80'>
                                    </div>
                                </div>
                                <!-- IconClass -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='IconClass'>Icon Class</label>
                                        <input id='IconClass' name='IconClass' type='text' class='form-control' size='80' maxlength='80'>
                                    </div>
                                </div>
                                <!-- ValueFormat -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='ValueFormat'>Value Format</label>
                                        <input id='ValueFormat' name='ValueFormat' type='text' class='form-control' size='80' maxlength='80'>
                                    </div>
                                </div>
                                <!-- ConnectionName -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='ConnectionName'>Conexión</label>
                                        <input id='ConnectionName' name='ConnectionName' type='text' class='form-control' size='80' maxlength='80'>
                                    </div>
                                </div>
                                <!-- RecordStatus -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='RecordStatus'>Estado del Registro<span class='required-mark'>*</span></label>
                                        <select id='RecordStatus' name='RecordStatus' class='form-control'></select>
                                    </div>
                                </div>

                            </div>
                            <div class="form-row">
                                <div class='col-md-12'>
									<button id="VisualizationsEdtFormSave" type="button" class="btn btn-primary btn-sm" data-doing="Guardando cambios..." title="Guardar cambios">Guardar</button>
									<button id="VisualizationsEdtFormSaveContinue" type="button" class="btn btn-primary btn-sm d-none" data-doing="Guardando cambios..." title="Guardar cambios y continuar">Guardar y continuar</button>
									<button id="VisualizationsEdtFormSaveCopy" type="button" class="btn btn-primary btn-sm d-none" data-doing="Guardando cambios..." title="Guardar cambios y continuar">Guardar y copiar</button>
									<button id="VisualizationsEdtFormDuplicate" type="button" class="btn btn-info btn-sm d-none" data-doing="Duplicando..." title="Duplica la información actual">Duplicar</button>
									<button id="VisualizationsEdtFormDelete" type="button" class="btn btn-danger btn-sm d-none" data-doing="Eliminando..." title="Elimina la información actual">Eliminar</button>
									<button id="VisualizationsEdtFormCancel" type="button" class="btn btn-white btn-sm">Cancelar</button>
                                </div>
                            </div>
                        </fieldset>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jsCRUD")
    <script src="@Url.Content("~/Scripts/General.Visualizations.js")"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            app.GeneralVisualizations.Init();
        });
    </script>
}
