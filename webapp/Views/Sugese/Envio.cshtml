<!-- Archivo Envio.cshtml - Migrado desde Envio.aspx -->
@{
    Layout = "~/Views/_Layout.cshtml";
}

@Styles.Render("~/Content/cssCRUD")
<div class="ibox">
    <div class="ibox-title">
        <h5>Enviar archivo XML a la SUGESE</h5>
        <div class="ibox-tools">
            <a class="fullscreen-link"><i class="fa fa-expand"></i></a>
        </div>
    </div>
    <div class="ibox-content">
        <div id="generalNotify"></div>

        <div class='col-md-12 Title'>
            <span>Permite gestionar el envío a la SUGESE del archivo XML generado.</span>
            <!-- Single button -->
            <div class="btn-group pull-right">
                <button type="button" class="btn btn-link dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    Descargar <span class="caret"></span>
                </button>
                <ul class="dropdown-menu">
                    <li><a id="NewFile" href="#">Una plantilla nueva</a></li>
                    <li role="separator" class="divider"></li>
                    <li><a id="LastExcel" href="#">El último archivo Excel procesado</a></li>
                    <li><a id="LastXml" href="#">El último archivo XML generado</a></li>
                </ul>
            </div>
        </div>
        <form id='MainForm' class='form-horizontal' data-toggle='validator' style="padding-top: 18px">
            <fieldset>
                <div class='row'>
                    <div id='' class='col-md-12'>
                        <div class='row'>
                            <div class='col-sm-12 col-md-3'>
                                <label class='control-label' for="modelo">Modelo <span class='required-mark'>*</span></label>
                                <select id="modelo" class="form-control" title="Indique el modelo a procesar">
                                    <option value="ModeloAporteBomberos">Aporte bomberos</option>
                                    <option value="ModeloBalanceGeneral">Balance general</option>
                                    <option value="ModeloEstadoCambiosPatrimonioPropio">Cambios de patrimonio</option>
                                    <option value="ModeloCanales">Canales de comercialización</option>
                                    @* <option value="ModeloCuentaTecnica">Cuentas técnicas</option> *@
                                    <option value="ModeloInversionesFinancieras">Detalle de inversión</option>
                                    <option value="ModeloEstadoResultados">Estado de resultados</option>
                                    <option value="ModeloFATCA">FATCA</option>
                                    <option value="ModeloPolizas">Registro único de beneficiarios</option>
                                    <option value="ModeloProduccion">Producción y población asegurada</option>
                                    <option value="ModeloRunOff">Run off</option>
                                    @* <option value="ModeloSaldosContables">Saldos contables</option> *@
                                    <option value="ModeloParitarios">Seguros paritarios</option>
                                    <option value="ModeloAportesINEC">Aportes INEC</option>
                                    <option value="ModeloPrimasSiniestros">Primas y siniestros</option>

                                    <option value="NIFF17ModeloSaldosContables">NIFF17 - Saldos contables</option>
                                    @* <option value="NIFF17ModeloEstadisticasInternacionales">NIFF17 - Estadísticas internacionales</option> *@

                                    <option value="NIFF17CuentaTecnicaFinanciera">NIFF17 - Cuentas técnicas financiera</option>
                                    @* <option value="NIFF17PrimasSiniestros">NIFF17 - Primas y siniestros</option> *@
                                    <option value="NIFF17RendimientoFinanciero">NIFF17 - Rendimiento financiero</option>
                                    <option value="NIFF17SituacionFinanciera">NIFF17 - Situación financiera</option>
                                </select>
                            </div>
                            <div class='col-sm-6 col-md-2'>
                                <label class='control-label' for="pediodo_mensual">Mes <span class='required-mark'>*</span></label>
                                <select id="pediodo_mensual" class="form-control" title="Indique el mes para el periodo">
                                    <option value="1" selected="selected">Enero</option>
                                    <option value="2">Febrero</option>
                                    <option value="3">Marzo</option>
                                    <option value="4">Abril</option>
                                    <option value="5">Mayo</option>
                                    <option value="6">Junio</option>
                                    <option value="7">Julio</option>
                                    <option value="8">Agosto</option>
                                    <option value="9">Septiembre</option>
                                    <option value="10">Octubre</option>
                                    <option value="11">Noviembre</option>
                                    <option value="12">Diciembre</option>
                                    <option value="1">Enero-Marzo</option>
                                    <option value="2">Abril-Junio</option>
                                    <option value="3">Julio-Setiembre</option>
                                    <option value="4">Octubre-Diciembre</option>
                                </select>
                            </div>
                            <div class='col-sm-6 col-md-1'>
                                <label class='control-label' for="ano">Año <span class='required-mark'>*</span></label>
                                <input id="ano" type="number" class="form-control" min="2018" max="2030" value="2019" title="Indique el año del periodo">
                            </div>
                            <div class='col-sm-12 col-md-6'>
                                <label class='control-label' for="fileNameUpload">Archivo XML <span class='required-mark'>*</span></label>
                                <div class="input-group">
                                    <input id="fileNameUpload" type="text" class="form-control" placeholder="Indique el archivo XML a procesar..." />
                                    <input id="fileServerNameUpload" type="hidden" value="" />
                                    <span class="input-group-btn">
                                        <span class="btn btn-default fileinput-button" title="Permite seleccionar el archivo a ser procesado">
                                            <span>Examinar...</span>
                                            <input id="fileUpload" type="file" accept="xml" />
                                        </span>
                                        <span id="procesarArchivo" class="btn btn-primary" title="Procesa el archivo según los datos suministrados">
                                            Procesar
                                        </span>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class='row'>
                            <div class='col-md-12' style="margin-top: 14px">
                                <div id="alertSuccess" class="alert alert-success" role="alert" hidden="hidden">
                                    <p class="text-center">
                                        El archivo XML fue procesado de forma <strong>exitosa</strong>, si desea descargar el xml generado por favor haga click sobre el siguiente enlace <a id="xml" href="#" class="alert-link">Bomberos.xml</a>.
                                    </p>
                                </div>
                                <div id="alertError" class="alert alert-danger" role="alert" hidden="hidden">
                                    <p class="text-center">
                                        El archivo XML fue procesado pero existen varias <strong>fallas</strong> de validación, el detalle de las fallas encontradas fueron agregadas como una hoja al archivo Excel procesado, si desea descargar el Excel con el detalle de las fallas por favor haga click sobre el siguiente enlace <a id="excel" href="#" class="alert-link">Bomberos.xlsx</a>, el archivo xml usado en las validaciones es <a id="xml2" href="#" class="alert-link">Bomberos.xml</a>.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </fieldset>
        </form>
    </div>
</div>

<div class='container-fluid' style="margin-top: 60px; margin-bottom: 20px; margin-right: 10px">

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jsCRUD")
    <script src="~/Scripts/Common.Attachments.js"></script>
    <script src="~/Scripts/Sugese.Send.js"></script>
}
