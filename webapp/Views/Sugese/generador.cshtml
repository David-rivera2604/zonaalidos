<!-- Archivo corregido generador.cshtml alineado con Generador.js -->
@{
    Layout = "~/Views/_Layout.cshtml";
}

@Styles.Render("~/Content/cssCRUD")

<div class="ibox">
    <div class="ibox-title">
        <h5>Generador de archivos SUGESE</h5>
        <div class="ibox-tools">
            <a class="fullscreen-link"><i class="fa fa-expand"></i></a>
        </div>
    </div>

    <div class="ibox-content">
        <div id="generalNotify"></div>

        <!-- 🔥 IMPORTANTE: El JS requiere un formulario con id="MainForm" -->
        <form id="MainForm" class="form-horizontal" enctype="multipart/form-data">
            <fieldset>
                <div class="form-row">

                    <!-- Modelo (JS usa #modelo) -->
                    <div class="col-sm-6 col-md-4">
                        <div class="form-group">
                            <label for="modelo" class="control-label">Tipo de modelo *</label>
                            <select id="modelo" name="modelo" class="form-control" required>
                                <option value="">Seleccione…</option>
                                <!-- Modelos generales -->
                                <option value="Bomberos">Aporte bomberos</option>
                                <option value="BalanceGeneral">Balance general</option>
                                <option value="Patrimonio">Cambios de patrimonio</option>
                                <option value="Canales">Canales de comercialización</option>
                                <option value="Inversiones">Detalle de inversión</option>
                                <option value="Resultados">Estado de resultados</option>
                                <option value="RUB">Registro único de beneficiarios</option>
                                <option value="Produccion">Producción y población asegurada</option>
                                <option value="RunOff">Run off</option>
                                <option value="AportesINEC">Aportes INEC</option>
                                <option value="PrimasSiniestros">Primas y siniestros</option>

                                <!-- Opciones adicionales provenientes del primer select -->
                                <option value="CuentasTecnicas">Cuentas técnicas</option>
                                <option value="SaldosContables">Saldos contables</option>

                                <!-- NIIF 17 / NIFF 17 -->
                                <option value="NIFF17SaldosContables">NIIF17 - Saldos contables</option>
                                <option value="NIFF17CuentaTecnicaFinanciera">NIIF17 - Cuentas técnicas financiera</option>
                                <option value="NIFF17RendimientoFinanciero">NIIF17 - Rendimiento financiero</option>
                                <option value="NIFF17SituacionFinanciera">NIIF17 - Situación financiera</option>

                            </select>
                            <div id="modelo_validate"></div>
                        </div>
                    </div>

                    <!-- Mes (JS usa #pediodo_mensual) -->
                    <div class="col-sm-6 col-md-2" id="div_periodo_mensual">
                        <div class="form-group">
                            <label for="pediodo_mensual">Mes *</label>
                            <select id="pediodo_mensual" name="pediodo_mensual" class="form-control">
                                <option value="1">Enero</option>
                                <option value="2">Febrero</option>
                                <option value="3">Marzo</option>
                                <option value="4">Abril</option>
                                <option value="5">Mayo</option>
                                <option value="6">Junio</option>
                                <option value="7">Julio</option>
                                <option value="8">Agosto</option>
                                <option value="9">Septiembre</option>
                                <option value="10">Octubre</option>
                                <option value="11">Noviembre</option>
                                <option value="12">Diciembre</option>
                            </select>
                            <div id="pediodo_mensual_validate"></div>
                        </div>
                    </div>

                    <!-- Trimestre (JS usa #pediodo_trimestral) -->
                    <div class="col-sm-6 col-md-2" id="div_pediodo_trimestral">
                        <div class="form-group">
                            <label for="pediodo_trimestral">Trimestre *</label>
                            <select id="pediodo_trimestral" name="pediodo_trimestral" class="form-control hidden">
                                <option value="1">Trimestre 1</option>
                                <option value="2">Trimestre 2</option>
                                <option value="3">Trimestre 3</option>
                                <option value="4">Trimestre 4</option>
                            </select>
                            <div id="pediodo_trimestral_validate"></div>
                        </div>
                    </div>

                    <!-- Año (JS usa #ano) -->
                    <div class="col-sm-6 col-md-2">
                        <div class="form-group">
                            <label for="ano">Año *</label>
                            <input id="ano" name="ano" type="number" class="form-control" />
                            <div id="ano_validate"></div>
                        </div>
                    </div>

                    <!-- Archivo (JS usa #fileUpload, #fileNameUpload, #fileServerNameUpload) -->
                    <div class="col-sm-12 col-md-4">
                        <div class="form-group">
                            <label for="fileUpload">Archivo Excel *</label>
                            <div class="input-group">
                                <input id="fileNameUpload" name="fileNameUpload" type="text" class="form-control" readonly />
                                <input id="fileServerNameUpload" name="fileServerNameUpload" type="hidden" />

                                <div class="input-group-append">
                                    <span class="btn btn-default fileinput-button">
                                        <span>Examinar…</span>
                                        <input id="fileUpload" type="file" accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,
                                                                                   application/vnd.ms-excel,
                                                                                   text/csv" />
                                    </span>
                                </div>
                            </div>
                            <div id="fileNameUpload_validate"></div>
                        </div>
                    </div>
                </div>
            </fieldset>
        </form>

        <!-- Botón procesar (JS usa #procesarArchivo) -->
        <div class="col-md-12 mt-3">
            <button id="procesarArchivo" class="btn btn-primary float-right">Procesar Archivo</button>
        </div>

        <!-- Alertas que usa el JS -->
        <div id="alertSuccess" class="alert alert-success mt-3" style="display:none;">Archivo procesado correctamente.</div>
        <div id="alertError" class="alert alert-danger mt-3" style="display:none;">Error procesando el archivo.</div>

        <!-- Links dinámicos que el JS modifica -->
        <div class="mt-3">
            <a id="NewFile">Nuevo XLSX</a> ·
            <a id="LastExcel">Último XLSX</a> ·
            <a id="LastXml">Último XML</a> ·
            <a id="xml">XML</a> ·
            <a id="xml2">XML (2)</a> ·
            <a id="excel">Excel generado</a>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jsCRUD")
    <script src="~/Scripts/Common.Attachments.js"></script>
    <script src="~/Scripts/Sugese.js"></script>
}
