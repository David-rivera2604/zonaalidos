@section Scripts {
    @Scripts.Render("~/bundles/jsCRUD")

    <script src="@Url.Content("~/assets/formiojs/formio.embed.min.js")"></script>

    <script type="text/javascript">
        let _id = app.core.URLStringValue('id');

        app.core.Get(app.setting.apipath + `v1/CustomData/${_id}/Render/Data`)
            .done(function (data) {
                //console.log(data);
                const spec = JSON.parse(data);

                spec.noAlerts = true;

                $('#formTitle').html(spec.smart.caption);

                Formio.createForm(document.getElementById('formio'), spec,
                    {
                        noAlerts: true,
                        submitMessage: "", // Truco extra: vaciar el mensaje por defecto
                        disableAlerts: true // Algunas versiones antiguas usan esta propiedad
                    }
                ).then(function (form) {

                    app.core.GetView(app.setting.apipath + `v1/Clipboard/Retrieve`)
                        .done(function (data) {
                            const clipboard = data;
                            // Default the submission.
                            form.submission = {
                                data: {
                                    textArea: clipboard
                                }
                            };
                        });

                    // Everytime the form changes, this will fire.
                    form.on('change', function (changed) {
                        console.log('Form was changed', changed);
                    });
                    form.on('customEvent', function (event) {
                        if (event.type === 'saveToClipboard') {
                            // 1. Aquí validas
                            // 2. Aquí envías los datos a tu API manualmente
                            // 3. Aquí muestras TU propio mensaje (SweetAlert, Toast, etc.)
                            console.log("Botón presionado, enviando datos...", event.data);

                            Formio.fetch(app.setting.apipath + `v1/Clipboard/Share`, {
                                body: event.data.textArea,
                                headers: {
                                    'content-type': 'text/html; charset=utf-8'
                                },
                                method: 'POST',
                                mode: 'cors',
                            })
                                .then(function (response) {
                                    response.json()
                                })
                        }
                    });

                    form.on('submit', function (submission) {

                        console.log('Submission was made!', submission);
                        return Formio.fetch(app.setting.apipath + `v1/Clipboard/Share`, {
                            body: submission.data.textArea,
                            headers: {
                                'content-type': 'text/html; charset=utf-8'
                            },
                            method: 'POST',
                            mode: 'cors',
                        })
                            .then(function (response) {
                                form.emit('submitDone', submission)
                                response.json()
                            })
                    });
                });
            });






    </script>
}
