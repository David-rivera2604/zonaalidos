@section Scripts {
    @Scripts.Render("~/bundles/jsCRUD")
    <script src="@Url.Content("~/assets/sparkline/jquery.sparkline.min.js")"></script>
    <script type="text/javascript">
        let pagasColones = [];
        let pagasDolares = [];
        let pagasColonesName = [];
        let pagasDolaresName = [];
        $(document).ready(function () {
            var sparkResize;
            var sparklineCharts = function () {

                $("#sparkline2").sparkline(pagasColones, {
                    type: 'line',
                    width: '100%',
                    height: '50',
                    lineColor: 'rgb(0,143,251)',
                    fillColor: "transparent",
                    spotColor: '#676a6c',
                    minSpotColor: '#676a6c',
                    maxSpotColor: '#676a6c',
                    tooltipFormat: '<span style="color: {{color}}">&#9679;</span>{{offset:names}}: ₡ {{prefix}}{{y}}{{suffix}}</span>',
                    tooltipValueLookups: {
                        names: pagasColonesName
                    }
                    // tooltipValueLookups: {
                    //    levels: $.range_map({ '17227770.33': 'pep', '60971345.93': '2021-09-30', '3:6': 'Medium', '7:': 'High' })
                    // }
                    //   tooltipSuffix: 'Cycles',
                    //   tooltipFormat: '{{offset:offset}} : {{y:val}}'
                });
                $("#sparkline2").sparkline(pagasDolares, {
                    type: 'line',
                    width: '100%',
                    height: '50',
                    lineColor: "rgb(0,227,150)",
                    fillColor: "transparent",
                    spotColor: '#676a6c',
                    minSpotColor: '#676a6c',
                    maxSpotColor: '#676a6c',
                    tooltipFormat: '<span style="color: {{color}}">&#9679;</span>{{offset:names}}: $ {{prefix}}{{y}}{{suffix}}</span>',
                    tooltipValueLookups: {
                        names: pagasDolaresName
                    },
                    composite: true
                });

            };
            $(window).resize(function (e) {
                clearTimeout(sparkResize);
                sparkResize = setTimeout(sparklineCharts, 500);
            });

            try {

                app.core.Get(app.setting.apipath + 'v1/datasource/json?id=7000&sequence=1&url=')
                    .done(function (data) {
                        console.log(1, data);
                        $('#CotizacionesVigentes').text(data[0]["COTIZACIONES"]);
                    });
                app.core.Get(app.setting.apipath + 'v1/datasource/json?id=7000&sequence=2&url=')
                    .done(function (data) {
                        $('#PolizasActivas').text(data[0]["POLIZAS"]);
                    });
                app.core.Get(app.setting.apipath + 'v1/datasource/json?id=7000&sequence=3&url=')
                    .done(function (data) {
                        $('#SiniestrosActivos').text(data[0]["SINIESTROS"]);
                    });
                app.core.Get(app.setting.apipath + 'v1/datasource/json?id=7000&sequence=4&url=')
                    .done(function (data) {
                        $('#RecibosPendientes').text(data[0]["RECIBOS"]);
                    });
                app.core.Get(app.setting.apipath + 'v1/datasource/json?id=7000&sequence=10&url=NumRows=5')
                    .done(function (data) {
                        data.forEach(function (row, index, array) {
                            $('#UltimasCotizaciones').append(`<div class="info_table_top"><strong>${row.NUM_PRESUPUESTO}</strong><small class="">${moment(row.FEC_ACTU).from()}</small></div> <div class="info_table_body"> <h3 class="title_table_body fw-bold">Detalles: </h3> <p>${row.DETALLE}</p> </div> <div class="info_table_footer"> <strong> ${row.FRACCIONAMIENTODEPAGO}</strong><small class="">${moment(row.FEC_ACTU).format('hh:mma - DD/MM/YYYY')}</small></div> <br> </div>`);
                        });
                    });
                app.core.Get(app.setting.apipath + 'v1/datasource/json?id=7000&sequence=11&url=NumRows=5')
                    .done(function (data) {
                        let phone = '';
                        let email = '';
                        data.forEach(function (row, index, array) {
                            phone = '';
                            email = '';
                            if (row.TLF_NUMERO != null && row.TLF_NUMERO != '') {
                                phone = `<a href="tel:${row.TLF_NUMERO}" title="Telefóno ${row.TLF_NUMERO}"><i class="fa fa-phone"></i></a> `;
                            }
                            if (row.EMAIL != null && row.EMAIL != '') {
                                email = `<a href="mailto:${row.EMAIL}" title="Correo electrónico ${row.EMAIL}"><i class="fa fa-envelope"></i></a> `;
                            }
                            $('#UltimasPolizas').append(`<div class="info_table_top2"> <strong><a href="../Viewer/tabrender?id=302&P_NUM_POLIZA=${row.NUM_POLIZA}" onclick="TabRender(this);" style="color: inherit;">${row.NUM_POLIZA}</a></strong><small>${moment(row.FEC_ACTU).from()}</small> </div> <div class="info_table_body2"><p>${phone}${email}${row.NOM_COMPLETO}</p><h3 class="title_table_body fw-bold">Descripcion: </h3><p>${row.DETALLE}</p> <div class="info_table_footer2"><small class="small_dates">Efectuada - Vence</small> <strong> ${row.FRACCIONAMIENTODEPAGO}</strong><div><small>${moment(row.FEC_EFEC_POLIZA).format('DD/MM/YYYY')} - ${moment(row.FEC_VCTO_POLIZA).format('DD/MM/YYYY')}.</small></div> </div> <br> </div>`);
                        });
                    });
                app.core.Get(app.setting.apipath + 'v1/datasource/json?id=310&sequence=3&url=')
                    .done(function (data) {
                        pagasColones = data.filter(word => word.COD_MON == 1).slice(0, 6).reverse().map(function (x) { return x.IMP_PAGADO });
                        pagasColonesName = data.filter(word => word.COD_MON == 1).slice(0, 6).reverse().map(function (x) { return moment(x.FEC_PROCESO).format('DD/MM/YYYY') });
                        pagasDolares = data.filter(word => word.COD_MON == 2).slice(0, 6).reverse().map(function (x) { return x.IMP_PAGADO });
                        pagasDolaresName = data.filter(word => word.COD_MON == 2).slice(0, 6).reverse().map(function (x) { return moment(x.FEC_PROCESO).format('DD/MM/YYYY') });

                        sparklineCharts();
                    });
                app.core.Get(app.setting.apipath + 'v1/datasource/json?id=310&sequence=4&url=')
                    .done(function (data) {
                        data.forEach(function (row, index, array) {
                            switch (row.COD_MON) {
                                case 1:
                                    $('#ComisionesPorPagarColones').html('₡ ' + row.IMP_MVTO.toLocaleString('ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                                    break;
                                case 2:
                                    $('#ComisionesPorPagarDolares').html('$ ' + row.IMP_MVTO.toLocaleString('ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                                    break;
                            }
                        });
                    });

            } catch (e) {
                console.log(e);
            }
        });
        function TabRender(me) {
            event.preventDefault();

            window.open(me.href, "vdetail", "toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,resizable=yes, top=100, height=450, left=400, width=900");
        }
    </script>


    <script>
        $(document).ready(function () {
            //ALL THE FUNCTION THAT THE BUTTON WILL DO
            $("#boton").click(function () {
                $("#noticias").show(1000); // or fadeOut()
                $("#boton").attr('disable', true)
                $("#equis").attr('disable', false)
            });

            //ALL THE FUNCTION THAT THE BUTTON X WILL DO
            $("#equis").click(function () {
                $("#noticias").hide(1000);

            });

            /*
            $(document).on("click", ".cerrarNoticias", function () {
                $("#noticias").hide(1000);
                $(".cerrarNoticias").attr("class", "")
            })

            $("#boton").click(function () {
                $("#noticias").fadeIn();
                setTimeout(function () {
                    $("body").addClass("cerrarNoticias");
                }, 10);
            })
*/
        });
    </script>

}
