                                            <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                            <div class="form-row">
                                                <!-- FEC_NACIMIENTO DatePicker -->
                                                <!--<div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='FEC_NACIMIENTO'>Fecha de nacimiento<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <div class='input-group date' id='FEC_NACIMIENTO_group'>
                                                            <input type='text' id='FEC_NACIMIENTO' name='FEC_NACIMIENTO' class='form-control' size='10' maxlength='10' placeholder='día/mes/año' />
                                                            <span class='input-group-addon'>
                                                                <span class='glyphicon glyphicon-calendar'></span>
                                                            </span>
                                                        </div>
                                                        <div id='FEC_NACIMIENTO_validate'></div>
                                                    </div>
                                                </div>-->
                                                <!-- MCA_SEXO RadioButtonList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='MCA_SEXO'>Sexo<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <input type='text' id='MCA_SEXO' name='MCA_SEXO' class='form-control' size='20' maxlength='20' />
                                                    </div>
                                                </div>
                                                <!-- Cedencial Estudiantil Text -->
                                                <!--<div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='TXT_CRED_ESTUD'>Credencial Estudiantil<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <input type='text' id='TXT_CRED_ESTUD' name='TXT_CRED_ESTUD' class='form-control' size='20' maxlength='20' />
                                                    </div>
                                                </div>
                                                -->
                                                <!--Actividad Asoc. a Ocupación-->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='COD_OCUPACION' id='COD_OCUPACION_Label'>Actividad Asoc. a Ocupación<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <select id='COD_OCUPACION' name='COD_OCUPACION' class='form-control'>
                                                        </select>
                                                    </div>
                                                </div>
                                                <!--Plan-->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='COD_PLAN_AP'>Plan<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <input type='text' id='COD_PLAN_AP' name='COD_PLAN_AP' class='form-control' size='20' maxlength='20' />
                                                    </div>
                                                </div>
                                                <!--Días de Deducible Renta Diaria-->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='COD_DEDUCIBLE' id='COD_DEDUCIBLE_Label'>Días de Deducible Renta Diaria<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <select id='COD_DEDUCIBLE' name='COD_DEDUCIBLE' class='form-control'>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- terceros Grid -->
                                    <div class="form-row">
                                        <div class="col-lg-12">
                                            <div class="form-row">
                                                <div class='col'>
                                                    <h4><i class="fa fa-user-o"></i> <span id="TercerosSectionTitle">Terceros</span><label id="tercerosTbl-error" class="float-right d-none" style="color: #cc5965;display: inline-block;font-size: 11px;font-weight: normal;"></label></h4>
                                                </div>
                                                <div class='col-auto'>
                                                    <button type="button" class="btn btn-sm btn-white" title="Al hacer click permite agregar un nuevo tercero" data-toggle="modal" id="tercerosNew"> <i class="fa fa-plus"></i> </button>
                                                </div>
                                            </div>
                                            <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                            <div class="form-row">
                                                <div class='col-md-12' style="padding-bottom: 20px">
                                                    <div class="table-responsive">
                                                        <table id="tercerosTbl" style="font-size: 11px;">
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- documentosrequeridos Grid -->
                                    <div class="form-row documentosrequeridosGrid">
                                        <div class="col-lg-12">
                                            <div class="form-row">
                                                <div class='col'>
                                                    <h4><i class="fa fa-file-o"></i> <span id="DocumentosRequeridosSectionTitle">Documentos requeridos</span><label id="documentosrequeridosTbl-error" class="float-right d-none LabelValidate"></label></h4>
                                                </div>
                                                <div class='col-auto'>
                                                    <button type="button" class="btn btn-sm btn-white" title="Al hacer click permite agregar un nuevo documento pendiente" data-toggle="modal" id="documentosrequeridosNew"> <i class="fa fa-plus"></i> </button>
                                                </div>
                                            </div>
                                            <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                            <div class="form-row">
                                                <div class='col-md-12' style="padding-bottom: 20px">
                                                    <div class="table-responsive">
                                                        <table id="documentosrequeridosTbl" style="font-size: 11px;">
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- coberturas Grid -->
                                    <div class="form-row">
                                        <div class="col-lg-12">
                                            <div class="form-row">
                                                <div class='col'>
                                                    <h4><span id="CoberturasSectionTitle">Coberturas</span><label id="coberturasTbl-error" class="float-right d-none" style="color: #cc5965;display: inline-block;font-size: 11px;font-weight: normal;"></label></h4>
                                                </div>
                                            </div>
                                            <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                            <div class="form-row">
                                                <div class='col-md-12' style="padding-bottom: 20px">
                                                    <div class="table-responsive">
                                                        <table id="coberturasTbl" style="font-size: 11px;">
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- plandepago Grid -->
                                    <div class="form-row">
                                        <div class="col-lg-12">
                                            <div class="form-row">
                                                <div class='col'>
                                                    <h4><span id="PlanDePagoSectionTitle">Plan de pago</span><label id="plandepagoTbl-error" class="float-right d-none" style="color: #cc5965;display: inline-block;font-size: 11px;font-weight: normal;"></label></h4>
                                                </div>
                                            </div>
                                            <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                            <div class="form-row">
                                                <div class='col-md-12' style="padding-bottom: 20px">
                                                    <div class="table-responsive">
                                                        <table id="plandepagoTbl" style="font-size: 11px;">
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    @*@ibox-content-footer@*@
                                </fieldset>
                            </form>
                        </div>
                    </div>
                </div>
                <!-- Edit Form End -->
            </div>
        </div>
    </div>
    <div id="quoteBlock" class="col-md-3 animated bounceInRight d-none">
        <div class="ibox">
            <div class="ibox-title">
                <h5>Resumen</h5>
                <div class="ibox-tools">
                    <h5><span class="label label-success float-right" style="font-size: small;">Póliza #<span id="NumPoliza"></span></span></h5>
                </div>
            </div>
            <div class="ibox-content">
                <div class="row">
                    <div class="col-7 col-md-6">
                        <span>
                            Importe total
                        </span>
                        <h2 class="font-bold">
                            <span id="importetotal">0,00</span>
                        </h2>
                    </div>
                    <div class="col-5 col-md-6">
                        <table class="text-muted small">
                            <tr><td style="text-align:right"><span id="primaneta">0,00</span></td><td>Prima neta</td></tr>
                            <tr><td style="text-align:right"><span id="iva">0,00</span></td><td>IVA</td></tr>
                            <tr><td style="text-align:right"><span id="recardoporfraccionamiento">0,00</span></td><td>Recargo</td></tr>
                            <tr class=""><td style="text-align:right"><span id="cuotas">0</span></td><td>Cuotas</td></tr>
                        </table>
                    </div>
                </div>
                <hr>
                <div class="m-t-sm text-center">
                    <div class="btn-group">
                        <a id="print" href="#" class="btn btn-white btn-sm"><i class="fa fa-envelope-o"></i> Enviar certificado por correo</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> <!-- terceros Grid Modal -->
<div class="modal inmodal" id="tercerosModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content animated bounceInRight">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">
                    <span aria-hidden="true">&times;</span><span class="sr-only">Cerrar</span>
                </button>
                <h4 class="modal-title">Información de tercero</h4>
                <small class="font-bold">Permite agregar un nuevo terceros o editar uno ya existente</small>
            </div>
            <div class="modal-body">
                <!-- terceros Grid Edit Form -->
                <div class='form-row'>
                    <div class='col-md-12'>
                        <div id="tercerosEdt" class="animated fadeInRight">
                            <form id='tercerosEdtForm' class='form-horizontal' data-toggle='validator'>
                                <fieldset>
                                    <div class='form-row'>
                                        <!-- tipodetercero DropDownList -->
                                        <div class='col-sm-4 col-md-4'>
                                            <div class='form-group'>
                                                <label class='control-label' for='tipodetercero'>
                                                    Tipo de tercero<span class='required-mark'
                                                                         title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                                </label>
                                                <select id='tipodetercero' name='tipodetercero' class='form-control'>
                                                    <option value="0" selected>Tomador(a)</option>
                                                    <option value="2">Asegurado(a)</option>
                                                    <option value="6">Beneficiario(a)</option>

                                                </select>
                                            </div>
                                        </div>
                                        <!-- numero de riesgo Text -->
                                        <div class='col-sm-4 col-md-4'>
                                            <div class='form-group'>
                                                <label class='control-label'>
                                                    Número de Riesgo<span class='required-mark'
                                                                          title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                                </label>
                                                <input id='numeroderiesgo' name='numeroderiesgo' type='text' class='form-control'
                                                       size='9' maxlength='9'>
                                            </div>
                                        </div>
                                        <!-- DocumentNumber Text -->
                                        <div class='col-sm-4 col-md-4'>
                                            <div class='form-group'>
                                                <label class='control-label' for='DocumentNumber'>
                                                    Identificación<span class='required-mark'
                                                                        title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                                </label>
                                                <div class='input-group'>
                                                    <span class='input-group-addon'>
                                                        <span class='glyphicon glyphicon-barcode'></span>
                                                    </span>
                                                    <div class="input-group-prepend">
                                                        <button class="btn btn-default dropdown-toggle" type="button" data-toggle="dropdown"
                                                                aria-haspopup="true" aria-expanded="false" data-value='1' id="DocumentNumberType">
                                                            Cédula
                                                        </button>
                                                        <div class="dropdown-menu" id="DocumentNumberTypeMenu">
                                                            <a class="dropdown-item active" href="#" data-value='1'>Cédula</a>
                                                            <a class="dropdown-item" href="#" data-value='2'>DIMEX</a>
                                                            <a class="dropdown-item" href="#" data-value='3'>Pasaporte</a>
                                                            <a class="dropdown-item" href="#" data-value='4'>Cédula jurídica</a>
                                                        </div>
                                                    </div>
                                                    <input id='DocumentNumber' name='DocumentNumber' type='text' class='form-control'
                                                           size='20' maxlength='20' placeholder="0X-XXXX-XXXX">
                                                </div>
                                                <div id='DocumentNumber_validate'></div>
                                            </div>
                                        </div><!-- nombre Text -->
                                        <div class='col-sm-4 col-md-4'>
                                            <div class='form-group'>
                                                <label class='control-label' for='nombre'>
                                                    Nombre<span class='required-mark'
                                                                title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                                </label>
                                                <input type='text' id='nombre' name='nombre' class='form-control' size='100'
                                                       maxlength='100' />
                                            </div>
                                        </div><!-- apellido1 Text -->
                                        <div class='col-sm-4 col-md-4'>
                                            <div class='form-group'>
                                                <label class='control-label' for='apellido1'>
                                                    Apellido 1<span class='required-mark'
                                                                    title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                                </label>
                                                <input type='text' id='apellido1' name='apellido1' class='form-control' size='50'
                                                       maxlength='50' />
                                            </div>
                                        </div><!-- apellido2 Text -->
                                        <div class='col-sm-4 col-md-4'>
                                            <div class='form-group'>
                                                <label class='control-label' for='apellido2'>
                                                    Apellido 2<span class='required-mark'
                                                                    title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                                </label>
                                                <input type='text' id='apellido2' name='apellido2' class='form-control' size='50'
                                                       maxlength='50' />
                                            </div>
                                        </div><!-- fechadenacimiento DatePicker -->
                                        <div class='col-sm-4 col-md-4'>
                                            <div class='form-group'>
                                                <label class='control-label' for='fechadenacimiento'>
                                                    Fecha de nacimiento<span class='required-mark'
                                                                             title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                                </label>
                                                <div class='input-group date' id='fechadenacimiento_group'>
                                                    <input type='text' id='fechadenacimiento' name='fechadenacimiento' class='form-control'
                                                           size='10' maxlength='10' placeholder='día/mes/año' />
                                                    <span class='input-group-addon'>
                                                        <span class='glyphicon glyphicon-calendar'></span>
                                                    </span>
                                                </div>
                                                <div id='fechadenacimiento_validate'></div>
                                            </div>
                                        </div>
                                        <!-- tercerosMca_sexo DropDownList -->
                                        <div class='col-sm-4 col-md-4'>
                                            <div class='form-group'>
                                                <label class='control-label' for='tercerosMca_sexo'>
                                                    Sexo<span class='required-mark'
                                                              title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                                </label>
                                                <select id='tercerosMca_sexo' name='tercerosMca_sexo' class='form-control'>
                                                    <option value="0">Femenino</option>
                                                    <option value="1">Masculino</option>
                                                </select>
                                            </div>
                                        </div>
                                        <!-- estadoCivil DropDownList -->
                                        <div class='col-sm-4 col-md-4'>
                                            <div class='form-group'>
                                                <label class='control-label' for='estadoCivil'>
                                                    Estado Civil<span class='required-mark'
                                                                      title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                                </label>
                                                <select id='estadoCivil' name='estadoCivil' class='form-control'>
                                                    <option value="C">Casado(a)</option>
                                                    <option value="D">Divorciado(a)</option>
                                                    <option value="S">Soltero(a)</option>
                                                    <option value="CL">Unión Libre</option>
                                                    <option value="V">Viudo(a)</option>
                                                </select>
                                            </div>
                                        </div>
                                        <!-- numerodetelefono Text -->
                                        <div class='col-sm-4 col-md-4'>
                                            <div class='form-group'>
                                                <label class='control-label' for='numerodetelefono'>
                                                    Número de teléfono<span class='required-mark'
                                                                            title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                                </label>
                                                <div class='input-group'>
                                                    <span class='input-group-addon'>
                                                        <span class='glyphicon glyphicon-earphone'></span>
                                                    </span>
                                                    <input id='numerodetelefono' name='numerodetelefono' type='text' class='form-control'
                                                           size='9' maxlength='9'>
                                                </div>
                                                <div id='numerodetelefono_validate'></div>
                                            </div>
                                        </div><!-- correoelectronico Text -->
                                        <div class='col-sm-4 col-md-4'>
                                            <div class='form-group'>
