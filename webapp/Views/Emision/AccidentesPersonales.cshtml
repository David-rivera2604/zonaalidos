                                                        <input type='text' id='user_txt_motivo_spto' name='user_txt_motivo_spto' class='form-control' size='100' maxlength='100' />
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                    <!--Datos del estudiante Zone -->
