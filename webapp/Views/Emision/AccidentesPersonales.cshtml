﻿@{
    Layout = "~/Views/_Layout.cshtml";
}
@Styles.Render("~/Content/cssCRUD")
<!-- RoleMember -->
<div class="row">
    <div id="mainBlock" class="col-md-12">
        <div class="ibox">
            <div class="ibox-title">
                <h5><span id="PageTitle">AutoExpedible Accidentes Personales</span><small class="m-l-sm">Emisión<span id="PageSubTitle">   </span></small> </h5>
                <button id="emitir" type="button" class="btn  btn-primary" data-doing="Emitiendo...">
                    Emitir
                </button>
                <!-- Opciones -->
