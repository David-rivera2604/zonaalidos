<!-- documentosrequeridos Grid Modal -->
<div class="modal inmodal" id="documentosrequeridosModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content animated bounceInRight">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">
                    <span aria-hidden="true">&times;</span><span class="sr-only">Cerrar</span>
                </button>
                <h4 class="modal-title">Documentos requeridos</h4>
                <small class="font-bold">
                    Permite agregar un nuevo Documentos requeridos o editar uno ya
                    existente
                </small>
            </div>
            <div class="modal-body">
                <!-- documentosrequeridos Grid Edit Form -->
                <div class='form-row'>
                    <div class='col-md-12'>
                        <div id="documentosrequeridosEdt" class="animated fadeInRight">
                            <form id='documentosrequeridosEdtForm' class='form-horizontal'
                                  data-toggle='validator'>
                                <fieldset>
                                    <input id="Grupo" type="hidden" value="" />
                                    <div class='form-row'>
                                        <!-- tipo -->
                                        <div class='col-sm-3 col-md-3'>
                                            <div class='form-group'>
                                                <label class='control-label' for='tipo'>Tipo de documento<span class='required-mark'>*</span></label>
                                                <select id='tipo' name='tipo' class='form-control' disabled>
                                                    <option value="99">Genérico</option>
                                                </select>
                                            </div>
                                        </div>
                                        <!-- FileName -->
                                        <div class='col-sm-6 col-md-9'>
                                            <div class='form-group'>
                                                <label class='control-label' for='DNombre'>Archivo<span class='required-mark'>*</span></label>
                                                <div class="input-group">
                                                    <input id='DNombre' name='DNombre' type='text' class='form-control' size='80' maxlength='80' placeholder="Indique el archivo a procesar..." readonly>
                                                    <input id="DStored" type="hidden" value="" />
                                                    <input id="DTamano" type="hidden" value="" />
                                                    <div class="input-group-append">
                                                        <span class="btn btn-default fileinput-button" title="Permite seleccionar el archivo a ser procesado">
                                                            <span>Examinar...</span>
                                                            <input id="fileUploadModal" type="file" />
                                                        </span>
                                                    </div>
                                                </div>
                                                <div id='FileName_validate'></div>
                                            </div>
                                        </div>
                                        <!-- Description -->
                                        <div class='col-sm-3 col-md-12'>
                                            <div class='form-group'>
                                                <label class='control-label' for='DDescripcion'>Descripción<span class='required-mark'>*</span></label>
                                                <input id='DDescripcion' name='DDescripcion' type='text' class='form-control' size='120' maxlength='120'>
                                            </div>
                                        </div>
                                        <!-- Botonera -->
                                        <div class="form-row">
                                            <div class='col-md-12'>
                                                <input id="fileUpload" type="file" class="d-none" />
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="documentosrequeridosEdtFormSave"
                        data-doing="Guardando...">
                    Guardar cambios
                </button>
                <button type="button" class="btn btn-white" data-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>
