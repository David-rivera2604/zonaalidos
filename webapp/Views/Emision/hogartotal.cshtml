                                    <!-- datosgenerales Zone -->
                                    <div class="form-row">
                                        <div class="col-lg-12">
                                            <div class="col-lg-4"></div>
                                            <div class="col-lg-8"></div>

                                            <h4><i class="fa fa-list"></i> Datos generales</h4>
                                            <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 2px 0px 6px 0px;"></div>
                                            <div class="form-row">

                                                <!-- moneda DropDownList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group newEmision'>
                                                        @*<i class="fa fa-money icon"></i>*@
                                                        <label class='control-label' for='moneda'>
                                                            Moneda
                                                        </label>
                                                        <select id='moneda' name='moneda' class='form-control' disabled></select>
                                                        <div class="lineNE"></div>
                                                    </div>
                                                </div>

                                                <!-- fraccionamientodepago DropDownList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group newEmision'>
                                                        @*<i class="fa fa-check-square icon"></i>*@
                                                        <label class='control-label' for='fraccionamientodepago'>
                                                            Fraccionamiento de pago
                                                        </label>
                                                        <select id='fraccionamientodepago' name='fraccionamientodepago' class='form-control'></select>
                                                        <div class="lineNE"></div>
                                                    </div>
                                                </div>

                                                <!-- iniciodevigencia DatePicker -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group newEmision'>
                                                        @*<i class="fa fa-calendar-check-o icon"></i>*@
                                                        <label class='control-label' for='iniciodevigencia'>
                                                            Inicio de vigencia
                                                        </label>
                                                        <div class='input-group date' id='iniciodevigencia_group'>
                                                            <input type='text' id='iniciodevigencia' name='iniciodevigencia' class='form-control' size='10' maxlength='10' placeholder='día/mes/año' disabled />
                                                            <span class='input-group-addon'>
                                                                <span class='glyphicon glyphicon-calendar'></span>
                                                            </span>
                                                        </div>
                                                        <div id='iniciodevigencia_validate'></div>
                                                        <div class="lineNE"></div>
                                                    </div>
                                                </div>

                                                <!-- findevigencia DatePicker -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group newEmision'>
                                                        @*<i class="fa fa-calendar-times-o icon"></i>*@
                                                        <label class='control-label' for='findevigencia'>
                                                            Fin de vigencia
                                                        </label>
