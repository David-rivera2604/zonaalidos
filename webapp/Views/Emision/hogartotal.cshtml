                                            <div class="form-row">
                                                <div class='col-md-12' style="padding-bottom: 20px">
                                                    <div class="table-responsive">
                                                        <table id="propiedadTbl" style="font-size: 11px;">
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>


                                    <!-- terceros Grid -->
                                    <div class="form-row">
                                        <div class="col-lg-12">
