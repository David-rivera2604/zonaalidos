                                                        <select id='medidasdeseguridad' name='medidasdeseguridad' class='form-control' multiple="multiple" disabled></select>
                                                        <div class="lineNE"></div>
                                                    </div>
                                                </div>

                                                <!-- descuento DropDownList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group newEmision'>
                                                        @*<i class="fa fa-sort-amount-desc icon"></i>*@
                                                        <label class='control-label' for='descuento'>
                                                            Descuento
                                                        </label>
                                                        <select id='descuento' name='descuento' class='form-control' disabled></select>
                                                        <div class="lineNE"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-row">
                                        <div class="col-sm-12 col-md-12">
                                            <!-- sumasaseguradas Zone -->
                                            <div class="form-row">
                                                <div class="col-lg-12">
                                                    <div class="form-row">
                                                        <div class="col">
                                                            <h4><i class="fa fa-plus-square-o"></i> Sumas aseguradas</h4>
                                                        </div>
                                                    </div>
                                                    <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 2px 0px 6px 0px;"></div>
                                                    <div class="form-row">

                                                        <!-- sAEdificio Numeric -->
                                                        <div class='col-sm-3 col-md-3 '>
                                                            <div class='form-group newEmision'>
                                                                @*<i class="fa fa-building icon"></i>*@
                                                                <label class='control-label' for='sAEdificio'>Edificio</label>
                                                                <input type='text' id='sAEdificio' name='sAEdificio' class='form-control text-right' size='21' maxlength='21' disabled />
                                                                <div class="lineNE"></div>
                                                            </div>
                                                        </div>
                                                        <!-- sAObjetosvaliosos Numeric -->
                                                        <div class='col-sm-3 col-md-3'>
                                                            <div class='form-group newEmision'>
                                                                @*<i class="fa fa-diamond icon"></i>*@
