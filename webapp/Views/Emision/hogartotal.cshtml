                                                    <h4>
                                                        <i class="fa fa-user-o"></i> Terceros<label id="tercerosTbl-error" class="float-right d-none" style="color: #cc5965;
                                                                display: inline-block;
                                                                font-size: 11px;
                                                                font-weight: normal;
                                                        ">Debe indicar la información de terceros</label>
                                                    </h4>
                                                </div>
                                                <div class='col-auto'>
                                                    <button type="button" class="btn btn-sm btn-white" title="Al hacer click permite agregar un nuevo tercero a la póliza" data-toggle="modal" id="tercerosNew"> <i class="fa fa-plus"></i> </button>
                                                </div>
                                            </div>
                                            <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 2px 0px 6px 0px;"></div>
                                            <div class="form-row">
                                                <div class='col-md-12' style="padding-bottom: 20px">

                                                    <div class="table-responsive">
                                                        <table id="tercerosTbl" style="font-size: 11px;">
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

