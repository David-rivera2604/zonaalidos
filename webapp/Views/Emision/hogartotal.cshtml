                                                                <label class='control-label' for='sARespcivil'>
                                                                    Responsabilidad civil
                                                                </label>
                                                                <select id='sARespcivil' name='sARespcivil' class='form-control' disabled></select>
                                                                <div class="lineNE"></div>
                                                            </div>
                                                        </div>

                                                        <!-- sAMobiliario Numeric -->
                                                        <div class='col-sm-3 col-md-3'>
                                                            <div class='form-group newEmision'>
                                                                @*<i class="fa fa-home icon"></i>*@
                                                                <label class='control-label' for='sAMobiliario'>
                                                                    sAMobiliario
                                                                </label>
                                                                <input type='text' id='sAMobiliario' name='sAMobiliario' class='form-control text-right' size='21' maxlength='21' disabled />
                                                                <div class="lineNE"></div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-row">
                                        <div class="col-sm-9 col-md-12">
                                            <!-- coberturas Grid -->
                                            <div class="form-row" id="coberturasRow">
                                                <div class="col-lg-12">
                                                    <div class="form-row">
                                                        <div class='col'>
                                                            <h4><i class="fa fa-check-square-o"></i> Coberturas</h4>
                                                        </div>
                                                        <div class='col-auto'>
                                                            <button type="button" class="btn btn-sm btn-white d-none" title="Al hacer click permite agregar un nuevo Coberturas" data-toggle="modal" id="coberturasNew"> <i class="fa fa-plus"></i> </button>
                                                        </div>
                                                    </div>
                                                    <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 2px 0px 6px 0px;"></div>
                                                    <div class="form-row">
                                                        <div class='col-md-12' style="padding-bottom: 20px">
                                                            <div class="table-responsive">
                                                                <table id="coberturasTbl" style="font-size: 11px;">
                                                                </table>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Notificaciones  -->
                                    <div id="quoteNotify">
                                    </div>


                                    <!-- plandepago Grid -->
                                    <div class="form-row" id="plandepagoRow">
                                        <div class="col-lg-12">
                                            <div class="form-row">
                                                <div class='col'>
                                                    <h4><i class="fa fa-credit-card"></i> Plan de pago</h4>
                                                </div>
                                                <div class='col-auto'>
