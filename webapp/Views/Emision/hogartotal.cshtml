@{
    Layout = "~/Views/_Layout.cshtml";
}
@Styles.Render("~/Content/cssCRUD")
<div class="row">
    <div id="mainBlock" class="col-md-12 p-0">
        <div class="ibox">
            <div class="ibox-title p-0">
                <div class="Title_Prin py-2">
                    <div class="title_design T1">
                        <h5><i class="fa fa-home"></i> <span id="PageTitle">Hogar Total</span></h5><br>
                        <small class="m-l-sm"><span id="PageSubTitle"> Emisión</span></small>
                    </div>
                    <div class="title_partner T2">
                        <p class="text-muted small">MAPFRE le trae una nueva forma de proteger a su familia, con nuestro seguro Hogar Total. Más que un seguro contra siniestros o robos, es un seguro de protección total para su hogar; 11 riesgos de cobertura básica y 8 coberturas opcionales.</p>
                        <p class="text-muted">Todos los campos que cuentan con asterisco rojo , son obligatorios para continuar.</p>
                    </div>
                    <div class="title_partner T3 text-center">
                        <a href="https://www.mapfre.cr/seguros-cr/seguros/hogar/hogar-total/" target="_blank">Seguro Hogar Total</a>
                        <p class="mt-2 text-center">
                            Más que un seguro, una protección integral.
                        </p>
                    </div>
                </div>
            </div>


            <div class="ibox-content box_design">
                <div class="sk-spinner sk-spinner-wave">
                    <div class="sk-rect1"></div>
                    <div class="sk-rect2"></div>
                    <div class="sk-rect3"></div>
                    <div class="sk-rect4"></div>
                    <div class="sk-rect5"></div>
                </div>
                <div id="generalNotify">
                </div>

                <!-- Edit Form -->
                <div class="form-row">
                    <!-- Opciones -->
                    <div class="ibox-tools">
                        <a class="fullscreen-link">
                            <i class="fa fa-expand"></i>
                        </a>
                    </div>
                    <div class="col-md-12 m-2">
                        <div id="VisualizationsEdt" class="animated fadeInRight">
