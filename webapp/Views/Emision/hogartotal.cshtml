                                                            <span class='input-group-addon'>
                                                                <span class='glyphicon glyphicon-calendar'></span>
                                                            </span>
                                                        </div>
                                                        <div id='findevigencia_validate'></div>
                                                        <div class="lineNE"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                    </div>

