                                                </div>
                                            </div>
                                            <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 2px 0px 6px 0px;"></div>
                                            <div class="form-row">
                                                <div class='col-md-12' style="padding-bottom: 20px">
                                                    <div class="table-responsive">
                                                        <table id="plandepagoTbl" style="font-size: 11px;">
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- datosPropiedad Grid -->
                                    <div class="form-row">
                                        <div class="col-lg-12">
                                            <div class="form-row">
                                                <div class='col'>
                                                    <h4>
                                                        <i class="fa fa-home"></i> Datos de la propiedad a asegurar<label id="propiedadTbl-error" class="float-right d-none" style="color: #cc5965;
        display: inline-block;
        font-size: 11px;
        font-weight: normal;
">Debe indicar la información de la propiedad a asegurar</label>
                                                    </h4>
                                                </div>
                                                <div class='col-auto'>
                                                    <button type="button" class="btn btn-sm btn-white" title="Al hacer click permite agregar un nuevo tercero" data-toggle="modal" id="propiedadNew"> <i class="fa fa-plus"></i> </button>
                                                </div>
                                            </div>
