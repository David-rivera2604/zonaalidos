                                                                <label class='control-label newEmision' for='sADomocristalmarmolgranito'>
                                                                    Domo, cristal, mármol, granito
                                                                </label>
                                                                <input type='text' id='sADomocristalmarmolgranito' name='sADomocristalmarmolgranito' class='form-control text-right' size='21' maxlength='21' disabled />
                                                                <div class="lineNE"></div>
                                                            </div>
                                                        </div>
                                                        <!-- sAGastosalquiler Numeric -->
                                                        <div class='col-sm-3 col-md-3'>
                                                            <div class='form-group newEmision'>
                                                                @*<i class="fa fa-key icon"></i>*@
                                                                <label class='control-label' for='sAGastosalquiler'>
                                                                    Gastos alquiler
                                                                </label>
                                                                <input type='text' id='sAGastosalquiler' name='sAGastosalquiler' class='form-control text-right' size='21' maxlength='21' disabled />
                                                                <div class="lineNE"></div>
                                                            </div>
                                                        </div>
                                                        <!-- sAPerdidaderentas Numeric -->
                                                        <div class='col-sm-3 col-md-3'>
                                                            <div class='form-group newEmision'>
                                                                @*<i class="fa fa-level-down icon"></i>*@
                                                                <label class='control-label' for='sAPerdidaderentas'>
                                                                    Pérdida de rentas
                                                                </label>
                                                                <input type='text' id='sAPerdidaderentas' name='sAPerdidaderentas' class='form-control text-right' size='21' maxlength='21' disabled />
                                                                <div class="lineNE"></div>
                                                            </div>
                                                        </div>
                                                        <!-- sARespcivil DropDownList -->
                                                        <div class='col-sm-3 col-md-3'>
