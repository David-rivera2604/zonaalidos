                                                                <input type="radio" class="custom-control-input" id="MCA_CERO_KM_2" name="MCA_CERO_KM" value="2">
                                                                <label class="custom-control-label" for="MCA_CERO_KM_2">No</label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- MCA_AUTO_GPS RadioButtonList -->
                                                <div class='col-sm-3 col-md-3 role-Purdy-notvisible'>
