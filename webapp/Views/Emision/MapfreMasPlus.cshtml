@{
    Layout = "~/Views/_Layout.cshtml";
}
@Styles.Render("~/Content/cssCRUD")
<div class="row">
    <div id="mainBlock" class="col-md-12">
        <div class="ibox">
            <div class="ibox-title">
                <h5><span id="PageTitle">MAPFRE 303</span><small class="m-l-sm"><span id="PageSubTitle"> Emisión</span></small> </h5>
                <!-- Opciones -->
                <div class="ibox-tools">
                    <a class="fullscreen-link">
                        <i class="fa fa-expand"></i>
                    </a>
                </div>
            </div>
            <div class="ibox-content">
                <p class="text-muted small">En MAPFRE Costa Rica hemos creado una amplia variedad de opciones con excelentes coberturas y valores agregados, pensados para todas las necesidades de los costarricenses. <a href="https://www.mapfre.cr/seguros-cr/seguros/autos/" target="_blank">Seguro MAPFRE 303</a>, El seguro que le ofrece diferentes coberturas desde responsabilidad civil, colisión y/o vuelco, robo, y coberturas adicionales.</p>
                <div class="sk-spinner sk-spinner-wave">
                    <div class="sk-rect1"></div>
                    <div class="sk-rect2"></div>
                    <div class="sk-rect3"></div>
                    <div class="sk-rect4"></div>
                    <div class="sk-rect5"></div>
                </div>
                <div id="generalNotify">
                </div>
                <!-- Edit Form -->
                <div class='form-row'>
                    <div class='col-md-12'>
                        <div id="VisualizationsEdt" class="animated fadeInRight">
                            <form id='VisualizationsEdtForm' class='form-horizontal' data-toggle='validator'>
                                <fieldset>

                                    <div class="form-row">
                                        <!-- datosgenerales Zone -->
                                        <div class="col-md-12 datosgeneralesZone">
                                            <h4><i class="fa fa-list"></i> Datos generales</h4>
                                            <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                            <div class="form-row">
                                                <!-- Fuente_Tomador DropDownList -->
                                                <div class='col-sm-5 col-md-5 Purdy d-none'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='Fuente_Tomador'>Tomador<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <select id='Fuente_Tomador' name='Fuente_Tomador' class='form-control' disabled>
                                                            <option value="CAFSA">FINANCIERA CAFSA</option>
                                                            <option value="PURDY">PURDY MOTOR</option>
                                                            <option value="SCOTIABANK">SCOTIABANK</option>
                                                        </select>
                                                    </div>
                                                </div>
                                                <!-- Modalidad_Pago DropDownList -->
                                                <div class='col-sm-7 col-md-7 Purdy d-none'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='Modalidad_Pago'>Modalidad de pago<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
