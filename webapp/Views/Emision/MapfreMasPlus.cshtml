                                                <!-- NUM_MATRICULA Text -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='NUM_MATRICULA'>Número de placa<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <input type='text' id='NUM_MATRICULA' name='NUM_MATRICULA' class='form-control' size='30' maxlength='30' autocomplete='off' />
                                                    </div>
                                                </div>
                                                <!-- COD_CHASSIS Text -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='COD_CHASSIS'>Número de chasis<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <input type='text' id='COD_CHASSIS' name='COD_CHASSIS' class='form-control' size='30' maxlength='30' />
                                                    </div>
                                                </div>
                                                <!-- NUM_MOTOR Text -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='NUM_MOTOR'>Número de motor<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
