                            <i class="fa fa-envelope"></i> <a style="padding-left: 4px;" href="mailto:jennifer.ramirez@mapfrecr.com">jennifer.ramirez@mapfrecr.com</a> 
                        </address>
                    </div>
                    <div class="col-6">
                        <strong>Eimy Alvarado</strong>
                        <address class="p-xs">
                            <i class="fa fa-phone"></i> <a style="padding-left: 4px;" href="tel:+50641040204">+506 4104-0204</a> <br />
                            <i class="fa fa-envelope"></i> <a style="padding-left: 4px;" href="mailto:eimy.alvarado@mapfrecr.com">eimy.alvarado@mapfrecr.com</a>
                        </address>
                    </div>
                    <div class="col-6">
                        <strong>Katherine Mata</strong>
                        <address class="p-xs">
                            <i class="fa fa-phone"></i> <a style="padding-left: 4px;" href="tel:+50641040276">+506 4104-0276</a> <br />
                            <i class="fa fa-envelope"></i> <a style="padding-left: 4px;" href="mailto:katherine.mata@mapfrecr.com">katherine.mata@mapfrecr.com</a>
                        </address>
                    </div>
                    <div class="col-6">
                        <strong>Luis Guillermo Masís</strong>
                        <address class="p-xs">
                            <i class="fa fa-phone"></i> <a style="padding-left: 4px;" href="tel:+50641040218">+506 4104-0218</a>  <br />
                            <i class="fa fa-envelope"></i> <a style="padding-left: 4px;" href="mailto:luis.masis@mapfrecr.com">luis.masis@mapfrecr.com</a>
                        </address>
