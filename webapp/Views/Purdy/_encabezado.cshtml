<!-- Edit Form -->
<div class='form-row'>
    <div class='col-md-12'>
        <div id="PanelPurdyEncabezadoEdt" class="animated fadeInRight compact">
            <form id='PanelPurdyEncabezadoEdtForm' class='form-horizontal' data-toggle='validator'>
                <fieldset>
                    <!-- seccionEncabezado Zone -->
                    <div class="form-row">
                        @*<div class="col-lg-12">
                            <h4>Sección Encabezado</h4>
                            <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>*@
                        <!-- aSIGES Text -->
                        <div class='col-sm-3 col-md-3'>
                            <div class='form-group'>
                                <label class='control-label' for='aSIGES'>ASIGES<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                <input type='text' id='aSIGES' name='aSIGES' class='form-control' size='16' maxlength='16' />

                            </div>
                        </div>
                        <!-- tipodeindemnizacion DropDownList -->
                        <div class='col-sm-3 col-md-3'>
                            <div class='form-group'>
                                <label class='control-label' for='tipodeindemnizacionEnc'>Tipo de indemnización</label>
                                <div id='tipodeindemnizacionEnc' class="readonly"></div>

                                <div class="input-group d-none tipodeindemnizacionGrp-visible">
                                    <select id='tipodeindemnizacion' name='tipodeindemnizacion' class='form-control'>
                                        <option value='1'>Casos reparados</option>
                                        <option value='2'>Pérdida total financiera</option>
                                        <option value='3'>Pérdida total estructural</option>
                                        <option value='4'>Casos con avalúo pendiente de reparación</option>
                                        <option value='5'>Repuestos pendientes</option>
                                        <option value='6'>Avalúo cliente no repara aún</option>
                                        <option value='7'>Pendiente de avalúo</option>
                                        <option value='8'>No procede</option>
                                        <option value='9'>Posible pérdida total</option>
                                        <option value='10'>Pago directo</option>
                                    </select>
                                    <span class="input-group-append d-none tipodeindemnizacionSave-visible">
                                        <button id="tipodeindemnizacionSave" type="button" class="btn btn-primary">
                                            Guardar cambio
                                        </button>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- estadoMapfre DropDownList -->
                        <div class='col-sm-3 col-md-3'>
                            <div class='form-group'>
                                <label class='control-label' for='estadoMapfre'>Estado Mapfre</label>
                                <div id='estadoMapfre' class="readonly"></div>
                            </div>
                        </div>

                        <!-- numerodepoliza Numeric -->
                        <div class='col-sm-3 col-md-3'>
                            <div class='form-group'>
                                <label class='control-label' for='NUM_POLIZA'>Número de póliza</label>
                                <div id='NUM_POLIZA' class="readonly"></div>
                            </div>
                        </div>
                        <!-- DocumentNumber Text -->
                        <div class='col-sm-3 col-md-3'>
                            <div class='form-group'>
                                <label class='control-label' for='cedulaasegurado'>Cédula asegurado</label>
                                <div id='cedulaasegurado' class="readonly"></div>
                            </div>
                        </div>
                        <!-- nombreasegurado Text -->
                        <div class='col-sm-3 col-md-3'>
                            <div class='form-group'>
                                <label class='control-label' for='nombreasegurado'>Nombre asegurado</label>
                                <div id='nombreasegurado' class="readonly"></div>
                            </div>
                        </div>

                        <!-- correoasegurado Text -->
                        <div class='col-sm-3 col-md-3'>
                            <div class='form-group'>
                                <label class='control-label' for='correoasegurado'>Correo asegurado</label>
                                <div id='correoasegurado' class="readonly"></div>
                            </div>
                        </div>
                        <!-- telefonoasegurado Text -->
                        <div class='col-sm-3 col-md-3'>
                            <div class='form-group'>
                                <label class='control-label' for='telefonoasegurado'>Teléfono asegurado</label>
                                <div id='telefonoasegurado' class="readonly"></div>
                            </div>
                        </div>
                        <!-- ingresodeaviso DatePicker -->
                        <div class='col-sm-3 col-md-3'>
                            <div class='form-group'>
                                <label class='control-label' for='ingresodeaviso'>Ingreso de aviso</label>
                                <div id='ingresodeaviso' class="readonly"></div>
                            </div>
                        </div>

                        <!-- fechadeleventoEnc DatePicker -->
                        <div class='col-sm-3 col-md-3'>
                            <div class='form-group'>
                                <label class='control-label' for='fechadeleventoEnc'>Fecha del evento</label>
                                <div id='fechadeleventoEnc' class="readonly"></div>

                            </div>
                        </div>

                        <!-- noSiniestro Numeric -->
                        <div class='col-sm-3 col-md-3'>
                            <div class='form-group'>
                                <label class='control-label' for='noSiniestro'>No. Siniestro</label>
                                <div id='noSiniestro' class="readonly"></div>
                            </div>
                        </div>

                        <!-- categoriadesiniestro DropDownList -->
                        <div class='col-sm-3 col-md-3'>
                            <div class='form-group'>
                                <label class='control-label' for='categoriadesiniestroEnc'>Categoría de siniestro</label>
                                <div id='categoriadesiniestroEnc' class="readonly"></div>
                            </div>
                        </div>
                        <!-- tipodeindemnizacionSel DropDownList -->
                        <div class='col-sm-3 col-md-3'>
                            <div class='form-group'>
                                <label class='control-label' for='tipodeindemnizacionSel'>Tipo de indemnización</label>
                                <div id='tipodeindemnizacionSel' class="readonly"></div>
                            </div>
                        </div>
                        <!-- analistareclamosSel DropDownList -->
                        <div class='col-sm-3 col-md-3'>
                            <div class='form-group'>
                                <label class='control-label' for='analistareclamosSel'>Analista reclamos</label>
                                <div id='analistareclamosSel' class="readonly"></div>
                            </div>
                        </div>

                        <!-- analistagestora DropDownList -->
                        <div class='col-sm-3 col-md-3'>
                            <div class='form-group'>
                                <label class='control-label' for='analistagestoraEnc'>Analista gestora</label>
                                <div id='analistagestoraEnc' class="readonly"></div>
                                <div class="input-group d-none analistagestoraGrp-visible">
                                    <select id='analistagestora' name='analistagestora' class='form-control'>
                                    </select>
                                    <span class="input-group-append d-none analistagestoraSave-visible">
                                        <button id="analistagestoraSave" type="button" class="btn btn-primary">
                                            Guardar cambio
                                        </button>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- detallesiniestro Notes -->
                        <div class='col-sm-12 col-md-12'>
                            <div class='form-group'>
                                <label class='control-label' for='detallesiniestro'>Detalle siniestro</label>
                                <div id='detallesiniestro' class="readonly"></div>
                            </div>
                        </div>
                    </div>
                    @*</div>
                        </div>*@
                </fieldset>
            </form>
        </div>
    </div>
</div>
<!-- Edit Form End -->