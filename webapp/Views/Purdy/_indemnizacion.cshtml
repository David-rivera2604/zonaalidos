                                            </div>
                                        </div><!-- montoDanoOcultoporIndemnizarRepuestos Numeric -->
                                        <div class='col-sm-4 col-md-4 DanoOculto-visible d-none'>
                                            <div class='form-group'>
                                                <label class='control-label' for='montoDanoOcultoporIndemnizarRepuestos'>Monto daño oculto por indemnizar</label>
                                                <input type='text' id='montoDanoOcultoporIndemnizarRepuestos' name='montoDanoOcultoporIndemnizarRepuestos' class='form-control text-right role-Administrativo-enable' size='26' maxlength='26' disabled />
                                                <small class="form-text text-muted">(Repuestos)</small>
                                            </div>
                                        </div><!-- montoDanoOcultoporIndemnizarManodeObra Numeric -->
                                        <div class='col-sm-4 col-md-4 DanoOculto-visible d-none'>
                                            <div class='form-group'>
                                                <label class='control-label' for='montoDanoOcultoporIndemnizarManodeObra'>Monto daño oculto por indemnizar</label>
