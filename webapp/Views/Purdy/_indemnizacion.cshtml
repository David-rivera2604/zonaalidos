                                            </div>
                                        </div><!-- montoInicialporIndemnizarRepuestos Numeric -->
                                        <div class='col-sm-4 col-md-4'>
                                            <div class='form-group'>
                                                <label class='control-label' for='montoInicialporIndemnizarRepuestos'>Monto inicial por indemnizar</label>
                                                <input type='text' id='montoInicialporIndemnizarRepuestos' name='montoInicialporIndemnizarRepuestos' class='form-control text-right role-Administrativo-enable' size='26' maxlength='26' disabled />
