    </div>
</div>

<!-- balance Grid Modal -->
<div class="modal inmodal" id="balanceModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content animated bounceInRight">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">Cerrar</span></button>
                <h4 class="modal-title">Balance</h4>
                <small class="font-bold">Permite agregar un nuevo Balance o editar uno ya existente</small>
            </div>
            <div class="modal-body">
                <!-- balance Grid Edit Form -->
                <div class='form-row'>
                    <div class='col-md-12'>
                        <div id="balanceEdt" class="animated fadeInRight">
                            <form id='balanceEdtForm' class='form-horizontal' data-toggle='validator'>
                                <fieldset>
                                    <div class='form-row'>
                                        <!-- numerodeSiniestro Text -->
                                        <div class='col-sm-4 col-md-4'>
                                            <div class='form-group'>
                                                <label class='control-label' for='numerodeSiniestro'>Número de siniestro</label>
                                                <input type='text' id='numerodeSiniestro' name='numerodeSiniestro' class='form-control' size='0' maxlength='0' disabled />

                                            </div>
                                        </div><!-- tipodedocumento DropDownList -->
                                        <div class='col-sm-4 col-md-4'>
                                            <div class='form-group'>
                                                <label class='control-label' for='tipodedocumento'>Tipo de documento</label>
                                                <select id='tipodedocumento' name='tipodedocumento' class='form-control'>
                                                    <option value='1'>Factura MO (x pagar)</option>
                                                    <option value='2'>Factura RE (x pagar)</option>
                                                    <option value='3'>Cobro deducible (x cobrar)</option>
                                                    <option value='4'>Ajuste (gasto)</option>
                                                </select>
                                            </div>
                                        </div>
                                        <!-- numerodedocumento Text -->
                                        <div class='col-sm-4 col-md-4'>
                                            <div class='form-group'>
                                                <label class='control-label' for='numerodedocumento'>Número de documento</label>
                                                <input type='text' id='numerodedocumento' name='numerodedocumento' class='form-control role-Administrativo-enable' size='20' maxlength='20' disabled />

                                            </div>
                                        </div><!-- fecha DatePicker -->
                                        <div class='col-sm-4 col-md-4'>
                                            <div class='form-group'>
                                                <label class='control-label' for='fecha'>Fecha</label>
                                                <div class='input-group date' id='fecha_group'>
                                                    <input type='text' id='fecha' name='fecha' class='form-control role-Administrativo-enable' size='10' maxlength='10' placeholder='día/mes/año' disabled />
                                                    <span class='input-group-addon'>
                                                        <span class='glyphicon glyphicon-calendar'></span>
                                                    </span>
                                                </div>
                                                <div id='fecha_validate'></div>
                                            </div>
                                        </div>
                                        <!-- receptor Text -->
                                        <div class='col-sm-4 col-md-4'>
                                            <div class='form-group'>
                                                <label class='control-label' for='receptor'>Receptor</label>
                                                <input type='text' id='receptor' name='receptor' class='form-control role-Administrativo-enable' size='100' maxlength='100' disabled />

                                            </div>
                                        </div><!-- monto Numeric -->
                                        <div class='col-sm-4 col-md-4'>
                                            <div class='form-group'>
                                                <label class='control-label' for='monto'>Monto</label>
                                                <input type='text' id='monto' name='monto' class='form-control text-right role-Administrativo-enable' size='26' maxlength='26' disabled />
                                            </div>
                                        </div><!-- nCRepuesto Numeric -->
                                        <div class='col-sm-4 col-md-4'>
                                            <div class='form-group'>
                                                <label class='control-label' for='nCRepuesto'>NC Repuesto</label>
                                                <input type='text' id='nCRepuesto' name='nCRepuesto' class='form-control text-right' size='26' maxlength='26' disabled />
                                            </div>
                                        </div>
                                    </div>
                                    <div class='form-row'>
                                        <!-- observacion Notes -->
                                        <div class='col-sm-12 col-md-12'>
                                            <div class='form-group'>
                                                <label class='control-label' for='observacion'>Observación</label>
                                                <textarea id='observacion' name='observacion' class='form-control role-Administrativo-enable' rows='2' disabled></textarea>
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary role-Administrativo-visible d-none" id="balanceEdtFormSave" data-doing="Guardando...">Guardar cambios</button>
                <button type="button" class="btn btn-white" data-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>
