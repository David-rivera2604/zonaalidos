                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">Cerrar</span></button>
                <h4 class="modal-title">Movimientos de montos</h4>
                <small class="font-bold">Permite agregar un nuevo Movimientos de montos o editar uno ya existente</small>
            </div>
            <div class="modal-body">
                <!-- movimientosdemontos Grid Edit Form -->
                <div class='form-row'>
                    <div class='col-md-12'>
                        <div id="movimientosdemontosEdt" class="animated fadeInRight">
