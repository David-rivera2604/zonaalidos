@{
    Layout = "~/Views/_Layout.cshtml";
}
@Styles.Render("~/Content/cssCRUD")
<!-- ProcessSpecTask -->
<div class="ibox">
    <div class="ibox-title">
        <h5>Tareas de una etapa</h5>
        <!-- Opciones -->
        <div class="ibox-tools">
            <a class="tool-new">
                <i class="fa fa-plus" title="Crear un nuevo process spec task"></i>
            </a>
            <a class="fullscreen-link">
                <i class="fa fa-expand" title="Expande la zona de trabajo"></i>
            </a>
            <a class="dropdown-toggle" data-toggle="dropdown" href="#" title="Opciones adicionales...">
                <i class="fa fa-wrench"></i>
            </a>
            <ul class="dropdown-menu dropdown-user">
                <li>
                    <a href="#" class="dropdown-item tool-new"><i class="fa fa-plus"></i> Crear un nuevo process spec task</a>
                </li>
                <li>
                    <a href="#" class="dropdown-item tool-filter"><i class="fa fa-filter"></i> Despliega el filtro avanzado...</a>
                </li>
                <li>
                    <a href="#" class="dropdown-item tool-refresh"><i class="fa fa-refresh"></i> Recargar los table2s</a>
                </li>
                <li>
                    <a href="#" class="dropdown-item tool-filter"><i class="fa fa-file-excel-o"></i> Exportar a Excel...</a>
                </li>
                <li>
                    <a href="#" class="dropdown-item tool-audit" data-toggle="modal" data-target="#myModal5"><i class="fa fa-clock-o"></i> Historial...</a>
                </li>
            </ul>
        </div>
    </div>
    <div class="ibox-content">
        <div class="sk-spinner sk-spinner-wave">
            <div class="sk-rect1"></div>
            <div class="sk-rect2"></div>
            <div class="sk-rect3"></div>
            <div class="sk-rect4"></div>
            <div class="sk-rect5"></div>
        </div>
        <div id="generalNotify">
        </div>
        <!-- Filtro avanzado -->
        <div class='form-row advancefilter-row animated fadeInDown'>
            <!-- FlowId -->
            <div class='col-sm-4 col-md-4'>
                <div class='form-group'>
                    <label class='control-label' for='FlowIdFlt'>Proceso<span class='required-mark'>*</span></label>
                    <select id='FlowIdFlt' name='FlowIdFlt' class='form-control'></select>
                </div>
            </div>
            <div class="form-group col-md-4">
                <label class="control-label" for="StepIdFlt">Etapa<span class='required-mark'>*</span></label>
                <select id="StepIdFlt" name="StepIdFlt" title="" multiple class="form-control form-control-sm">
                </select>
            </div>
        </div>
        <!-- Grid -->
        <div class='form-row'>
            <div class='col-md-12'>
                <div class="table-responsive animated bounceInRight">
                    <table id="ProcessSpecTaskGridTbl" style="font-size: 11px;"></table>
                </div>
            </div>
        </div>
        <!-- Edit Form -->
        <div class='form-row'>
            <div class='col-md-12'>
                <div id="ProcessSpecTaskEdt" class="animated fadeInRight d-none">
                    <form id='ProcessSpecTaskEdtForm' class='form-horizontal' data-toggle='validator'>
                        <fieldset>
                            <div class="form-row">
                                <!-- Id -->
                                <input id='Id' name='Id' type='hidden' value=''>
                                <!-- FlowId -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='FlowId'>Proceso</label>
                                        <select id='FlowId' name='FlowId' class='form-control'></select>
                                    </div>
                                </div>
                                <!-- StepId -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='StepId'>Etapa<span class='required-mark'>*</span></label>
                                        <select id='StepId' name='StepId' class='form-control'></select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-row">
                                <!-- Name -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='Name'>Nombre<span class='required-mark'>*</span></label>
                                        <input id='Name' name='Name' type='text' class='form-control' size='80' maxlength='80'>
                                    </div>
                                </div>
                                <!-- Description -->
                                <div class='col-sm-8 col-md-8'>
                                    <div class='form-group'>
                                        <label class='control-label' for='Description'>Descripción</label>
                                        <input id='Description' name='Description' type='text' class='form-control' size='256' maxlength='256'>
                                    </div>
                                </div>
                                <!-- TaskOrder -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='TaskOrder'>Orden<span class='required-mark'>*</span></label>
                                        <input id='TaskOrder' name='TaskOrder' type='text' class='form-control text-right' size='9' maxlength='9'>
                                        <small class="form-text text-muted">En caso de que el valor sea cero, el Sistema lo calculará de forma automática.</small>
                                    </div>
                                </div>
                                <!-- SLATimeOut -->
                                <div class='col-sm-4 col-md-4 advanced d-none'>
                                    <div class='form-group'>
                                        <label class='control-label' for='SLATimeOut'>Tiempo máximo para la atención (SLA)</label>
                                        <input id='SLATimeOut' name='SLATimeOut' type='text' class='form-control text-right' size='9' maxlength='9'>
                                    </div>
                                </div>
                                <!-- IsRequired -->
                                <div class='col-sm-4 col-md-4 advanced d-none'>
                                    <div class='form-group'>
                                        <label class='control-label' for='IsRequired'>Is Required</label>
                                        <input id='IsRequired' name='IsRequired' type='text' class='form-control' size='1' maxlength='1'>
                                    </div>
                                </div>
                                <!-- IsSelected -->
                                <div class='col-sm-4 col-md-4 advanced d-none'>
                                    <div class='form-group'>
                                        <label class='control-label' for='IsSelected'>Is Selected</label>
                                        <input id='IsSelected' name='IsSelected' type='text' class='form-control' size='1' maxlength='1'>
                                    </div>
                                </div>
                                <!-- SubStatus -->
                                <div class='col-sm-4 col-md-4 advanced d-none'>
                                    <div class='form-group'>
                                        <label class='control-label' for='SubStatus'>Estado</label>
                                        <input id='SubStatus' name='SubStatus' type='text' class='form-control text-right' size='3' maxlength='3'>
                                    </div>
                                </div>
                                <!-- SubLabel -->
                                <div class='col-sm-4 col-md-4 advanced d-none'>
                                    <div class='form-group'>
                                        <label class='control-label' for='SubLabel'>Etiqueta</label>
                                        <input id='SubLabel' name='SubLabel' type='text' class='form-control' size='80' maxlength='80'>
                                    </div>
                                </div>


                            </div>
                            <!-- Acción -->
                            <div class="form-row">
                                <div class="col-lg-12">
                                    <h4> Acción</h4>
                                    <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                    <div class="form-row">
                                        <!-- Type -->
                                        <div class='col-sm-4 col-md-4'>
                                            <div class='form-group'>
                                                <label class='control-label' for='Type'>Tipo<span class='required-mark'>*</span></label>
                                                <select id='Type' name='Type' class='form-control'></select>
                                            </div>
                                        </div>
                                        <!-- Action -->
                                        <div class='col-sm-4 col-md-4'>
                                            <div class='form-group'>
                                                <label class='control-label' for='Action'>Detalle</label>
                                                <input id='Action' name='Action' type='text' class='form-control advanced d-none' size='9' maxlength='9'>
                                                <select id='ActionGoto' name='ActionGoto' class='form-control'></select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Scripts -->
                            <div class="form-row advanced d-none">
                                <div class="col-lg-12">
                                    <h4> Scripts</h4>
                                    <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                    <div class="form-row">
                                        <!-- PreScript -->
                                        <div class='col-sm-4 col-md-4'>
                                            <div class='form-group'>
                                                <label class='control-label' for='PreScript'>Pre Script</label>
                                                <input id='PreScript' name='PreScript' type='text' class='form-control' size='9' maxlength='9'>
                                            </div>
                                        </div>
                                        <!-- PostScript -->
                                        <div class='col-sm-4 col-md-4'>
                                            <div class='form-group'>
                                                <label class='control-label' for='PostScript'>Post Script</label>
                                                <input id='PostScript' name='PostScript' type='text' class='form-control' size='9' maxlength='9'>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-row">
                                <div class='col-md-12'>
                                    <button id="ProcessSpecTaskEdtFormSave" type="button" class="btn btn-primary btn-sm d-none formbtn" data-doing="Guardando cambios..." title="Guardar cambios">Guardar</button>
                                    <button id="ProcessSpecTaskEdtFormSaveContinue" type="button" class="btn btn-primary btn-sm d-none formbtn" data-doing="Guardando cambios..." title="Guardar cambios y continuar">Guardar y continuar</button>
                                    <button id="ProcessSpecTaskEdtFormSaveCopy" type="button" class="btn btn-primary btn-sm d-none formbtn" data-doing="Guardando cambios..." title="Guardar cambios y continuar">Guardar y copiar</button>
                                    <button id="ProcessSpecTaskEdtFormDuplicate" type="button" class="btn btn-info btn-sm d-none formbtn" data-doing="Duplicando..." title="Duplica la información actual">Duplicar</button>
                                    <button id="ProcessSpecTaskEdtFormDelete" type="button" class="btn btn-danger btn-sm d-none formbtn" data-doing="Eliminando..." title="Elimina la información actual">Eliminar</button>
                                    <button id="ProcessSpecTaskEdtFormCancel" type="button" class="btn btn-white btn-sm d-none formbtn">Cancelar</button>
                                </div>
                            </div>
                        </fieldset>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jsCRUD")
    <script src="@Url.Content("~/Scripts/General.ProcessSpecTask.js")"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            app.GeneralProcessSpecTask.Init();
        });
    </script>
}
