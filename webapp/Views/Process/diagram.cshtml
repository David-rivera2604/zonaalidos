<body>
    <div class="btn-toolbar mb-3" role="toolbar" aria-label="Toolbar with button groups">
        <div class="btn-group mr-2" role="group" aria-label="First group">
            <button type="button" class="btn btn-secondary">sequence</button>
            <button type="button" class="btn btn-secondary">flowchart</button>
            <button type="button" class="btn btn-secondary">statediagram</button>
        </div>
    </div>

    <div id="chart" class="xmermaid someClass">
    </div>

    <script src="https://cdn.jsdelivr.net/npm/mermaid/dist/mermaid.min.js"></script>
    <script src="https://d3js.org/d3.v6.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            //mermaid.init({
            //    startOnLoad: true,
            //    noteMargin: 10
            //});
            mermaid.initialize({ startOnLoad: false });

            let _id = app.core.URLNumericValue('id');
            let _type = app.core.URLStringValue('type');

            function adjustDivHeight() {
                element = document.querySelector('#chart');
                element.style.width = document.documentElement.clientWidth + 'px';
                element.style.height = document.documentElement.clientHeight + 'px';
            }


            // Ajustar la altura del div cuando cambie el tamaño de la ventana
            window.onresize = adjustDivHeight;

            // Example of using the render function
            const drawDiagram = async function (graphDefinition) {



                adjustDivHeight();

                const { svg } = await mermaid.render('graphDiv', graphDefinition);
                element.innerHTML = svg;


                var svgs = d3.selectAll(".someClass svg");
                svgs.each(function () {
                    var svg = d3.select(this);
                    svg.html("<g>" + svg.html() + "</g>");
                    var inner = svg.select("g");
                    var zoom = d3.zoom().on("zoom", function (event) {
                        inner.attr("transform", event.transform);
                    });
                    svg.call(zoom);

                    svg.call(zoom.transform, d3.zoomIdentity.scale(1).translate(0, 0));

                });
            };



            app.core.Get(app.setting.apipath + `v1/ProcessSpecFlow/${_id}/diagram/${_type}`)
                .done(function (data, textStatus, jqXHR) {




                    // Example of using the render function






                    let x = '\n' + data.source.replaceAll('\r', '');
                    //$('.someClass').text('\n'+x);
                    drawDiagram(x);

                    //mermaid.init({ noteMargin: 10 }, ".someClass");

                    //var svgs = d3.selectAll(".someClass svg");
                    //svgs.each(function () {
                    //    var svg = d3.select(this);
                    //    svg.html("<g>" + svg.html() + "</g>");
                    //    var inner = svg.select("g");
                    //    var zoom = d3.zoom().on("zoom", function (event) {
                    //        inner.attr("transform", event.transform);
                    //    });
                    //    svg.call(zoom);

                    //    svg.call(zoom.transform, d3.zoomIdentity.scale(4).translate(-10, -150));

                    //});

                }).always(function () {

                });


            $('.btn').click(function (e) {
                window.location.replace(`Diagram?id=${_id}&type=${e.currentTarget.innerText}`);
                e.stopPropagation();
            });

        });
    </script>


</body>
</html>