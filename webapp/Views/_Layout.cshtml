    <!-- Handler for local scripts -->
    @RenderSection("scripts", required: false)

    <script>
        const trigger = document.getElementById("trigger")

        trigger.addEventListener('click', () => {
            trigger.classList.toggle('active');
        });
    </script>

    <script src='@Url.Content("~/Scripts/jquery.signalR-2.4.3.min.js")'></script>
    <script src='@Url.Content("~/signalr/hubs")'></script>
    <script src='@Url.Content("~/Scripts/notifications.service.js")'></script>
    <script>
        $(function() {
            function getTokenPayload() {
                try {
                    var token = localStorage.getItem("Token");
                    if (!token) return null;
                    var base64 = token.split(".")[1].replace(/-/g, "+").replace(/_/g, "/");
                    return JSON.parse(atob(base64));
                } catch(e) { return null; }
            }
            var payload   = getTokenPayload();
            var userId    = payload ? parseInt(payload.UserId    || payload.userId    || 0, 10) : 0;
            var companyId = payload ? parseInt(payload.CompanyId || payload.companyId || 0, 10) : 0;
            if (userId > 0) { Aliados.Notifications.init(userId, companyId); }
            // Toggle manual del panel de notificaciones (sin hover)
            $(document).on('click', '#notifToggle', function(e) {
                e.preventDefault(); e.stopPropagation();
                var p = $('#notifPanel');
                if (p.is(':visible')) { p.hide(); } else { p.show(); Aliados.Notifications.reload(); }
            });
            $(document).on('click', function(e) {
                if (!$(e.target).closest('#notificationDropdown').length) { $('#notifPanel').hide(); }
            });
        });
    </script>
    <script src="@Url.Content("~/Scripts/LayoutView.js")"></script> 
