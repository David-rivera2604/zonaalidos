<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <title>Zona de Aliados</title>

    @Styles.Render("~/Content/cssMaster")
    @Scripts.Render("~/bundles/jsMaster")

    <script src="@Url.Content("~/assets/js/plugins/jqueryformatter/jquery.formatter.js")"></script>
    <script src="@Url.Content("~/assets/sparkline/jquery.sparkline.min.js")"></script>


    <!-- Google Tag Manager -->
    <script>
        (function (w, d, s, l, i) {
            w[l] = w[l] || []; w[l].push({
                'gtm.start':
                    new Date().getTime(), event: 'gtm.js'
            }); var f = d.getElementsByTagName(s)[0],
                j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : ''; j.async = true; j.src =
                    'https://www.googletagmanager.com/gtm.js?id=' + i + dl; f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', 'GTM-NL4F2ZN');</script>
    <!-- End Google Tag Manager -->

</head>

<body class="fixed-sidebar fixed-nav fixed-nav-basic Mapfre @ViewBag.theme">

    <!-- Google Tag Manager (noscript) -->
    <noscript>
        <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NL4F2ZN"
                height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->

    <div id="wrapper">
        <div id="page-wrapper" class="bg-white">

            <div class="head_prin">
                <div id="imgHead" class="imgHeadMapfre">
                    @* Este es el logo fijo de la app (MAPFRE). No depende de la
                        cuenta ni de GetColor/master.js: es siempre el mismo para
                        todos. El logo por cuenta va aparte, junto al menú de
                        usuario/logout (ver #logotenantHead más abajo). *@
                    <div class="circulo mf-brand">
                        <img alt="MAPFRE" src="~/images/Mapfre-logo.png">
                    </div>
                    <span class="mf-brand-name">Zona de Aliados</span>
                </div>
                <input type="checkbox" id="ham-menu">
                <label for="ham-menu" class="ham-icon">
                    <div class="trigger" id="trigger">
                        <span></span>
                    </div>
                </label>
                <div class="ham-menu">
                    @*<div id="imgSide" class="imgHeadMapfre">
                            <img src="../app/img/logohorizontal.jpg" style="width: 190px;height: auto;margin-top: 12px;" alt="logoMAPFRE">
                            <a href="#" class="quest_mob" id="showHelp" title="Despliega la ayuda de la aplicación" style="
                            position: absolute;
                            right: 25px;
                            top:10px;">
                                <i class="fa fa-question"></i>
                            </a>
                        </div>*@
                    <div class="items_ham_menu" id="MenuVertical">
                    </div>
                </div>
                <div class="head_line">
                    <div class="hList headinamci" id="side-menu" role="navigation" style="margin-bottom: 0">
                    </div>
                    <div class="min_menu" style="display:none" id="moremenubox">
                        <input type="checkbox" id="more_menu">
                        <label for="more_menu" class="more">
                            <div class="menuicon">
                                <span></span>
                            </div>
                        </label>
                        <div id="container_moremenu">

                        </div>
                    </div>
                    <div class="aliados">
                        <div class="usua_head">
                            <span class="block m-t-xs" id="UserNameMaster"></span>
                            <ul class="hList">
                                <nav class="megamenu_desktop">
                                    <div class="menu dropdown">
                                        <input type="checkbox" id="Aliados" class="inputche d-none">
                                        <label class="level_1__item level_2__small" for="Aliados"> <a class="level_1__link  dropdown-toggle" title=""> <span><span id="TenantMaster">menu</span></span> <i class="fa fa-angle-up mf-caret"></i></a></label>
                                        <ul class="menu-dropdown" aria-expanded="false">
                                            <li>
                                                <a id="UserMenuLogoutLink" href="#" onclick="app.security().logout();  return false;" title="Permite terminar la sesión del usuario">
                                                    <i class="fa fa-sign-out"></i> <span id="UserMenuLogoutText" class="d-sm-inline">Desconectar </span>
                                                </a>
                                            </li>
                                            <li style="display: flex;align-items: center;"><a id="UserMenuChangePasswordLink" href="~/Security/ChangePassword" style="padding-top: 10px;" title="Permite el cambio de la clave de acceso del usuario conectado"><span id="UserMenuChangePasswordText">Cambio de clave de acceso</span></a></li>
                                            <li class="language-selector-menu-item" style="height:auto; min-height:50px; padding-top:6px; padding-bottom:6px;">
                                                <div class="language-selector-menu" style="display:flex; flex-direction:column; gap:5px; min-width:150px;">
                                                    <span id="LanguageMenuLabel" class="language-selector-menu__label" style="font-size:11px; font-weight:700; color:inherit; text-transform:uppercase;">Idioma</span>
                                                    <div class="language-selector-menu__actions">
                                                        <button type="button" id="LanguageOptionSpanish" class="language-selector-menu__button" onclick="app.master.SetLanguage('es'); return false;">Español</button>
                                                        <button type="button" id="LanguageOptionEnglish" class="language-selector-menu__button" onclick="app.master.SetLanguage('en'); return false;">English</button>
                                                    </div>
                                                </div>
                                            </li>
                                        </ul>
                                    </div>
                                </nav>
                                @*<nav id="megamenu" class="megamenu megamenu_desktop">
                                        <div href="#click" class="menu dropdown">
                                            <ul id="megamenu_level__1" class="level_1 sf-js-enabled sf-arrows">
                                                <li class="level_1__item level_2__small" style="display: inline-block;">
                                                    <a data-toggle="dropdown" class="level_1__link sf-with-ul " href="#">
                                                        <span class="block dropdown-toggle"><span id="TenantMaster">menu</span></span>
                                                    </a>
                                                </li>
                                            </ul>
                                            <ul class="menu-dropdown">
                                                <li>
                                                    <a href="~/Security/Login" title="Permite terminar la sesión del usuario">
                                                        <i class="fa fa-sign-out"></i> <span class="d-sm-inline">Desconectar </span>
                                                    </a>
                                                </li>
                                                <li><a class="dropdown-item" href="~/Security/ChangePassword" title="Permite el cambio de la clave de acceso del usuario conectado">Cambio de clave de acceso</a></li>
                                            </ul>
                                        </div>
                                    </nav>*@
                            </ul>

                        </div>

                        @* Logo de la cuenta conectada, junto al menú de usuario/
                            logout. master.js reemplaza el contenido de
                            #logotenantHead con el logo que devuelva
                            v1/Colors/GetColor; el id #tenantLogo debe existir al
                            cargar porque app.master.Init lo usa como condición. *@
                        <div class="circulo">
                            <div class="dropdown profile-element" id="logotenantHead">
                                <img alt="Logo del aliado" src="~/logos/logo-aliados-alt.svg" id="tenantLogo">
                            </div>
                        </div>

                        <a href="#" class="quest_mob" id="showHelp" title="Despliega la ayuda de la aplicación" style="
						position: absolute;
						right: 25px;
						top:10px;">
                            <i class="fa fa-question"></i>
                        </a>
                    </div>

                </div>
            </div>

            <div class="wrapper wrapper-content animated fadeInRight">
                <div class="row">
                    <div class="col-lg-12">
                        @RenderBody()
                    </div>
                </div>
            </div>

            <div class="footer">
                <div>
                    <strong title="1.6.7">
                        &copy;
                    </strong> 2023 MAPFRE. <span id="FooterRightsReservedText">Todos los derechos reservados.</span>
                </div>
            </div>
            <div id="right-sidebar" class="animated slideInRight ">
                <div class="sidebar-container">
                    <div class="ibox">
                        <div class="ibox-title sidebar-title">
                            <div id="sidebarTitle">
                            </div>
                            <div class="ibox-tools">
                                <a class="close-link-sidebar" href="">
                                    <i class="fa fa-times-circle"></i>
                                </a>
                            </div>
                        </div>
                        <div class="ibox-content sidebar-content">
                            <div class="sk-spinner sk-spinner-wave">
                                <div class="sk-rect1"></div>
                                <div class="sk-rect2"></div>
                                <div class="sk-rect3"></div>
                                <div class="sk-rect4"></div>
                                <div class="sk-rect5"></div>
                            </div>
                            <div class="sidebarContent"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- @Scripts.Render("~/bundles/jsMaster") -->
    <!-- Handler for local scripts -->
    @RenderSection("scripts", required: false)

    <script>
        const trigger = document.getElementById("trigger")

        trigger.addEventListener('click', () => {
            trigger.classList.toggle('active');
        });
    </script>

    <script src="@Url.Content("~/Scripts/LayoutView.js")"></script>
</body>

</html>
