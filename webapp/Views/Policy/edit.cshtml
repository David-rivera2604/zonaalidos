                                <div class="form-row">

                                    <!-- Sequence -->
                                    <input id='Sequence' name='Sequence' type='hidden' value=''>

                                    <!-- Province -->
                                    <div class='col-sm-2 col-md-2'>
                                        <div class='form-group'>
                                            <label class='control-label'
                                                   for='Province'>
                                                Provincia<span class='required-mark'
                                                               title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                            </label>
                                            <select id='Province' name='Province'
                                                    class='form-control'></select>
                                        </div>
                                    </div>
                                    <!-- Canton -->
                                    <div class='col-sm-2 col-md-2'>
                                        <div class='form-group'>
                                            <label class='control-label'
                                                   for='Canton'>
                                                Cantón<span class='required-mark'
                                                            title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                            </label>
                                            <select id='Canton' name='Canton'
