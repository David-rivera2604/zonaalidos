@{
    Layout = "~/Views/_Layout.cshtml";
}
@Styles.Render("~/Content/cssPolicyEdit")

<!-- Cotizador -->
<div class="ibox">
    <div class="ibox-title">
        <h5><span id="ProductTitle"></span><small class="m-l-sm"><span id="ProductSubTitle"></span></small> <span id="PolicyStatus" class="label d-none"></span></h5>
        <div class="ibox-tools">
            @*<a href="#" class="btn btn-white btn-xs float-right">Aceptar</a>*@
            @*<div data-toggle="buttons" class="btn-group btn-group-toggle">
            <label class="btn btn-sm btn-white active"> <input type="radio" id="option1" name="options"> Day </label>
            <label class="btn btn-sm btn-white"> <input type="radio" id="option2" name="options"> Week </label>
            <label class="btn btn-sm btn-white"> <input type="radio" id="option3" name="options"> Month </label>
        </div>

        <button type="button" class="btn btn-sm btn-white"> <i class="fa fa-comments"></i> </button>
        <button type="button" class="btn btn-sm btn-white"> <i class="fa fa-user"></i> </button>
        <button type="button" class="btn btn-sm btn-white"> <i class="fa fa-list"></i> </button>
        <button type="button" class="btn btn-sm btn-white"> <i class="fa fa-cogs"></i> </button>
            //<button id="save" type="button" class="btn btn-sm btn-white d-none"> <i class="fa fa-pencil"></i> </button>
            <button id="print" type="button" class="btn btn-sm btn-white d-none"> <i class="fa fa-print"></i> </button>
            *@
            <a id="applyChange" href="" class="btn btn-primary btn-xs d-none" title="Permite guardar los cambios de la póliza">Aplicar cambios</a>
            <a id="print" href="" class="btn btn-primary btn-xs d-none" title="Permite imprimir la póliza">Imprimir</a>
            <a id="save" href="" class="btn btn-primary btn-xs d-none" title="Permite guardar un borrador de la póliza">Guardar</a>
            <a id="accept" href="" class="btn btn-primary btn-xs d-none" title="Permite emitir la póliza">Emitir</a>
            <a id="AcceptComplement" href="" class="btn btn-warning btn-xs d-none" style="color:white!important" title="Indica que los complementos solicitados ya fueron incluidos"><i class="fa fa-files-o"></i> Complementos incluidos</a>
            <a class="collapse-link">
                <i class="fa fa-chevron-up"></i>
            </a>
            <a class="fullscreen-link">
                <i class="fa fa-expand"></i>
            </a>
        </div>
    </div>
    <div class="ibox-content">
        <div id="generalNotify">
        </div>

        <!-- Cabecera de las pestañas -->
        <ul class="nav nav-tabs">
            <li>
                <a class="nav-link active show" data-toggle="tab" href="#aseguradoTab" id="aseguradoHTab">
                    <i class="fa fa-user-o"></i> Asegurado <span id="PrimaryInsuredFullName"></span> <span class="badge badge-danger"></span>
                </a>
            </li>
            <li id="saludTabHeader" class="d-none">
                <a class="nav-link" data-toggle="tab" href="#cuestionarioTab" id="cuestionarioHTab">
                    <i class="fa fa-list-ol"></i> Cuestionario de Salud<span class="badge badge-danger"></span>
                </a>
            </li>
            <li id="covidTabHeader" class="d-none">
                <a class="nav-link" data-toggle="tab" href="#cuestionarioCovidTab" id="cuestionarioCovidHTab">
                    <i class="fa fa-list-ol"></i> Cuestionario Covid<span class="badge badge-danger"></span>
                </a>
            </li>
            <li id="beneficiariosHTabHeader" class="d-none">
                <a class="nav-link" data-toggle="tab" href="#beneficiariosTab" id="beneficiariosHTab">
                    <i class="fa fa-handshake-o"></i> Beneficiarios <span class="badge badge-danger"></span>
                </a>
            </li>
            <li id="prestamosHTabHeader" class="d-none">
                <a class="nav-link" data-toggle="tab" href="#prestamosTab" id="prestamosHTab">
                    <i class="fa fa-credit-card"></i> Prestamos <span class="badge badge-danger"></span>
                </a>
            </li>
            <li>
                <a class="nav-link" data-toggle="tab" href="#polizaTab" id="polizaHTab">
                    <i class="fa fa-th"></i> Póliza <span id="PolicyPolicyId"></span> <span class="badge badge-danger"></span>
                </a>
            </li>

            <li>
                <a class="nav-link" data-toggle="tab" href="#adjuntosTab" id="adjuntosHTab">
                    <i class="fa fa-file-o"></i>
                    Adjuntos <span class="badge badge-danger"></span>
                </a>
            </li>
            <li id="historialTabHeader" class="d-none">
                <a class="nav-link" data-toggle="tab" href="#historialTab">
                    <i class="fa fa-clock-o"></i> Historial
                </a>
            </li>
        </ul>

        <!-- Contenido de las pestañas  -->
        <div class="tab-content" style="padding-top: 10px">

            <!-- Asegurado -->
            @Html.Partial("_asegurado")

            <!-- Beneficiarios -->
            <div id="beneficiariosTab" class="tab-pane">
                <div id="beneficiaryNotify">
                </div>
                <table id="beneficiarios" class="footable table table-stripped toggle-arrow-tiny d-none"
                       data-sorting="true" data-page-size="15"
                       data-paging-container="#beneficiarios-paging">
                    <thead>
                        <tr>
                            <th data-toggle="true">Nombre</th>
                            <th>%Participación</th>
                            <th>Parentesco</th>
                            <th>Estado</th>
                            <th data-breakpoints="xs">Fecha de alta</th>
                            <th data-breakpoints="xs">Fecha de baja</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td>
                                <a id="NewBeneficiary" href="" class="btn btn-primary btn-xs">Nuevo</a>
                            </td>
                            <td colspan="5">
                                <div id="beneficiarios-paging" class="float-right"></div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
                <div id="beneficiariosEdt" class="animated fadeInRight">
                    @*<h4>Información del beneficiario</h4>
                <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>*@
                    <form id='beneficiaryEdtFrm' class='form-horizontal' data-toggle='validator'>
                        <fieldset disabled>

                            <!-- Datos generales -->
                            <div class="form-row">
                                <input id='BRoleId' name='Id' type='hidden' value=''>
                                <!-- BDocumentNumber -->
                                <div class='col-sm-4 col-md-3'>
                                    <div class='form-group'>
                                        <label class='control-label' for='BDocumentNumber'>
                                            Identificación<span class='required-mark'
                                                                title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                        </label>
                                        <div class='input-group'>
                                            <span class='input-group-addon'>
                                                <span class='glyphicon glyphicon-barcode'></span>
                                            </span>

                                            <div class="input-group-prepend">
                                                <button class="btn btn-default dropdown-toggle"
                                                        type="button" data-toggle="dropdown"
                                                        aria-haspopup="true" aria-expanded="false" data-value='1' id='BDocumentType'>
                                                    Cédula
                                                </button>
                                                <div class="dropdown-menu" id="BDocumentTypeMenu">
                                                    <a class="dropdown-item active" href="#" data-value='1'>Cédula</a>
                                                    <a class="dropdown-item" href="#" data-value='2'>DIMEX</a>
                                                    <a class="dropdown-item" href="#" data-value='3'>Pasaporte</a>
                                                    <a class="dropdown-item" href="#" data-value='4'>Cédula jurídica</a>
                                                </div>
                                            </div>

                                            <input id='BDocumentNumber' name='BDocumentNumber'
                                                   type='text' class='form-control' size='20'
                                                   maxlength='20' placeholder="0X-XXXX-XXXX">

                                        </div>
                                        <div id='BDocumentNumber_validate'></div>
                                    </div>
                                </div>
                                <!-- BFirstName -->
                                <div class='col-sm-4 col-md-3'>
                                    <div class='form-group'>
                                        <label class='control-label' for='BFirstName'>
                                            Nombres<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                        </label>
                                        <div class='input-group'>
                                            <span class='input-group-addon'>
                                                <span class='glyphicon glyphicon-user'></span>
                                            </span>
                                            <input id='BFirstName' name='BFirstName' type='text'
                                                   class='form-control' size='40' maxlength='40'>
                                            <input id='BMiddleName' name='BMiddleName' type='text'
                                                   class='form-control' size='40' maxlength='40'>
                                        </div>
                                        <div id='BFirstName_validate'></div>
                                    </div>
                                </div>
                                <!-- BLastName -->
                                <div class='col-sm-4 col-md-3'>
                                    <div class='form-group'>
                                        <label class='control-label' for='BLastName'>
                                            Apellidos<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                        </label>
                                        <div class='input-group'>
                                            <span class='input-group-addon'>
                                                <span class='glyphicon glyphicon-user'></span>
                                            </span>
                                            <input id='BLastName' name='BLastName' type='text'
                                                   class='form-control' size='40' maxlength='40'>
                                            <input id='BSecondLastName' name='BSecondLastName'
                                                   type='text' class='form-control' size='40'
                                                   maxlength='40'>
                                        </div>
                                        <div id='BLastName_validate'></div>
                                    </div>
                                </div>
                                <!-- BBirthDate -->
                                <div class='col-sm-4 col-md-3'>
                                    <div class='form-group'>
                                        <label class='control-label' for='BBirthDate'>
                                            Fecha de
                                            nacimiento<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                        </label>
                                        <div class='input-group date' id='BBirthDate_group'>
                                            <input id='BBirthDate' name='BBirthDate' type='text'
                                                   class='form-control' size='10' maxlength='10'
                                                   placeholder='día/mes/año'>
                                            <span class='input-group-addon'>
                                                <span class='glyphicon glyphicon-calendar'></span>
                                            </span>
                                        </div>
                                        <div id='BBirthDate_validate'></div>

                                    </div>
                                </div>
                                <!-- BGender -->
                                <div class='col-sm-4 col-md-3'>
                                    <div class='form-group'>
                                        <label class='control-label' for='BGender'>
                                            Sexo
                                        </label>
                                        <select id='BGender' name='BGender'
                                                class='form-control'></select>
                                        <div id='BGender_validate'></div>
                                    </div>
                                </div>
                                <!-- BCivilStatus -->
                                <div class='col-sm-4 col-md-3'>
                                    <div class='form-group'>
                                        <label class='control-label' for='BCivilStatus'>
                                            Estado civil
                                        </label>
                                        <select id='BCivilStatus' name='BCivilStatus'
                                                class='form-control'></select>
                                    </div>
                                </div>

                                <!-- BPhoneNumber -->
                                <div class='col-sm-4 col-md-3'>
                                    <div class='form-group'>
                                        <label class='control-label'
                                               for='BPhoneNumber'>Teléfono<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                        <div class='input-group'>

                                            <span class='input-group-addon'>
                                                <span class='glyphicon glyphicon-earphone'></span>
                                            </span>

                                            <div class="input-group-prepend">
                                                <button class="btn btn-default dropdown-toggle"
                                                        type="button" data-toggle="dropdown"
                                                        aria-haspopup="true" aria-expanded="false" id="BPhoneType" data-value='1'>
                                                    Celular
                                                </button>
                                                <div class="dropdown-menu" id="BPhoneTypeMenu">
                                                    <a class="dropdown-item active" data-value='1'
                                                       href="#">Celular</a>
                                                    <a class="dropdown-item" data-value='2' href="#">Habitación</a>
                                                    <a class="dropdown-item" data-value='3' href="#">Oficina</a>
                                                    <a class="dropdown-item" data-value='4' href="#">Fax</a>
                                                </div>
                                            </div>

                                            <input id='BPhoneNumber' name='BPhoneNumber' type='text'
                                                   class='form-control' size='9' maxlength='9'>

                                        </div>
                                        <div id='BPhoneNumber_validate'></div>
                                    </div>
                                </div>
                                <!-- BPrimaryEmailAddress -->
                                <div class='col-sm-4 col-md-3'>
                                    <div class='form-group'>
                                        <label class='control-label' for='BPrimaryEmailAddress'>
                                            Correo
                                            electrónico<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                        </label>
                                        <div class='input-group'>
                                            <span class='input-group-addon'>
                                                <span class='glyphicon glyphicon-envelope'></span>
                                            </span>
                                            <input id='BPrimaryEmailAddress'
                                                   name='BPrimaryEmailAddress' type='text'
                                                   class='form-control' size='80' maxlength='80'>
                                        </div>
                                        <div id='BPrimaryEmailAddress_validate'></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Dirección -->
                            <div class="form-row">


                                <div class="col-lg-12">

                                    <h4><i class="fa fa-map-marker"></i> Dirección</h4>
                                    <div class="hr-line-dashed"
                                         style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>

                                    <div class="form-row">

                                        <!-- BSequence -->
                                        <input id='BSequence' name='BSequence' type='hidden' value=''>

                                        <!-- BProvince -->
                                        <div class='col-sm-2 col-md-2'>
                                            <div class='form-group'>
                                                <label class='control-label'
                                                       for='BProvince'>Provincia</label>
                                                <select id='BProvince' name='BProvince'
                                                        class='form-control'></select>
                                            </div>
                                        </div>
                                        <!-- BCanton -->
                                        <div class='col-sm-2 col-md-2'>
                                            <div class='form-group'>
                                                <label class='control-label'
                                                       for='BCanton'>Cantón</label>
                                                <select id='BCanton' name='BCanton'
                                                        class='form-control'></select>
                                            </div>
                                        </div>
                                        <!-- BDistrict -->
                                        <div class='col-sm-2 col-md-2'>
                                            <div class='form-group'>
                                                <label class='control-label'
                                                       for='BDistrict'>Distrito</label>
                                                <select id='BDistrict' name='BDistrict'
                                                        class='form-control'></select>
                                            </div>
                                        </div>

                                        <!-- BAddressDetail -->
                                        <div class='col-sm-6 col-md-6'>
                                            <div class='form-group'>
                                                <label class='control-label'
                                                       for='BAddressDetail'>Dirección</label>
                                                <input id='BAddressDetail' name='BAddressDetail'
                                                       type='text' class='form-control' size='120'
                                                       maxlength='120'>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <!-- Otros datos -->
                            <div class="form-row">
                                <div class="col-lg-12">

                                    <h4>Otros datos</h4>
                                    <div class="hr-line-dashed"
                                         style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>

                                    <div class="form-row">
                                        <!-- BRelationship -->
                                        <div class='col-sm-4 col-md-2'>
                                            <div class='form-group'>
                                                <label class='control-label' for='BRelationship'>Parentesco<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                <select id='BRelationship' name='BRelationship' class='form-control'>
                                                </select>
                                            </div>
                                        </div>
                                        <!-- BParticipationRate -->
                                        <div class='col-sm-4 col-md-2'>
                                            <div class='form-group'>
                                                <label class='control-label' for='BParticipationRate'>Participación<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                <div class='input-group'>
                                                    <input id='BParticipationRate' name='BParticipationRate' type='text' class='form-control text-right' size='3' maxlength='3'>
                                                    <span class='input-group-addon'>
                                                        <small class="text-muted" title="Porcentaje">%</small>
                                                    </span>
                                                </div>
                                                <div id='BParticipationRate_validate'></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-row">
                                <div class='col-md-12'>
                                    <a id="AddBeneficiary" href="" class="btn btn-primary btn-xs">Agregar</a>
                                    <a id="DeleteBeneficiary" href="" class="btn btn-danger btn-xs d-none">Eliminar</a>
                                    <a id="CancelBeneficiary" href="" class="btn btn-primary btn-xs">Cancelar</a>
                                </div>
                            </div>
                        </fieldset>
                    </form>
                </div>
            </div>

            <!-- Cuestionario de Salud -->
            <div id="cuestionarioTab" class="tab-pane fade">
                <form id='QuestionaryEdtFrm'>
                    <fieldset>
                        <div class="form-row">
                            <!-- Pregunta_1 - 1 - ¿Cualquier desorden neurológico, sistema nervioso depresión, ... -->
                            <div class='col-md-6'>
                                <div class="form-row">
                                    <div class='col-md-12'>
                                        <div class='form-group'>
                                            <label class='control-label' for='Confirmation_1'>1. ¿Cualquier desorden neurológico, sistema nervioso depresión, ansiedad, epilepsia y otros, sistema respiratorio, gastrointestinal, endocrinólogos o genito-urinario, diabetes, hipertensión, angina de pecho, colesterol o triglicéridos altos, trastornos de las arterias coronarias, problemas cardíacos o del sistema cardiovascular o los vasos sanguíneos, desorden de la sangre, transfusión de sangre problemas con la columna vertebral y/o los discos intervertebrales?</label>
                                            <br /><div class="custom-control custom-radio custom-control-inline">
                                                <input type="radio" class="custom-control-input" id="Confirmation_1a" name="Confirmation_1" value="1">
                                                <label class="custom-control-label" for="Confirmation_1a">Si</label>
                                            </div>
                                            <div class="custom-control custom-radio custom-control-inline">
                                                <input type="radio" class="custom-control-input" id="Confirmation_1b" name="Confirmation_1" value="2">
                                                <label class="custom-control-label" for="Confirmation_1b">No</label>
                                            </div>
                                            <div id='Confirmation_1_validate'></div>
                                        </div>
                                    </div>
                                </div>
                                <div id="question_1" class="form-row d-none">
                                    <!-- Diagnosis 1 -->
                                    <div class='col-md-12'>
                                        <div class='form-group'>
                                            <label class='control-label' for='Diagnosis_1'>Diagnóstico<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                            <input id='Diagnosis_1' name='Diagnosis_1' type='text' class='form-control' size='200' maxlength='200' disabled>
                                        </div>
                                    </div>
                                    <!-- Treatment 1 -->
                                    <div class='col-md-12'>
                                        <div class='form-group'>
                                            <label class='control-label' for='Treatment_1'>Tratamiento<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                            <input id='Treatment_1' name='Treatment_1' type='text' class='form-control' size='200' maxlength='200' disabled>
                                        </div>
                                    </div>
                                    <!-- Doctor 1 -->
                                    <div class='col-md-6'>
                                        <div class='form-group'>
                                            <label class='control-label' for='Doctor_1'>Médico<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                            <input id='Doctor_1' name='Doctor_1' type='text' class='form-control' size='120' maxlength='120' disabled>
                                        </div>
                                    </div>
                                    <!-- When 1 -->
                                    <div class='col-md-6'>
                                        <div class='form-group'>
                                            <label class='control-label' for='When_1'>Fecha<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                            <div class='input-group date' id='When_1_group'>
                                                <input id='When_1' name='When_1' type='text' class='form-control' size='10' maxlength='10' placeholder='día/mes/año' disabled>
                                                <span class='input-group-addon'><span class='glyphicon glyphicon-calendar'></span></span>
                                            </div>
                                            <div id='When_1_validate'></div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Pregunta_3 - 2 - ¿Cualquier tipo de quiste, tumores o cáncer? -->
                            <div class='col-md-6'>
                                <div class="form-row">
                                    <div class='col-md-12'>
                                        <div class='form-group'>
                                            <label class='control-label' for='Confirmation_3'>2. ¿Cualquier tipo de quiste, tumores o cáncer?</label>
                                            <br /><div class="custom-control custom-radio custom-control-inline">
                                                <input type="radio" class="custom-control-input" id="Confirmation_3a" name="Confirmation_3" value="1">
                                                <label class="custom-control-label" for="Confirmation_3a">Si</label>
                                            </div>
                                            <div class="custom-control custom-radio custom-control-inline">
                                                <input type="radio" class="custom-control-input" id="Confirmation_3b" name="Confirmation_3" value="2">
                                                <label class="custom-control-label" for="Confirmation_3b">No</label>
                                            </div>
                                            <div id='Confirmation_3_validate'></div>
                                        </div>
                                    </div>
                                </div>
                                <div id="question_3" class="form-row d-none">
                                    <!-- Diagnosis_3 -->
                                    <div class='col-md-12'>
                                        <div class='form-group'>
                                            <label class='control-label' for='Diagnosis_3'>Diagnóstico<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                            <input id='Diagnosis_3' name='Diagnosis_3' type='text' class='form-control' size='200' maxlength='200' disabled>
                                        </div>
                                    </div>
                                    <!-- Treatment_3 -->
                                    <div class='col-md-12'>
                                        <div class='form-group'>
                                            <label class='control-label' for='Treatment_3'>Tratamiento<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                            <input id='Treatment_3' name='Treatment_3' type='text' class='form-control' size='200' maxlength='200' disabled>
                                        </div>
                                    </div>
                                    <!-- Doctor_3 -->
                                    <div class='col-md-6'>
                                        <div class='form-group'>
                                            <label class='control-label' for='Doctor_3'>Médico<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                            <input id='Doctor_3' name='Doctor_3' type='text' class='form-control' size='120' maxlength='120' disabled>
                                        </div>
                                    </div>
                                    <!-- When_3 -->
                                    <div class='col-md-6'>
                                        <div class='form-group'>
                                            <label class='control-label' for='When_3'>Fecha<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                            <div class='input-group date' id='When_3_group'>
                                                <input id='When_3' name='When_3' type='text' class='form-control' size='10' maxlength='10' placeholder='día/mes/año' disabled>
                                                <span class='input-group-addon'><span class='glyphicon glyphicon-calendar'></span></span>
                                            </div>
                                            <div id='When_3_validate'></div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Pregunta_8 - 3 - ¿Síndrome de Inmuno Deficiencia Adquirida o relacionado con el SIDA? -->
                            <div class='col-md-6'>
                                <div class="form-row">
                                    <div class='col-md-12'>
