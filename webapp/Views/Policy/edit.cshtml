                                </div>

                            </div>

                        </div>

                    </fieldset>
                </form>
            </div>

            <!-- Adjuntos -->
            <div id="adjuntosTab" class="tab-pane">
                <table id="adjuntos" class="footable table table-stripped toggle-arrow-tiny d-none"
                       data-sorting="true" data-page-size="15"
                       data-paging-container="#paging-ui-container">
                    <thead>
                        <tr>
                            <th data-toggle="true">Tipo</th>
                            <th>Descripción</th>
                            <th>Archivo</th>
                            <th>Tamaño</th>
                            <th data-breakpoints="xs" data-title="Realizado por">Usuario</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td>
                                <a id="NewAttachment" href="" class="btn btn-primary btn-xs">Nuevo</a>
                            </td>
                            <td colspan="5">
                                <div id="paging-ui-container" class="float-right"></div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
                <div id="AttachmentsEdt" class="animated fadeInRight">
                    @*<h4>Información del adjunto</h4>
                        <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>*@
                    <form id='AttachmentsEdtForm' class='form-horizontal' data-toggle='validator'>
                        <fieldset>
                            <div class="form-row">
                                <!-- Id -->
                                <input id='AttachmentsId' name='AttachmentsId' type='hidden' value=''>
                                <!-- Description -->
                                <div class='col-sm-8 col-md-12'>
                                    <div class='form-group'>
                                        <label class='control-label' for='Description'>Descripción<span class='required-mark'>*</span></label>
                                        <input id='Description' name='Description' type='text' class='form-control' size='120' maxlength='120'>
                                    </div>
                                </div>
                                <!-- DocumentType -->
                                <div class='col-sm-4 col-md-3'>
                                    <div class='form-group'>
                                        <label class='control-label' for='AttachmentType'>Tipo de documento<span class='required-mark'>*</span></label>
                                        <select id='AttachmentType' name='AttachmentType' class='form-control'>
                                        </select>
                                    </div>
                                </div>
                                <!-- FileName -->
                                <div class='col-sm-4 col-md-9'>
                                    <div class='form-group'>
                                        <label class='control-label' for='FileName'>Archivo<span class='required-mark'>*</span></label>
                                        <div class="input-group">
                                            <input id='FileName' name='FileName' type='text' class='form-control' size='80' maxlength='80' placeholder="Indique el archivo a procesar..." readonly>
                                            <input id="Stored" type="hidden" value="" />
                                            <input id="FileSize" type="hidden" value="" />
                                            <div class="input-group-append">
                                                <span class="btn btn-default fileinput-button" title="Permite seleccionar el archivo a ser procesado">
                                                    <span>Examinar...</span>
                                                    <input id="fileUpload" type="file" />
                                                </span>
                                            </div>
                                        </div>
                                        <div id='FileName_validate'></div>
                                    </div>
                                </div>
                                <div class='col-md-12'>
                                    <a id="AddAttachment" href="" class="btn btn-primary btn-xs">Agregar</a>
                                    <a id="CancelAttachment" href="" class="btn btn-primary btn-xs">Cancelar</a>
                                </div>
                            </div>
                        </fieldset>
                    </form>
                </div>
            </div>

            <!-- Historial -->
            <div id="historialTab" class="tab-pane ">
                <table id="Historial" class="footable table table-stripped toggle-arrow-tiny"
                       data-sorting="true" data-page-size="15"
                       data-paging-container="#paging-ui-container">
                    <thead>
                        <tr>

                            <th data-toggle="true">Cuando</th>
                            <th>Acción</th>
                            <th data-breakpoints="xs" data-title="Realizado por">Usuario</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="6">
                                <div id="paging-ui-container" class="float-right"></div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>

        </div>
    </div>
    <div class="ibox-footer">
        <span id="lastChange" class="text-muted small float-right" title="Último cambio">
        </span>
        <br />
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jsPolicyEdit")
    <script type="text/javascript">
        $(document).ready(function () {
            app.PolicyEdit.Init();
        });
    </script>
}