    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <title>INSPINIA | Main view</title>

    @Styles.Render("~/Content/cssMaster", "~/Content/cssPolicyIndex")
</head>

<body class="fixed-sidebar fixed-nav fixed-nav-basic">

    <div id="wrapper">

        <nav class="navbar-default navbar-static-side " role="navigation">
            <div class="sidebar-collapse">
                <ul class="nav metismenu" id="side-menu">
                    <li class="nav-header">
                        <div class="dropdown profile-element">
                            <a data-toggle="dropdown" class="dropdown-toggle" href="#">
                                <span class="block m-t-xs font-bold" id="UserNameMaster"></span>
                                <span class="text-muted text-xs block"><span id="TenantMaster">menu</span> <b class="caret"></b></span>
                            </a>
                            <ul class="dropdown-menu animated fadeInRight m-t-xs">
                                <li><a class="dropdown-item" href="/proto/Security/Login">Desconectar</a></li>
                            </ul>
                        </div>
                        <div class="logo-element">
                            IN+
                        </div>
                    </li>
                    <li><a href="/proto/Policy/Edit"><i class="fa fa-th-large"></i> <span class="nav-label">Póliza</span></a></li>
                    <li class="active">
                        <a href="/proto/Policy/Index"><i class="fa fa-th-large"></i> <span class="nav-label">Consulta</span></a>
                    </li>
                </ul>

            </div>
        </nav>

        <div id="page-wrapper" class="gray-bg">
            <div class="row border-bottom">
                <nav class="navbar navbar-fixed-top white-bg" role="navigation" style="margin-bottom: 0">
                    <div class="navbar-header">
                        <a class="navbar-minimalize minimalize-styl-2 btn btn-primary " href="#">
                            <i class="fa fa-bars"></i>
                        </a>
                    </div>
                    <ul class="nav navbar-top-links navbar-right">
                        <li>
                            <a href="/proto/Security/Login">
                                <i class="fa fa-sign-out"></i> Desconectar
                            </a>
                        </li>
                    </ul>

                </nav>
            </div>
            <div class="wrapper wrapper-content animated fadeInRight">
                <div class="row">
                    <div class="col-lg-12">
                        <!-- Cotizador -->
                        <div class="ibox">
                            <div class="ibox-title">
                                <h5>Consulta de pólizas</h5>
                                <div class="ibox-tools">
                                    <a class="collapse-filter">
                                        <i class="fa fa-filter"></i>
                                    </a>
                                    <a class="collapse-link">
                                        <i class="fa fa-chevron-up"></i>
                                    </a>
                                    <a class="fullscreen-link">
                                        <i class="fa fa-expand"></i>
                                    </a>

                                </div>
                            </div>
                            <div class="ibox-content ibox-heading" hidden="hidden">
                                <div class="row">
                                    <div class="col-sm-6">
                                        <h4>
                                            <i class="fa fa-user"></i> Nelson Enrique Soler Paz
                                        </h4>
                                        <div class="m-t-xs btn-group">
                                            <a href="tel:8934-8525" class="btn btn-xs btn-white">
                                                <i class="fa fa-phone"></i> 8934-8525
                                            </a>
                                            <a href="mailto:nsoler@grupoinmotion.com" class="btn btn-xs btn-white">
                                                <i class="fa fa-envelope"></i> nsoler@grupoinmotion.com
                                            </a>
                                        </div>
                                    </div>
                                    <div class="col-sm-6 text-right">
                                        <h4>Póliza N° <span class="text-navy">INV-000567F7-00</span></h4>

                                        <span><strong>Inclusión:</strong> 01/09/2019</span><br>
                                        <span class="label label-warning-light float-right">Pendiente</span>
                                    </div>
                                </div>
                            </div>

                            <div class="ibox-content">
                                <form id='PolicyFilterFrm' data-toggle='validator'>
                                    <div class="form-row d-none filter-row">


                                        <div class="form-group col-md-3">
                                            <label class="control-label" for="order_id">Ramo</label>
                                            <input type="text" id="order_id" name="order_id" value="" class="form-control form-control-sm">
                                        </div>
                                        <div class="form-group col-md-3">
                                            <label class="control-label" for="status">Producto</label>
                                            <input type="text" id="status" name="status" value="" class="form-control form-control-sm">
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label class="control-label" for="customer">Póliza</label>
                                                <input type="text" id="customer" name="customer" value="" class="form-control form-control-sm">
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label class="control-label" for="customer">Certificado</label>
                                                <input type="text" id="customer" name="customer" value="" class="form-control form-control-sm">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-row d-none filter-row">
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label class="control-label" for="amount">Identificación</label>
                                                <div class='input-group'>
                                                    <span class='input-group-addon'>
                                                        <span class='glyphicon glyphicon-barcode'></span>
                                                    </span>


                                                    <input type="text" id="amount" name="amount" value="" class="form-control form-control-sm">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="control-label" for="amount">Asegurado</label>
                                                <div class='input-group'>
                                                    <span class='input-group-addon'>
                                                        <span class='glyphicon glyphicon-user'></span>
                                                    </span>

                                                    <input type="text" id="amount" name="amount" value="" class="form-control form-control-sm">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label class="control-label" for="amount">Número de cuenta</label>
                                                <input type="text" id="amount" name="amount" value="" class="form-control form-control-sm">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-row d-none filter-row">
                                        <div class="col-md-12">
                                            <div class="filter-btn">
                                                <button class="btn btn-primary btn-xs" type="button">Filtrar</button>
                                                <button class="btn btn-white btn-xs" type="button">Cancelar</button>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                                <div class='form-row d-none filter-row'>

                                    <div class="form-group col-md-3">
                                        <label class="control-label" for="order_id">Ramo</label>
                                        <select name="status" id="status" class="form-control form-control-sm">
                                            <option value="1" selected="">Enabled</option>
                                            <option value="0">Disabled</option>
                                        </select>
                                    </div>
                                    <div class="form-group col-md-3">
                                        <label class="control-label" for="status">Producto</label>
                                        <select name="status" id="status" class="form-control form-control-sm">
                                            <option value="1" selected="">Enabled</option>
                                            <option value="0">Disabled</option>
                                        </select>
                                    </div>
                                    <div class='form-group col-md-6'>
                                        <label class="control-label" for="status">Identificador usando para el filtro</label>
                                        <div class="input-group">
                                            <input type="text" placeholder="" class="form-control  form-control-sm">
                                            <span class="input-group-append">
                                                <button type="button" class="btn btn btn-primary btn-xs"> <i class="fa fa-search"></i> Filtrar</button>
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class='form-row'>

                                    <div class='col-md-12'>


                                        <div class="table-responsive-sm">
                                            <table id="TABLE10_GridTbl" style="font-size: 11px;"></table>
                                        </div>
                                    </div>
                                </div>


                            </div>
                        </div>




                    </div>
                </div>


            </div>

            <div class="footer">
                <div>
                    <strong>Copyright</strong> Example Company &copy; 2014-2018
                </div>
            </div>

        </div>
    </div>
    @Scripts.Render("~/bundles/jsMaster", "~/bundles/jsPolicyIndex")
