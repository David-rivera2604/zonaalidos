<div id="polizaTab" class="tab-pane fade">
    <form id='RiskEdtFrm' data-toggle='validator'>
        <fieldset>
            <!-- Datos generales de la póliza -->
            <div class="form-row">
                <!-- Id -->
                <input id='Id' name='Id' type='hidden' value=''>
                <!-- Currency -->
                <div class='col-sm-4 col-md-3'>
                    <div class='form-group'>
                        <label class='control-label' for='Currency'>Moneda<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                        <select id='Currency' name='Currency'
                                class='form-control'></select>
                    </div>
                </div>
                <!-- ModuleCode -->
                <div class='col-sm-4 col-md-3'>
                    <div class='form-group'>
                        <label class='control-label' for='ModuleCode'>Plan<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                        <select id='ModuleCode' name='ModuleCode'
                                class='form-control'></select>
                    </div>
                </div>
                <!-- PaymentFrequency -->
                <div class='col-sm-4 col-md-3'>
                    <div class='form-group'>
                        <label class='control-label' for='PaymentFrequency'>
                            Frecuencia de
                            pago<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span>
                        </label>
                        <select id='PaymentFrequency' name='PaymentFrequency'
                                class='form-control'></select>
                    </div>
                </div>
                <!-- IssueDate -->
                <div class='col-sm-4 col-md-3'>
                    <div class='form-group'>
                        <label class='control-label' for='IssueDate'>
                            Fecha de
                            alta<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span>
                        </label>
                        <div class='input-group date' id='IssueDate_group'>
                            <input id='IssueDate' name='IssueDate' type='text'
                                   class='form-control DigitalSign-enable' size='10' maxlength='10'
                                   placeholder='día/mes/año' disabled>
                            <span class='input-group-addon'>
                                <span class='glyphicon glyphicon-calendar'></span>
                            </span>
                        </div>
                        <div id='IssueDate_validate'></div>

                    </div>
                </div>
                <!-- EffectiveDate -->
                <div class='col-sm-4 col-md-3'>
                    <div class='form-group'>
                        <label class='control-label' for='EffectiveDate'>
                            Inicio de
                            vigencia<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span>
                        </label>
                        <div class='input-group date' id='EffectiveDate_group'>
                            <input id='EffectiveDate' name='EffectiveDate'
                                   type='text' class='form-control' size='10'
                                   maxlength='10' placeholder='día/mes/año'>
                            <span class='input-group-addon'>
                                <span class='glyphicon glyphicon-calendar'></span>
                            </span>
                        </div>
                        <div id='EffectiveDate_validate'></div>

                    </div>
                </div>
                <!-- EndingDate -->
                <div class='col-sm-4 col-md-3'>
                    <div class='form-group'>
                        <label class='control-label' for='EndingDate'>
                            Fin de
                            vigencia<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span>
                        </label>
                        <div class='input-group date' id='EndingDate_group'>
                            <input id='EndingDate' name='EndingDate' type='text'
                                   class='form-control' size='10' maxlength='10'
                                   placeholder='día/mes/año'>
                            <span class='input-group-addon'>
                                <span class='glyphicon glyphicon-calendar'></span>
                            </span>
                        </div>
                        <div id='EndingDate_validate'></div>

                    </div>
                </div>

                <!-- InsuredAmountBase -->
                <div class='col-sm-4 col-md-3'>
                    <div class='form-group'>
                        <label class='control-label' for='InsuredAmountBase'>
                            Suma
                            asegurada<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span>
                        </label>
                        <input id='InsuredAmountBase' name='InsuredAmountBase' type='text'
                               class='form-control text-right' size='18'
                               maxlength='18'>
                    </div>
                </div>
                <!-- InsuredAmountComplement -->
                <div class='col-sm-4 col-md-3'>
                    <div class='form-group'>
                        <label class='control-label' for='InsuredAmountComplement'>
                            Suma
                            asegurada a refundir<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span>
                        </label>
                        <input id='InsuredAmountComplement' name='InsuredAmountComplement' type='text'
                               class='form-control text-right' size='18'
                               maxlength='18' disabled>
                    </div>
                </div>


                <!-- AnnualPremium -->
                <div class='col-sm-4 col-md-3'>
                    <div class='form-group'>
                        <label class='control-label' for='AnnualPremium'>
                            Prima
                            anual
                        </label>
                        <input id='AnnualPremium' name='AnnualPremium' type='text'
                               class='form-control text-right' size='18'
                               maxlength='18'>
                    </div>
                </div>
                <!-- MonthlyPremium -->
                <div class='col-sm-4 col-md-3'>
                    <div class='form-group'>
                        <label class='control-label' for='MonthlyPremium'>
                            Prima
                            mensual
                        </label>
                        <input id='MonthlyPremium' name='MonthlyPremium' type='text'
                               class='form-control text-right' size='18'
                               maxlength='18'>
                    </div>
                </div>
                <!-- Surcharge -->
                <div class='col-sm-4 col-md-3'>
                    <div class='form-group d-none'>
                        <label class='control-label' for='Surcharge'>
                            Recargo
                        </label>
                        <div class='input-group'>
                            <input id='Surcharge' name='Surcharge' type='text'
                                   class='form-control text-right' size='8'
                                   maxlength='8' disabled>
                            <span class='input-group-addon'>
                                <small class="text-muted" title="Porcentaje">%</small>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-row">
                <!-- InsuredAmount -->
                <div class='col-sm-4 offset-sm-8 col-md-3 offset-md-3'>
                    <div class='form-group'>
                        <label class='control-label' for='InsuredAmount'>
                            <b>Total de suma asegurada </b>
                        </label>
                        <input id='InsuredAmount' name='InsuredAmount' type='text'
                               class='form-control text-right' size='18'
                               maxlength='18' style="font-weight: bold;" disabled>
                    </div>
                </div>
                <!-- TotalAnnualPremium col-sm-4 offset-sm-4 col-md-3 offset-md-3-->
                <div class='col-sm-4 offset-sm-8 col-md-3 offset-md-0'>
                    <div class='form-group'>
                        <label class='control-label' for='TotalAnnualPremium'>
                            <b>Total de prima anual</b>
                        </label>
                        <input id='TotalAnnualPremium' name='TotalAnnualPremium' type='text'
                               class='form-control text-right' size='18'
                               maxlength='18' style="font-weight: bold;" disabled>
                    </div>
                </div>
                <!-- MonthlyPremium col-sm-4 offset-sm-4 col-md-3 offset-md-3-->
                <div class='col-sm-4 offset-sm-8 col-md-3 offset-md-0'>
                    <div class='form-group'>
                        <label class='control-label' for='TotalPremium'>
                            <b>Total de prima</b>
                        </label>
                        <input id='TotalPremium' name='TotalPremium' type='text'
                               class='form-control text-right' size='18'
                               maxlength='18' style="font-weight: bold;" disabled>
                    </div>
                </div>
            </div>
            <!-- Datos de la póliza principal -->
            <div class="form-row d-none DigitalSign-visible">
                <div class="col-md">
                    <h4>Datos de la póliza matriz</h4>
                    <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                    <div class="form-row">
                        <!-- ContractorName DropDownList -->
                        <div class='col-sm-4 col-md-4'>
                            <div class='form-group'>
                                <label class='control-label' for='ContractorName'>Filial<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                <select id='ContractorName' name='ContractorName' class='form-control'></select>
                            </div>
                        </div>
                        <!-- MainPolicyId Text -->
                        <div class='col-sm-4 col-md-4'>
                            <div class='form-group'>
                                <label class='control-label' for='MainPolicyId'>N° de póliza</label>
                                <select id='MainPolicyId' name='MainPolicyId' class='form-control' disabled></select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-row">
                <!-- Annotation -->
                <div class='col-sm-4 col-md-12'>
                    <div class='form-group'>
                        <label class='control-label' for='Surcharge'>
                            Anotaciones
                        </label>


                        <div class='form-group'>
                            <textarea id='Annotation' name='Annotation' class='form-control' size='350' maxlength='350' rows="2"></textarea>
                        </div>

                    </div>
                </div>
            </div>
            <!-- Estado de la póliza -->
            <div id="policyStatusZone" class="form-row d-none">
                <div class="col-lg-12">
                    <h4>Estado de la póliza</h4>
                    <div class="hr-line-dashed"
                         style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                    <div class="form-row">
                        <!-- Status -->
                        <div class='col-sm-4 col-md-3'>
                            <div class='form-group'>
                                <label class='control-label' for='Status'>
                                    Estado
                                </label>
                                <select id='Status' name='Status'
                                        class='form-control'></select>
                            </div>
                        </div>
                        <!-- CancellationDate -->
                        <div class='col-sm-4 col-md-3 offset-md-3'>
                            <div class='form-group'>
                                <label class='control-label' for='CancellationDate'>
                                    Fecha de baja<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                </label>
                                <div class='input-group date' id='CancellationDate_group'>
                                    <input id='CancellationDate' name='CancellationDate' type='text'
                                           class='form-control' size='10' maxlength='10'
                                           placeholder='día/mes/año' disabled>
                                    <span class='input-group-addon'>
                                        <span class='glyphicon glyphicon-calendar'></span>
                                    </span>
                                </div>
                                <div id='CancellationDate_validate'></div>

                            </div>
                        </div>
                        <!-- ReasonForStatus -->
                        <div class='col-sm-4 col-md-3'>
                            <div class='form-group'>
                                <label class='control-label' for='ReasonForStatus'>
                                    Causa de la baja<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                </label>
                                <select id='ReasonForStatus' name='ReasonForStatus'
                                        class='form-control' disabled></select>
                            </div>
                        </div>
                        <div class='col-md-12 text-right'>
                            <a id="AcceptCancellation" href="" class="btn btn-danger btn-xs d-none" title="Cancela la póliza"><i class="fa fa-times"></i> Cancelar la póliza</a>
                        </div>
                    </div>
                </div>
            </div>



            <!-- Comentarios -->
            <div id="policyComment" class="form-row d-none">
                <div class="col-lg-12">
                    <h4>Observaciones</h4>
                    <div class="hr-line-dashed"
                         style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>

                    <div class="form-row">
                        <!-- Comments -->
                        <div class='col-md-12'>
                            <div class='form-group'>
                                <textarea id='Comments' name='Comments' class='form-control' size='350' maxlength='350' rows="3" disabled></textarea>
                            </div>
                        </div>
                        <div class='col-md-12 text-right'>
                            <a id="ReviewAccept" href="" class="btn btn-primary btn-xs d-none" title="Aceptar la solicitud"><i class="fa fa-thumbs-up"></i> Aceptar</a>
                            <a id="ReviewCondition" href="" class="btn btn-primary btn-xs d-none" title="Define condiciones para ser aceptadas por el aliado"><i class="fa fa-comments"></i> Condicionar</a>
                            <a id="ReviewDecline" href="" class="btn btn-danger btn-xs d-none" title="Declinar la solicitud"><i class="fa fa-times"></i> Declinar</a>
                            <a id="ReviewComplement" href="" class="btn btn-warning btn-xs d-none" title="Solicitar complementos"><i class="fa fa-files-o"></i> Solicitar complementos</a>

                            <a id="AcceptCondition" href="" class="btn btn-primary btn-xs d-none" title="Aceptar las condiciones definidas"><i class="fa fa-thumbs-up"></i> Aceptar</a>
                            <a id="AcceptDecline" href="" class="btn btn-danger btn-xs d-none" title="Declinar la solicitud"><i class="fa fa-times"></i> Declinar</a>

                        </div>
                    </div>
                </div>
            </div>
        </fieldset>
    </form>
</div>
