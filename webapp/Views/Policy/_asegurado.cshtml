                                   maxlength='40'>
                        </div>
                        <div id='LastName_validate'></div>
                    </div>
                </div>
                <!-- BirthDate -->
                <div class='col-sm-4 col-md-3'>
                    <div class='form-group'>
                        <label class='control-label' for='BirthDate'>
                            Fecha de
                            nacimiento<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span>
                        </label>
                        <div class='input-group date' id='BirthDate_group'>
                            <input id='BirthDate' name='BirthDate' type='text'
                                   class='form-control' size='10' maxlength='10'
                                   placeholder='día/mes/año'>
                            <span class='input-group-addon'>
                                <span class='glyphicon glyphicon-calendar'></span>
                            </span>
                        </div>
                        <div id='BirthDate_validate'></div>
                    </div>
                </div>
                <!-- Gender -->
                <div class='col-sm-4 col-md-3'>
                    <div class='form-group'>
                        <label class='control-label' for='Gender'>
                            Sexo<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span>
                        </label>
                        <select id='Gender' name='Gender'
                                class='form-control'></select>
                        <div id='Gender_validate'></div>
                    </div>
                </div>
                <!-- CivilStatus -->
                <div class='col-sm-4 col-md-3'>
                    <div class='form-group'>
                        <label class='control-label' for='CivilStatus'>
                            Estado civil<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span>
                        </label>
                        <select id='CivilStatus' name='CivilStatus'
                                class='form-control'></select>
                    </div>
                </div>
                <!-- Height -->
                <div class='col-sm-4 col-md-3'>
                    <div class='form-group'>
                        <label class='control-label' for='Height'>Estatura</label>
                        <div class='input-group'>
                            <input id='Height' name='Height' type='text'
                                   class='form-control text-right' size='5'
                                   maxlength='5'>
