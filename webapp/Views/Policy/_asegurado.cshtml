                            </span>
                        </div>
                        <div id='Height_validate'></div>
                    </div>
                </div>
                <!-- Weight -->
                <div class='col-sm-4 col-md-3'>
                    <div class='form-group'>
                        <label class='control-label' for='Weight'>Peso</label>
                        <div class='input-group'>
                            <input id='Weight' name='Weight' type='text'
                                   class='form-control text-right' size='5'
                                   maxlength='5'>
                            <span class='input-group-addon'>
                                <small class="text-muted" title="Libras">lbs</small>
                            </span>
                        </div>
                        <div id='Weight_validate'></div>
                    </div>
                </div>
                <!-- BloodPressureSystolic / BloodPressureDiastolic -->
                <div class='col-sm-4 col-md-3'>
                    <div class='form-group'>
                        <label class='control-label' for='Weight'>Presión arterial</label>
                        <div class='input-group'>
                            <input id='BloodPressureSystolic' name='BloodPressureSystolic' type='text' class='form-control text-right' size='3' maxlength='3'>
                            <span class='input-group-addon'>
                                /
                            </span>
                            <input id='BloodPressureDiastolic' name='BloodPressureDiastolic' type='text' class='form-control text-left' size='3' maxlength='3'>
                        </div>

                    </div>
                </div>
                <!-- PhoneNumber -->
                <div class='col-sm-4 col-md-3'>
                    <div class='form-group'>
                        <label class='control-label'
                               for='PhoneNumber'>Teléfono</label>
                        <div class='input-group'>

                            <span class='input-group-addon'>
                                <span class='glyphicon glyphicon-earphone'></span>
                            </span>

                            <div class="input-group-prepend">
                                <button class="btn btn-default dropdown-toggle"
                                        type="button" data-toggle="dropdown"
                                        aria-haspopup="true" aria-expanded="false" id="PhoneType" data-value='1'>
                                    Celular
                                </button>
                                <div class="dropdown-menu" id="PhoneTypeMenu">
                                    <a class="dropdown-item active" data-value='1'
                                       href="#">Celular</a>
                                    <a class="dropdown-item" data-value='2' href="#">Habitación</a>
                                    <a class="dropdown-item" data-value='3' href="#">Oficina</a>
                                    <a class="dropdown-item" data-value='4' href="#">Fax</a>
                                </div>
                            </div>

                            <input id='PhoneNumber' name='PhoneNumber' type='text'
                                   class='form-control' size='9' maxlength='9'>

                        </div>
                        <div id='PhoneNumber_validate'></div>
                    </div>
                </div>
                <!-- PrimaryEmailAddress -->
                <div class='col-sm-4 col-md-3'>
                    <div class='form-group'>
                        <label class='control-label' for='PrimaryEmailAddress'>
                            Correo
                            electrónico<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span>
                        </label>
                        <div class='input-group'>
                            <span class='input-group-addon'>
                                <span class='glyphicon glyphicon-envelope'></span>
                            </span>
                            <input id='PrimaryEmailAddress'
                                   name='PrimaryEmailAddress' type='text'
                                   class='form-control' size='80' maxlength='80'>
                        </div>
                        <div id='PrimaryEmailAddress_validate'></div>
                    </div>
                </div>
            </div>

            <!-- Dirección -->
            <div class="form-row">


                <div class="col-lg-12">

                    <h4><i class="fa fa-map-marker"></i> Dirección</h4>
                    <div class="hr-line-dashed"
                         style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>

                    <div class="form-row">

                        <!-- Sequence -->
                        <input id='Sequence' name='Sequence' type='hidden' value=''>

                        <!-- Province -->
                        <div class='col-sm-2 col-md-2'>
                            <div class='form-group'>
                                <label class='control-label'
                                       for='Province'>
                                    Provincia<span class='required-mark'
                                                   title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                </label>
                                <select id='Province' name='Province'
                                        class='form-control'></select>
                            </div>
                        </div>
                        <!-- Canton -->
                        <div class='col-sm-2 col-md-2'>
                            <div class='form-group'>
                                <label class='control-label'
                                       for='Canton'>
                                    Cantón<span class='required-mark'
                                                title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                </label>
                                <select id='Canton' name='Canton'
                                        class='form-control'></select>
                            </div>
                        </div>
                        <!-- District -->
                        <div class='col-sm-2 col-md-2'>
                            <div class='form-group'>
                                <label class='control-label'
                                       for='District'>
                                    Distrito<span class='required-mark'
                                                  title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                </label>
                                <select id='District' name='District'
                                        class='form-control'></select>
                            </div>
                        </div>

                        <!-- AddressDetail -->
                        <div class='col-sm-6 col-md-6'>
                            <div class='form-group'>
                                <label class='control-label'
                                       for='AddressDetail'>
                                    Dirección<span class='required-mark'
                                                   title='Este campo debe ser llenado de forma obligatoria'>*</span>
                                </label>
                                <input id='AddressDetail' name='AddressDetail'
                                       type='text' class='form-control' size='120'
                                       maxlength='120'>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Otros datos -->
            <div class="form-row">
                <div class="col-lg-12">
                    <h4>Otros datos</h4>
                    <div class="hr-line-dashed"
                         style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>

                    <div class="form-row">

                        <!-- Occupation -->
                        <div class='col-sm-4 col-md-3'>
                            <div class='form-group'>
                                <label class='control-label' for='Occupation'>Ocupación</label>
                                <input id='Occupation' name='Occupation' type='text' class='form-control' size='40' maxlength='40'>
                            </div>
                        </div>
                        <!-- RetirementModality -->
                        <div class='col-sm-4 col-md-3'>
                            <div class='form-group'>
                                <label class='control-label' for='RetirementModality'>Condición</label>
                                <select id='RetirementModality' name='RetirementModality' class='form-control'>
                                </select>
                            </div>
                        </div>
                        <!-- RetirementCause -->
                        <div class='col-sm-4 col-md-3'>
                            <div class='form-group'>
                                <label class='control-label' for='RetirementCause'>Causa de pensión</label>
                                <input id='RetirementCause' name='RetirementCause' type='text' class='form-control' size='40' maxlength='40' disabled="disabled">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- HasDigitalSignature Zone -->
            <div class="form-row d-none DigitalSign-visible">
                <div class="col-lg-12">
                    <h4><i class='fa fa-certificate'></i> Información para firma digital</h4>
                    <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                    <div class="form-row">
                        <div class='col-sm-12 col-md-12'>
                            <p class="text-muted">Como parte del proceso para aceptar esta solicitud por parte de MAPFRE Costa Rica, es necesario firmar esta planilla, para tal acción se utilizan dos opciones, la primera es el aceptado y firma de la solución por medio de una página especializada y la segunda es la posibilidad de firmar digitalmente usando los dispositivos apropiados para tal fin en costa rica.</p>
                        </div>
                        <!-- HasDigitalSignature RadioButtonList -->
                        <div class='col-sm-12 col-md-12'>
                            <div class='form-group'>
                                <label class='control-label' for='HasDigitalSignature'>¿Desea usted firma digitalmente la solicitud actual en el momento en que el proceso así lo requiera?</label>
                                <p class="text-muted small">Por favor tome en cuenta que para poder firmar digitalmente se necesita contar con el dispositivo apropiado para realizar dicha firma.</p>
                                <div style="padding-top: 6px;">
                                    <div class="custom-control custom-radio custom-control-inline">
                                        <input type="radio" class="custom-control-input" id="HasDigitalSignature_1" name="HasDigitalSignature" value="1">
                                        <label class="custom-control-label" for="HasDigitalSignature_1">Si, prefiero firmar digitalmente</label>
                                    </div><div class="custom-control custom-radio custom-control-inline">
                                        <input type="radio" class="custom-control-input" id="HasDigitalSignature_2" name="HasDigitalSignature" value="2" checked>
                                        <label class="custom-control-label" for="HasDigitalSignature_2">No, prefiero usar la página especializada</label>
                                    </div>
                                </div>
                                <div id='HasDigitalSignature_validate'></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </fieldset>
    </form>
</div>