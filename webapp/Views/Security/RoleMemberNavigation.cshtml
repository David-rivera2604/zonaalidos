@{
    Layout = "~/Views/_Layout.cshtml";
}
@Styles.Render("~/Content/cssCRUD")
<!-- RoleMemberNavigation -->
<div class="ibox">
    <div class="ibox-title">
        <h5 id="RoleMemberNavigationTitle">Navegación permitida por rol</h5>
        <!-- Opciones -->
        <div class="ibox-tools">
            <a class="tool-filter">
                <i class="fa fa-filter"></i>
            </a>
            <a class="tool-new">
                <i class="fa fa-plus"></i>
            </a>
            <a class="fullscreen-link">
                <i class="fa fa-expand"></i>
            </a>
            <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                <i class="fa fa-wrench"></i>
            </a>
            <ul class="dropdown-menu dropdown-user">
                <li>
                    <a href="#" class="dropdown-item tool-new"><i class="fa fa-plus"></i> <span id="RoleMemberNavigationMenuNew">Crear un nuevo rol</span></a>
                </li>
                <li>
                    <a href="#" class="dropdown-item tool-filter"><i class="fa fa-filter"></i> <span id="RoleMemberNavigationMenuFilter">Filtro avanzado...</span></a>
                </li>
                <li>
                    <a href="#" class="dropdown-item tool-refresh"><i class="fa fa-refresh"></i> <span id="RoleMemberNavigationMenuRefresh">Recargar los roles</span></a>
                </li>
                <li>
                    <a href="#" class="dropdown-item tool-filter"><i class="fa fa-file-excel-o"></i> <span id="RoleMemberNavigationMenuExport">Exportar a Excel...</span></a>
                </li>
                <li>
                    <a href="#" class="dropdown-item tool-audit" data-toggle="modal" data-target="#myModal5"><i class="fa fa-clock-o"></i> <span id="RoleMemberNavigationMenuAudit">Historial...</span></a>
                </li>
            </ul>
        </div>
    </div>
    <div class="ibox-content">
        <!-- Filtro -->
        <div class='form-row filter-row'>
            <div class='form-group col-md-12'>
                <div class="input-group placeholder-small">
                    <input id="RoleMemberNavigationSearch" type="text" placeholder="Permite filtrar por nombre del rol o descripción" title="Permite filtrar por nombre del rol o descripción" class="form-control form-control-sm" maxlength="40">
                    <span class="input-group-append">
                        <button type="button" class="btn btn btn-primary btn-xs" id="ApplyFilter"> <i class="fa fa-search"></i> Filtrar</button>
                    </span>
                </div>
            </div>
        </div>
        <!-- Filtro avanzado -->
        <div class='form-row d-none advancefilter-row animated fadeInDown'>
            <div class="form-group col-md-6">
                <label class="control-label" for="RecordStatusFlt">Estado</label>
                <select id="RecordStatusFlt" name="RecordStatusFlt" title="" multiple class="form-control form-control-sm">
                </select>
            </div>
        </div>
        <!-- Grid -->
        <div class='form-row'>
            <div class='col-md-12'>
                <div class="table-responsive animated bounceInRight">
                    <table id="RoleMemberNavigationGridTbl" style="font-size: 11px;"></table>
                </div>
            </div>
        </div>
        <!-- Edit Form -->
        <div class='form-row'>
            <div class='col-md-12'>
                <div id="RoleMemberNavigationEdt" class="animated fadeInRight d-none">
                    <form id='RoleMemberNavigationEdtForm' class='form-horizontal' data-toggle='validator'>
                        <fieldset>
                            <div class="form-row">
                                <!-- RoleId -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='RoleId'>Role<span class='required-mark'>*</span></label>
                                        <input id='RoleId' name='RoleId' type='text' class='form-control text-right' size='9' maxlength='9'>
                                    </div>
                                </div>
                                <!-- Code -->
                                <input id='Code' name='Code' type='hidden' value=''>
                                <!-- Allow -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='Allow'>Permitir</label>
                                        <input id='Allow' name='Allow' type='text' class='form-control' size='1' maxlength='1'>
                                    </div>
                                </div>
                                <!-- SecurityLevel -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='SecurityLevel'>Seguridad</label>
                                        <input id='SecurityLevel' name='SecurityLevel' type='text' class='form-control text-right' size='3' maxlength='3'>
                                    </div>
                                </div>
                                <!-- CreateAction -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='CreateAction'>Add</label>
                                        <input id='CreateAction' name='CreateAction' type='text' class='form-control' size='1' maxlength='1'>
                                    </div>
                                </div>
                                <!-- ReadAction -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='ReadAction'>Re</label>
                                        <input id='ReadAction' name='ReadAction' type='text' class='form-control' size='1' maxlength='1'>
                                    </div>
                                </div>
                                <!-- UpdateAction -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='UpdateAction'>Update</label>
                                        <input id='UpdateAction' name='UpdateAction' type='text' class='form-control' size='1' maxlength='1'>
                                    </div>
                                </div>
                                <!-- DeleteAction -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='DeleteAction'>Delete</label>
                                        <input id='DeleteAction' name='DeleteAction' type='text' class='form-control' size='1' maxlength='1'>
                                    </div>
                                </div>
                                <!-- ListAction -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='ListAction'>List</label>
                                        <input id='ListAction' name='ListAction' type='text' class='form-control' size='1' maxlength='1'>
                                    </div>
                                </div>
                                <!-- PrintAction -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='PrintAction'>Print</label>
                                        <input id='PrintAction' name='PrintAction' type='text' class='form-control' size='1' maxlength='1'>
                                    </div>
                                </div>

                            </div>
                            <div class="form-row">
                                <div class='col-md-12'>
                                    <div class="modal-footer">
                                        <button id="RoleMemberNavigationEdtFormSave" type="button" class="btn btn-primary">Guardar cambios</button>
                                        <button id="RoleMemberNavigationEdtFormCancel" type="button" class="btn btn-white">Cancelar</button>
                                    </div>
                                </div>
                            </div>
                        </fieldset>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jsCRUD")
    <script src="@Url.Content("~/app/js/core.language.js")"></script>
    <script src="@Url.Content("~/Scripts/Security.RoleMemberNavigation.js")"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            app.SecurityRoleMemberNavigation.Init();
        });
    </script>
}
