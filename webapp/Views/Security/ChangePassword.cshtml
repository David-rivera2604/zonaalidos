@{
    Layout = "~/Views/_Layout.cshtml";
}
@Styles.Render("~/Content/cssCRUD")
<!-- ChangePassword -->
<div class="ibox">
    <div class="ibox-title">
        <h5>Cambio de clave de acceso</h5>
        <!-- Opciones -->
        <div class="ibox-tools">
            <a class="fullscreen-link">
                <i class="fa fa-expand"></i>
            </a>
        </div>
    </div>
    <div class="ibox-content">
        <!-- Edit Form -->
        <div class='form-row'>
            <div class='col-md-12'>
                <div id="ChangePasswordEdt" class="animated fadeInRight">
                    <form id='ChangePasswordEdtForm' class='form-horizontal' data-toggle='validator'>
                        <fieldset>
                            <div class="form-row">
                                <div class="col-lg-12">

                                    <h4>Información de la clave actual</h4>
                                    <div class="hr-line-dashed"
                                         style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                    <!-- Clave de acceso actual -->
                                    <div class="form-group row">
                                        <label class="col-sm-3 col-form-label text-right" for="CurrentPassword">Clave de acceso actual<span class='required-mark'>*</span></label>
                                        <div class="col-sm-9">
                                            <input id='CurrentPassword' name='CurrentPassword' type='password' class='form-control' size='60' maxlength='60' placeholder="Indique la clave de acceso actual" title="Clave de acceso actual">
                                        </div>
                                    </div>

                                    <h4>Información de la nueva clave</h4>
                                    <div class="hr-line-dashed"
                                         style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                    <!-- Clave de acceso -->
                                    <div class="form-group row">
                                        <label class='col-sm-3 col-form-label text-right' for='NewPassword'>Clave de acceso<span class='required-mark'>*</span></label>
                                        <div class="col-sm-9">
                                            <input id='NewPassword' name='NewPassword' type='password' class='form-control' size='60' maxlength='60' placeholder="Indique su nueva clave de acceso" title="Nueva clave de acceso">
                                        </div>
                                    </div>
                                    <!-- Confirmar -->
                                    <div class="form-group row">
                                        <label class='col-sm-3 col-form-label text-right' for='ConfirmPassword'>Confirmar<span class='required-mark'>*</span></label>
                                        <div class="col-sm-9">
                                            <input id='ConfirmPassword' name='ConfirmPassword' type='password' class='form-control' size='60' maxlength='60' placeholder="Confirmar la nueva clave de acceso ingresada" title="Confirmar la nueva clave de acceso">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-row">
                                <div class='col-md-12'>
                                    <div class="modal-footer">
                                        <button id="ChangePasswordEdtFormSave" type="button" class="btn btn-primary" title="Permite cambiar la clave de acceso">Cambiar clave de acceso</button>
                                    </div>
                                </div>
                            </div>
                        </fieldset>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jsCRUD")
    <script src="@Url.Content("~/Scripts/Security.ChangePassword.js")"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            app.SecurityChangePassword.Init();
        });
    </script>
}
