                                <!-- RecordStatus -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='RecordStatus'>Estado del Registro<span class='required-mark'>*</span></label>
                                        <select id='RecordStatus' name='RecordStatus' class='form-control'></select>
                                    </div>
                                </div>

                                <!-- Roles -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='Roles'>Roles<span class='required-mark'>*</span></label>
                                        <select id='Roles' name='Roles' class='form-control' multiple></select>
                                        <div id='Roles_validate'></div>
                                    </div>
                                </div>
                                <!-- AccessKey -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='AccessKey'>Clave de acceso para integración</label>
                                        <input id='AccessKey' name='AccessKey' type='text' class='form-control' size='20' maxlength='20'>
                                    </div>
                                </div>
                                <!-- Cod_Agt DropDownList -->
                                <div class='col-sm-4 col-md-4 d-none' id="agt-section">
                                    <div class='form-group'>
                                        <label class='control-label' for='Cod_Agt'>Agente</label>
                                        <select id='Cod_Agt' name='Cod_Agt' class='form-control' data-event='clear.grid'>
                                        </select>
                                    </div>
                                </div>
                                <!-- IsService -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='IsService'>Es una cuenta de servicio?</label>
                                        <br /><div class="custom-control custom-radio custom-control-inline">
                                            <input type="radio" class="custom-control-input" id="IsServicea" name="IsService" value="true">
                                            <label class="custom-control-label" for="IsServicea">Si</label>
                                        </div>
                                        <div class="custom-control custom-radio custom-control-inline">
                                            <input type="radio" class="custom-control-input" id="IsServiceb" name="IsService" value="false">
                                            <label class="custom-control-label" for="IsServiceb">No</label>
                                        </div>
                                        <div id='IsService_validate'></div>
                                    </div>
                                </div>
                                <!-- Is2FAEnabled -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='Is2FAEnabled'>La autenticación de dos factores esta activa?</label>
                                        <br /><div class="custom-control custom-radio custom-control-inline">
                                            <input type="radio" class="custom-control-input" id="Is2FAEnableda" name="Is2FAEnabled" value="true">
                                            <label class="custom-control-label" for="Is2FAEnableda">Si</label>
                                        </div>
                                        <div class="custom-control custom-radio custom-control-inline">
                                            <input type="radio" class="custom-control-input" id="Is2FAEnabledb" name="Is2FAEnabled" value="false">
                                            <label class="custom-control-label" for="Is2FAEnabledb">No</label>
                                        </div>
                                        <div id='Is2FAEnabled_validate'></div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-row">
                                <div class='col-md-12'>
                                    <div class="modal-footer">
                                        <button id="UserMemberEdtFormSave" type="button" class="btn btn-primary d-none formbtn" data-doing="Guardando cambios...">Guardar cambios</button>
                                        <button id="UserMemberEdtFormSaveContinue" type="button" class="btn btn-primary btn-sm d-none formbtn" data-doing="Guardando cambios..." title="Guardar cambios y continuar">Guardar y continuar</button>
                                        <button id="UserMemberEdtFormSaveCopy" type="button" class="btn btn-primary btn-sm d-none formbtn" data-doing="Guardando cambios..." title="Guardar cambios y continuar">Guardar y copiar</button>
                                        <button id="UserMemberEdtFormDuplicate" type="button" class="btn btn-info btn-sm d-none formbtn" data-doing="Duplicando..." title="Duplica la información actual">Duplicar</button>
                                        <button id="UserMemberEdtFormDelete" type="button" class="btn btn-danger btn-sm d-none formbtn" data-doing="Eliminando..." title="Elimina la información actual">Eliminar</button>
                                        <button id="UserMemberEdtFormCancel" type="button" class="btn btn-white d-none formbtn">Cancelar</button>
                                    </div>
                                </div>
                            </div>
                        </fieldset>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jsCRUD")
    <script src="@Url.Content("~/app/js/core.language.js")"></script>
    <script src="@Url.Content("~/Scripts/Security.UserMember.js")"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            app.SecurityUserMember.Init();
        });
    </script>
}
