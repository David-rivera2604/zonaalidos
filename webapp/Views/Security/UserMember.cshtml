                                <!-- OneTimePassword -->
                                @*<div class='col-sm-4 col-md-4'>
            <div class='form-group'>
                <label class='control-label' for='OneTimePassword'>One Time Password</label>
                <input id='OneTimePassword' name='OneTimePassword' type='text' class='form-control' size='6' maxlength='6'>
            </div>
        </div>*@
                                <!-- LoginDate -->
                                @*<div class='col-sm-4 col-md-4'>
            <div class='form-group'>
                <label class='control-label' for='LoginDate'>Ultima conexión</label>
                <div class='input-group date' id='LoginDate_group'>
                    <input id='LoginDate' name='LoginDate' type='text'
                           class='form-control' size='10' maxlength='10'
                           placeholder='día/mes/año'>
