                                <!-- ManagerId -->
                                @*<div class='col-sm-4 col-md-4'>
            <div class='form-group'>
                <label class='control-label' for='ManagerId'>Supervisor</label>
                <input id='ManagerId' name='ManagerId' type='text' class='form-control text-right' size='9' maxlength='9'>
            </div>
        </div>*@

                                <!-- BranchOffice -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='BranchOffice'>Sucursal</label>
                                        <select id='BranchOffice' name='BranchOffice' class='form-control'></select>
                                    </div>
                                </div>
                                <!-- Reference -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='Reference'>Referencia</label>
                                        <input id='Reference' name='Reference' type='text' class='form-control' size='36' maxlength='36'>
                                    </div>
                                </div>
                                <!-- Position -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='Position'>Cargo</label>
                                        <select id='Position' name='Position' class='form-control'></select>
                                    </div>
                                </div>
                                <!-- PhoneNumber -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='PhoneNumber'>Teléfono</label>
                                        <input id='PhoneNumber' name='PhoneNumber' type='text' class='form-control' size='20' maxlength='20'>
                                    </div>
                                </div>
                                @*<!-- SalesChannel -->
        <div class='col-sm-4 col-md-4'>
            <div class='form-group'>
