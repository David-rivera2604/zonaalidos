@{
    Layout = "~/Views/_Layout.cshtml";
}
@Styles.Render("~/Content/cssCRUD")
<!-- UserMember -->
<div class="ibox">
    <div class="ibox-title">
        <h5 id="UserMemberTitle">Mantenimiento de usuarios</h5>
        <!-- Opciones -->
        <div class="ibox-tools">
            <a class="tool-filter">
                <i class="fa fa-filter" title="Despliega el filtro avanzado..."></i>
            </a>
            <a class="tool-new">
                <i class="fa fa-plus" title="Crear un nuevo usuario"></i>
            </a>
            <a class="fullscreen-link">
                <i class="fa fa-expand" title="Expande la zona de trabajo"></i>
            </a>
            <a class="dropdown-toggle" data-toggle="dropdown" href="#" title="Opciones adicionales...">
                <i class="fa fa-wrench"></i>
            </a>
            <ul class="dropdown-menu dropdown-user">
                <li>
                    <a href="#" class="dropdown-item tool-new"><i class="fa fa-plus"></i> Crear un nuevo usuario</a>
                </li>
                <li>
                    <a href="#" class="dropdown-item tool-filter"><i class="fa fa-filter"></i> Despliega el filtro avanzado...</a>
                </li>
                <li>
                    <a href="#" class="dropdown-item tool-refresh"><i class="fa fa-refresh"></i> Recargar los usuarios</a>
                </li>
                <li>
                    <a href="#" class="dropdown-item tool-filter"><i class="fa fa-file-excel-o"></i> Exportar a Excel...</a>
                </li>
                <li>
                    <a href="#" class="dropdown-item tool-audit" data-toggle="modal" data-target="#myModal5"><i class="fa fa-clock-o"></i> Historial...</a>
                </li>
            </ul>
        </div>
    </div>
    <div class="ibox-content">
        <div class="sk-spinner sk-spinner-wave">
            <div class="sk-rect1"></div>
            <div class="sk-rect2"></div>
            <div class="sk-rect3"></div>
            <div class="sk-rect4"></div>
            <div class="sk-rect5"></div>
        </div>
        <div id="generalNotify">
        </div>
        <!-- Filtro -->
        <div class='form-row filter-row'>
            <div class='form-group col-md-12'>
                <div class="input-group placeholder-small">
                    <input id="UserMemberSearch" type="text" placeholder="Permite filtrar por nombre del rol o descripción" title="Permite filtrar por nombre del rol o descripción" class="form-control form-control-sm" maxlength="40">
                    <span class="input-group-append">
                        <button type="button" class="btn btn btn-primary btn-xs" id="ApplyFilter"> <i class="fa fa-search"></i> Filtrar</button>
                    </span>
                </div>
            </div>
        </div>
        <!-- Filtro avanzado -->
        <div class='form-row d-none advancefilter-row animated fadeInDown'>
            <div class="form-group col-md-6">
                <label class="control-label" for="RecordStatusFlt">Estado</label>
                <select id="RecordStatusFlt" name="RecordStatusFlt" title="" multiple class="form-control form-control-sm">
                </select>
            </div>
        </div>
        <!-- Grid -->
        <div class='form-row'>
            <div class='col-md-12'>
                <div class="table-responsive animated bounceInRight">
                    <table id="UserMemberGridTbl" style="font-size: 11px;"></table>
                </div>
            </div>
        </div>
        <!-- Edit Form -->
        <div class='form-row'>
            <div class='col-md-12'>
                <div id="UserMemberEdt" class="animated fadeInRight d-none">
                    <form id='UserMemberEdtForm' class='form-horizontal' data-toggle='validator'>
                        <fieldset>
                            <div class="form-row" id="extend">
                                <!-- UserId -->
                                <input id='UserId' name='UserId' type='hidden' value=''>
                                <!-- UserName -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='UserName'>Usuario<span class='required-mark'>*</span></label>
                                        <input id='UserName' name='UserName' type='text' class='form-control' size='35' maxlength='35'>
                                    </div>
                                </div>
                                <!-- EMail -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='EMail'>Correo<span class='required-mark'>*</span></label>
                                        <input id='EMail' name='EMail' type='text' class='form-control' size='120' maxlength='120'>
                                    </div>
                                </div>
                                <!-- Password -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='Password'>Clave<span class='required-mark'>*</span></label>
                                        <input id='Password' name='Password' type='Password' class='form-control' size='255' maxlength='255'>
                                    </div>
                                </div>
                                <!-- OldPassword -->
                                @*<div class='col-sm-4 col-md-4'>
            <div class='form-group'>
                <label class='control-label' for='OldPassword'>Old Password</label>
                <input id='OldPassword' name='OldPassword' type='text' class='form-control' size='255' maxlength='255'>
            </div>
        </div>*@
                                <!-- DocumentNumber Text -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='DocumentNumber'>Identificación</label>
                                        <div class='input-group'>
                                            <span class='input-group-addon'>
                                                <span class='glyphicon glyphicon-barcode'></span>
                                            </span>
                                            <div class="input-group-prepend">
                                                <button class="btn btn-default dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-value='1' id="DocumentNumberType">
                                                    Cédula
                                                </button>
                                                <div class="dropdown-menu" id="DocumentNumberTypeMenu">
                                                    <a id="DocumentNumberTypeOption1" class="dropdown-item active" href="#" data-value='1'>Cédula</a>
                                                    <a id="DocumentNumberTypeOption2" class="dropdown-item" href="#" data-value='2'>DIMEX</a>
                                                    <a id="DocumentNumberTypeOption3" class="dropdown-item" href="#" data-value='3'>Pasaporte</a>
                                                    <a id="DocumentNumberTypeOption4" class="dropdown-item" href="#" data-value='4'>Cédula jurídica</a>
                                                </div>
                                            </div>
                                            <input id='DocumentNumber' name='DocumentNumber'
                                                   type='text' class='form-control' size='20'
                                                   maxlength='20' placeholder="0X-XXXX-XXXX">

                                        </div>
                                        <div id='DocumentNumber_validate'></div>
                                    </div>
                                </div>
                                <!-- FirstName -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='FirstName'>Nombre<span class='required-mark'>*</span></label>
                                        <input id='FirstName' name='FirstName' type='text' class='form-control' size='35' maxlength='35'>
                                    </div>
                                </div>
                                <!-- LastName -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='LastName'>Apellidos<span class='required-mark'>*</span></label>
                                        <input id='LastName' name='LastName' type='text' class='form-control' size='35' maxlength='35'>
                                    </div>
                                </div>
                                <!-- BirthDate DatePicker -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='BirthDate'>Fecha de nacimiento</label>
                                        <div class='input-group date' id='BirthDate_group'>
                                            <input type='text' id='BirthDate' name='BirthDate' class='form-control' size='10' maxlength='10' placeholder='día/mes/año' />
                                            <span class='input-group-addon'>
                                                <span class='glyphicon glyphicon-calendar'></span>
                                            </span>
                                        </div>
                                        <div id='BirthDate_validate'></div>
                                    </div>
                                </div>
                                <!-- FailedPasswordCount -->
                                @*<div class='col-sm-4 col-md-4'>
            <div class='form-group'>
                <label class='control-label' for='FailedPasswordCount'>Intentos</label>
                <input id='FailedPasswordCount' name='FailedPasswordCount' type='text' class='form-control text-right' size='3' maxlength='3'>
            </div>
        </div>*@
                                <!-- SecurityLevel -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='SecurityLevel'>Seguridad</label>
                                        <input id='SecurityLevel' name='SecurityLevel' type='text' class='form-control text-right' size='3' maxlength='3'>
                                    </div>
                                </div>
                                <!-- IsLockedOut -->
                                <div class='col-sm-4 col-md-4'>
                                    <div class='form-group'>
                                        <label class='control-label' for='IsLockedOut'>Bloqueado</label>
                                        <br /><div class="custom-control custom-radio custom-control-inline">
                                            <input type="radio" class="custom-control-input" id="IsLockedOuta" name="IsLockedOut" value="true">
                                            <label class="custom-control-label" for="IsLockedOuta">Si</label>
                                        </div>
                                        <div class="custom-control custom-radio custom-control-inline">
                                            <input type="radio" class="custom-control-input" id="IsLockedOutb" name="IsLockedOut" value="false">
                                            <label class="custom-control-label" for="IsLockedOutb">No</label>
                                        </div>
                                        <div id='IsLockedOut_validate'></div>
                                    </div>
                                </div>
                                <!-- LockedOutDate -->
                                @*<div class='col-sm-4 col-md-4'>
            <div class='form-group'>
                <label class='control-label' for='LockedOutDate'>Fecha de bloqueo</label>
                <div class='input-group date' id='LockedOutDate_group'>
                    <input id='LockedOutDate' name='LockedOutDate' type='text'
