@{
    Layout = null;
}

<!DOCTYPE html>
<html>

<head>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Zona de Aliados | Acceso</title>

    @Styles.Render("~/Content/cssBase")
    @Scripts.Render("~/bundles/jsMaster")
    @Styles.Render("~/app/css/Login.css")
    <link rel="shortcut icon" href="~/images/favicon.png" />

    <!-- Google Tag Manager -->
    <script>
        (function (w, d, s, l, i) {
            w[l] = w[l] || []; w[l].push({
                'gtm.start':
                    new Date().getTime(), event: 'gtm.js'
            }); var f = d.getElementsByTagName(s)[0],
                j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : ''; j.async = true; j.src =
                    'https://www.googletagmanager.com/gtm.js?id=' + i + dl; f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', 'GTM-NL4F2ZN');</script>
    <!-- End Google Tag Manager -->

</head>
<body class="gray-bg Mapfre @ViewBag.theme" style="--mapfrered1: rgb(255, 0, 45); --mapfrered2: rgb(255, 0, 45); ">

    <!-- Google Tag Manager (noscript) -->
    <noscript>
        <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NL4F2ZN"
                height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    <div class="container">
        <div class="alert alert-info alert-dismissable fade show di_aleLog d-none ">
            <button data-dismiss="alert" class="close" type="button">×</button>
            Usted ha sido redireccionado a esta página debido a que su sesión de usuario ha superado el tiempo máximo de inactividad.
        </div>

        <form id="LoginEdtForm">

            <img class="logohorizontal" src="~/images/Mapfre-logo.png">
            <h3>Bienvenido a nuestra Zona de Aliados</h3>

            <div class="form-group">
                <div class="input-group Mydis">
                    <input id="Tenant" name="Tenant" type="text" maxlength="60" required="" autocomplete="off" value="" title="Nombre o código del aliado" placeholder="Nombre del Aliado">
                </div>
                <div id='Tenant_validate'></div>
            </div>
            <div class="form-group ">
                <div class="input-group Mydis">
                    <input id="Username" name="Username" type="text" maxlength="60" required="" autocomplete="off" title="Usuario o correo" placeholder="Usuario o Correo" x-webkit-speech>
                </div>
                <div id='Username_validate'></div>
            </div>
            <div class="form-group PasswordCls">
                <div class="input-group Mydis ">
                    <input id="Password" name="Password" type="password" maxlength="70" required="" autocomplete="off" title="Clave de acceso" placeholder="Contraseña">
                    <div id='Password_validate'></div>
                </div>
            </div>
            <div class="form-group accessotpCls d-none" style="margin-bottom: 0px;">
                <p>
                    Hemos enviado a su correo electrónico registrado, un código de verificación el cual deberá ingresar para continuar.
                </p>
                <div class="input-group Mydis ">
                    <input id="accessotp" name="accessotp" type="text" class="desi_In" maxlength="6" required="" autocomplete="off" title="Código de verificación" placeholder="Código de verificación">
                    <div id='accessotp_validate'></div>
                </div>
                <a href="#" id="reset" title="Permite volver a ingresar las credenciales" class="accessotpCls"><small>Cancelar</small></a>
            </div>
            <button id="Send" type="submit" title="Verifica las credenciales de acceso">Iniciar Sesión</button>
            
            <a href="#" id="forgotlink" title="Permite establecer una nueva clave de acceso"><small>Olvidó su clave de acceso?</small></a>
        </form>

    </div>

    <div id="myModal" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <div id="forgo" class="animated fadeInDown  d-none m-t ">
                <div class="text-center forgot_info">
                    <h3>¿Olvidó su clave de acceso?</h3>
                    <p>
                        Ingrese la dirección de correo electrónico asociada a su cuenta, a continuación, le será enviado un código temporal, el cual le permitirá establecer una clave de acceso.
                    </p>
                </div>
                <form id="ForgotEdtForm" class="m-t for_olv" role="form" action="index.html" data-toggle='validator'>
                    <fieldset class="text-center formlog">
                        <div class="form-group">
                            <div class="input-group Mydis">
                                <input id="ForgotMail" name="ForgotMail" type="text" class="desi_In" maxlength="60" required="" autocomplete="off" title="Correo registrado">
                                <label class="lab_desi for_lab"><i class="fa fa-envelope Ilog" aria-hidden="true"></i>  Email</label>
                                <span class="highlight"></span>
                                <span class="bar"></span>
                            </div>
                            <div id='ForgotMail_validate'></div>
                        </div>

                        <button id="ForgotSend" type="submit" class="slidee Des_bot block full-width m-b" title="Envia el código temporal">Continuar</button>
                        <button id="ForgotCancel" type="button" class="slidee Des_bot bot_can block full-width m-b" title="Regresa a la página de inicio">Cancelar</button>
                    </fieldset>
                </form>
            </div>

            <div id="forgoCode" class="animated fadeInDown d-none ">
                <div class="text-center forgot_info">
                    <h3>Ingrese código de verificación</h3>
                    <p>
                        Hemos enviado a su correo electrónico registrado, un código de verificación el cual permitirá continuar con el proceso.
                    </p>
                </div>
                <form id="forgoCodeEdtForm" class="m-t for_olv" role="form" action="index.html" data-toggle='validator'>
                    <fieldset class="text-center formlog">
                        <div class="form-group">
                            <div class="input-group Mydis">

                                <input id="forgoCodeMail" name="forgoCodeMail" type="text" class="desi_In" maxlength="6" required="" autocomplete="off" title="Código de verificación">
                                <label class="lab_desi for_lab"><i class="fa fa-commenting Ilog" aria-hidden="true"></i> Codigo de verificación</label>
                                <span class="highlight"></span>
                                <span class="bar"></span>
                            </div>
                            <div id='forgoCodeMail_validate'></div>
                        </div>

                        <button id="forgoCodeSend" type="submit" class="slidee Des_bot block full-width m-b" title="Verifica el código ingresado">Continuar</button>
                        <button id="forgoCodeCancel" type="button" class="slidee Des_bot bot_can block full-width m-b" title="Regresa a la página de inicio">Cancelar</button>
                    </fieldset>
                </form>
            </div>

            <div id="SetPassword" class="animated fadeInDown d-none ">
                <div class="text-center forgot_info">
                    <h3>Indique su nueva clave de acceso</h3>
                    <p>
                        Ingrese la nueva clave de acceso que quedará asociada a su cuenta.
                    </p>
                </div>
                <form id="SetPasswordEdtForm" class="m-t for_olv" role="form" action="index.html" data-toggle='validator'>
                    <fieldset class="text-center formlog">
                        <div class="form-group">
                            <div class="input-group Mydis">

                                <input id="SetPasswordMail" name="SetPasswordMail" type="password" class="desi_In" maxlength="60" required="" autocomplete="off" title="Nueva clave de acceso">
                                <label class="lab_desi for_lab"><i class="fa fa-lock Ilog" aria-hidden="true"></i> Clave de acceso</label>
                                <span class="highlight"></span>
                                <span class="bar"></span>
                            </div>
                            <div id='SetPasswordMail_validate'></div>
                        </div>
                        <div class="form-group">
                            <div class="input-group Mydis">
                                <input id="SetPasswordMail2" name="SetPasswordMail2" type="password" class="desi_In" maxlength="60" required="" autocomplete="off" title="Verifica la nueva clave de acceso">
                                <label class="lab_desi for_lab"><i class="fa fa-check-circle Ilog" aria-hidden="true"></i> Repita la clave de acceso</label>
                                <span class="highlight"></span>
                                <span class="bar"></span>
                            </div>
                            <div id='SetPasswordMail2_validate'></div>
                        </div>

                        <button id="SetPasswordSend" type="submit" class="slidee Des_bot block full-width m-b" title="Actualiza la nueva clave de acceso">Cambiar clave de acceso</button>
                        <button id="SetPasswordCancel" type="button" class="slidee Des_bot bot_can block full-width m-b" title="Regresa a la página de inicio">Cancelar</button>
                    </fieldset>
                </form>
            </div>
        </div>
    </div>

    <!-- @Scripts.Render("~/bundles/jsMaster") -->
    <script src="@Url.Content("~/Scripts/Security.Login.js")"></script>
    <script>
        function mostrarPassword() {
            var cambio = document.getElementById("Password");
            if (cambio.type == "password") {
                cambio.type = "text";
                $('.icon').removeClass('fa fa-eye-slash').addClass('fa fa-eye');
            } else {
                cambio.type = "password";
                $('.icon').removeClass('fa fa-eye').addClass('fa fa-eye-slash');
            }
        }

        $(document).ready(function () {
            //CheckBox mostrar contraseña
            $('#ShowPassword').click(function () {
                $('#Password').attr('type', $(this).is(':checked') ? 'text' : 'password');
            });
        });
    </script>


</body>

</html>

