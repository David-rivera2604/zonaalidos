    Layout = null;
}

<!DOCTYPE html>
<html>

<head>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Zona de Aliados | Acceso</title>

    @Styles.Render("~/Content/cssBase")
    @Scripts.Render("~/bundles/jsMaster")
