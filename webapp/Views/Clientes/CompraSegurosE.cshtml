                                                </label>
                                                <select id='tipodetercero' name='tipodetercero' class='form-control'>
                                                    <option value="0" selected>Tomador(a)</option>
                                                    <option value="2">Asegurado(a)</option>
                                                    <option value="6">Beneficiario(a)</option>
                                                    <option value="8">Acreedor(a)</option>
                                                </select>
                                            </div>
                                        </div>
                                        <!-- numero de riesgo Text CS/Emision -->
                                        <div class='col-sm-4 col-md-4'>
                                            <div class='form-group'>
                                                <label class='control-label'>
                                                    Número de Riesgo<span class='required-mark'
