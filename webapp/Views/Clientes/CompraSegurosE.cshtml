                    <span aria-hidden="true">&times;</span><span class="sr-only">Cerrar</span>
                </button>
                <h4 class="modal-title">Información de tercero</h4>
                <small class="font-bold">Permite agregar un nuevo terceros o editar uno ya existente</small>
            </div>
            <div class="modal-body">
                <!-- terceros Grid Edit Form CS/Emision -->
