@{
    Layout = "~/Views/_Layout.cshtml";
}
@Styles.Render("~/Content/cssCRUD")
<div class="ibox">
    <div class="ibox-content clients-square mt-2">
        <div id="carouselExampleIndicators" class="carousel slide" data-ride="carousel">
            <ol class="carousel-indicators">
                <li data-target="#carouselExampleIndicators" data-slide-to="0" class="active" id="carrou1"></li>
                <li data-target="#carouselExampleIndicators" data-slide-to="1"></li>
                <li data-target="#carouselExampleIndicators" data-slide-to="2"></li>
                <li data-target="#carouselExampleIndicators" data-slide-to="3"></li>
            </ol>
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <div class="box-img">
                        <p1 id="titulo1">Hogar Total</p1>
                        <p2 id="descripcion1">
                            El seguro de protección total para su hogar.
                            Proteja de robos, incendios, terremotos,
                            inundaciones, deslizamientos y más.
                        </p2>
                        <hr />
                        <p3 id="frase1">
                            Seguro hogar total, más que un seguro, una protección integral.
                        </p3>
                        <hr />
                        <a id="link1" href='https://www.mapfre.cr/seguros-hogar/' target="_blank" class="btn btn-inicio"><i class="fa fa-info-circle"></i> Más información</a>
                    </div>
                    <img id="img1" class="d-block w-100" src="~/app/img/undefined.svg" alt="First slide">
                    <div class="carousel-caption d-none d-md-block text_logC"></div>
                </div>

                <div class="carousel-item">
                    <div class="box-img">
                        <p1 id="titulo2">MAPFRE MÁS</p1>
                        <p2 id="descripcion2">
                            El seguro que le ofrece diferentes coberturas desde
                            responsabilidad civil, colisión y/o vuelco, robo,
                            y coberturas adicionales, entre otras.
                        </p2>
                        <hr />
                        <p3 id="frase2">
                            Pensado para todas las necesidades de los costarricenses.
                        </p3>
                        <hr />
                        <a id="link2" href='https://www.mapfre.cr/seguros-autos/' target="_blank" class="btn btn-inicio"><i class="fa fa-info-circle"></i> Más información</a>
                    </div>
                    <img id="img2" class="d-block w-100" src="~/app/img/undefined.svg" alt="Second slide">
                    <div class="carousel-caption d-none d-md-block text_logC">
                    </div>
                </div>

                <div class="carousel-item">
                    <div class="box-img">
                        <p1 id="titulo3">Multirriesgo</p1>
                        <p2 id="descripcion3">
                            El seguro que se adapta a las necesidades de
                            protección de cada empresa o negocio, para amparar los
                            bienes muebles e inmuebles.
                        </p2>
                        <hr />
                        <p3 id="frase3">
                            Usted hace crecer su negocio, ¡nosotros lo protegemos!
                        </p3>
                        <hr />
                        <a id="link3" href='https://www.mapfre.cr/seguros-empresas/' target="_blank" class="btn btn-inicio"><i class="fa fa-info-circle"></i> Más información</a>
                    </div>
                    <img id="img3" class="d-block w-100" src="~/app/img/undefined.svg" alt="Third slide">
                    <div class="carousel-caption d-none d-md-block text_logC">
                    </div>
                </div>

                <div class="carousel-item">
                    <div class="box-img">
                        <p1 id="titulo4">Multirriesgo</p1>
                        <p2 id="descripcion4">
                            El seguro que se adapta a las necesidades de
                            protección de cada empresa o negocio, para amparar los
                            bienes muebles e inmuebles.
                        </p2>
                        <hr />
                        <p3 id="frase4">
                            Usted hace crecer su negocio, ¡nosotros lo protegemos!
                        </p3>
                        <hr />
                        <a id="link4" href='https://www.mapfre.cr/seguros-empresas/' target="_blank" class="btn btn-inicio"><i class="fa fa-info-circle"></i> Más información</a>
                    </div>
                    <img id="img4" class="d-block w-100" src="~/app/img/undefined.svg" alt="Fourth slide">
                    <div class="carousel-caption d-none d-md-block text_logC">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jsCRUD")
    <script src="@Url.Content("~/assets/sparkline/jquery.sparkline.min.js")"></script>

}