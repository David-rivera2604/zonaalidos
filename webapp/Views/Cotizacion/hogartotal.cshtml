@{
    Layout = "~/Views/_Layout.cshtml";
}
@Styles.Render("~/Content/cssCRUD")
<div class="row">
    <div id="mainBlock" class="col-md-12 p-0">
        <div class="ibox">
            <div class="ibox-title p-0">
                <div class="Title_Prin py-2">
                    <div class="title_design T1">
                        <h5><i class="fa fa-home"></i> <span id="PageTitle">Hogar Total</span></h5><br>
                        <small class="m-l-sm"><span id="PageSubTitle"> Cotización.</span></small>
                    </div>
                    <div class="title_partner T2">
                        <p class="text-muted small">MAPFRE le trae una nueva forma de proteger a su familia, con nuestro seguro Hogar Total. Más que un seguro contra siniestros o robos, es un seguro de protección total para su hogar; 11 riesgos de cobertura básica y 8 coberturas opcionales.</p>
                        <h4 class="text-muted" style="color: #c31f09">Todos los campos que cuentan con asterisco rojo , son obligatorios para continuar.</h4>                    </div>
                    <div class="title_partner T3 text-center">
                        <a href="https://www.mapfre.cr/seguros-cr/seguros/hogar/hogar-total/" target="_blank">Seguro Hogar Total</a>
                        <p class="mt-2 text-center">
                            Más que un seguro, una protección integral.
                        </p>
                    </div>
                </div>
            </div>

            <div class="ibox-content box_design">
                <div class="sk-spinner sk-spinner-wave">
                    <div class="sk-rect1"></div>
                    <div class="sk-rect2"></div>
                    <div class="sk-rect3"></div>
                    <div class="sk-rect4"></div>
                    <div class="sk-rect5"></div>
                </div>
                <div id="generalNotify">
                </div>

                <!-- Edit Form -->
                <div class='form-row'>
                    <!-- Opciones -->
                    <div class="ibox-tools">
                        <a class="fullscreen-link">
                            <i class="fa fa-expand"></i>
                        </a>
                    </div>
                    <div class='col-md-12 m-2'>
                        <div id="VisualizationsEdt" class="animated fadeInRight">
                            <form id='VisualizationsEdtForm' class='form-horizontal' data-toggle='validator'>
                                <fieldset>
                                    <!-- datosgenerales Zone -->
                                    <div class="form-row">
                                        <div class="col-lg-12">

                                            <h4><i class="fa fa-list"></i>  Datos generales</h4>
                                            <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                            <div class="form-row">
                                                <!-- agt_cod DropDownList -->
                                                <div class='col-sm-3 col-md-3 custom_agent d-none'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='agt_cod'>Agente<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <select id='agt_cod' name='agt_cod' class='form-control'>
                                                        </select>
                                                    </div>
                                                </div>
                                                <!-- cod_cuadro_com DropDownList -->
                                                <div class='col-sm-3 col-md-3 custom_agent d-none'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='cod_cuadro_com'>Cuadro de comisiones<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <select id='cod_cuadro_com' name='cod_cuadro_com' class='form-control'>
                                                        </select>
                                                    </div>
                                                </div>
                                                <!-- moneda DropDownList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='moneda'>Moneda</label>
                                                        <select id='moneda' name='moneda' class='form-control'></select>
                                                    </div>
                                                </div>

                                                <!-- fraccionamientodepago DropDownList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='fraccionamientodepago'>Fraccionamiento de pago</label>
                                                        <select id='fraccionamientodepago' name='fraccionamientodepago' class='form-control'></select>
                                                    </div>
                                                </div>

                                                <!-- iniciodevigencia DatePicker -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='iniciodevigencia'>Inicio de vigencia</label>
                                                        <div class='input-group date' id='iniciodevigencia_group'>
                                                            <input type='text' id='iniciodevigencia' name='iniciodevigencia' class='form-control' size='10' maxlength='10' placeholder='día/mes/año' />
                                                            <span class='input-group-addon'>
                                                                <span class='glyphicon glyphicon-calendar'></span>
                                                            </span>
                                                        </div>
                                                        <div id='iniciodevigencia_validate'></div>
                                                    </div>
                                                </div>

                                                <!-- findevigencia DatePicker -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='findevigencia'>Fin de vigencia</label>
                                                        <div class='input-group date' id='findevigencia_group'>
                                                            <input type='text' id='findevigencia' name='findevigencia' class='form-control' size='10' maxlength='10' placeholder='día/mes/año' disabled />
                                                            <span class='input-group-addon'>
                                                                <span class='glyphicon glyphicon-calendar'></span>
                                                            </span>
                                                        </div>
                                                        <div id='findevigencia_validate'></div>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>

                                    <!-- polizagrupo Zone -->
                                    @Html.Partial("_polizagrupo")

                                    <!-- datosdelhogar Zone -->
                                    <div class="form-row">
                                        <div class="col-lg-12">
                                            <h4><i class="fa fa-home"></i> Datos del hogar</h4>
                                            <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                            <div class="form-row">

                                                <!-- pais DropDownList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='pais'>País</label>
                                                        <select id='pais' name='pais' class='form-control' disabled></select>
                                                    </div>
                                                </div>

                                                <!-- provincia DropDownList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='provincia'>Provincia</label>
                                                        <select id='provincia' name='provincia' class='form-control'></select>
                                                    </div>
                                                </div>

                                                <!-- canton DropDownList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='canton'>Cantón</label>
                                                        <select id='canton' name='canton' class='form-control'></select>
                                                    </div>
                                                </div>

                                                <!-- distrito DropDownList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='distrito'>Distrito</label>
                                                        <select id='distrito' name='distrito' class='form-control'></select>
                                                    </div>
                                                </div>

                                                <!-- ocupaciondelriesgo DropDownList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='ocupaciondelriesgo'>Ocupación del riesgo</label>
                                                        <select id='ocupaciondelriesgo' name='ocupaciondelriesgo' class='form-control'></select>
                                                    </div>
                                                </div>

                                                <!-- tipodesuscripcion DropDownList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='tipodesuscripcion'>Tipo de suscripción</label>
                                                        <select id='tipodesuscripcion' name='tipodesuscripcion' class='form-control'></select>
                                                    </div>
                                                </div>

                                                <!-- numerodepisosedificacion DropDownList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='numerodepisosedificacion'>Número de pisos edificación</label>
                                                        <select id='numerodepisosedificacion' name='numerodepisosedificacion' class='form-control'></select>
                                                    </div>
                                                </div>

                                                <!-- tipodeestrucdelaedificacion DropDownList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='tipodeestrucdelaedificacion'>Tipo de estructura de la edificación</label>
                                                        <select id='tipodeestrucdelaedificacion' name='tipodeestrucdelaedificacion' class='form-control'></select>
                                                    </div>
                                                </div>

                                                <!-- mesesaampararporperdrentas Numeric -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='mesesaampararporperdrentas'>Meses a amparar por perdida de rentas<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <input type='text' id='mesesaampararporperdrentas' name='mesesaampararporperdrentas' class='form-control text-right' size='14' maxlength='14' disabled />
                                                    </div>
                                                </div>
                                                <!-- medidasdeseguridad DropDownList -->
                                                <div class='col-sm-3 col-md-4'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='medidasdeseguridad'>Medidas de seguridad</label>
                                                        <select id='medidasdeseguridad' name='medidasdeseguridad' class='form-control' multiple="multiple"></select>
                                                    </div>
                                                </div>

                                                <!-- descuento DropDownList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='descuento'>Descuento</label>
                                                        <select id='descuento' name='descuento' class='form-control'></select>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Coberturas Grid -->
                                    <div class="form-row">
                                        <div class='col-sm-9 col-md-8'>
                                            <!-- coberturas Grid -->
                                            <div class="form-row" id="coberturasRow">
                                                <div class="col-lg-12">
                                                    <div class="form-row">
                                                        <div class='col'>
                                                            <h4><i class="fa fa-check-square"></i> Coberturas<label id="coberturasTbl-validate" class="float-right d-none LabelValidate"></label></h4>
                                                        </div>
                                                        <div class='col-auto'>
                                                            <button type="button" class="btn btn-sm btn-white d-none" title="Al hacer click permite agregar un nuevo Coberturas" data-toggle="modal" id="coberturasNew"> <i class="fa fa-plus"></i> </button>
                                                        </div>
                                                    </div>
                                                    <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                                    <div class="form-row">
                                                        <div class='col-md-12' style="padding-bottom: 20px">
                                                            <div class="table-responsive">
                                                                <table id="coberturasTbl" style="font-size: 11px;">
                                                                </table>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                        <div class='col-sm-3 col-md-4'>
                                            <!-- sumasaseguradas Zone -->
                                            <div class="form-row">
                                                <div class="col-lg-12">
                                                    <div class="form-row">
                                                        <div class='col'>
                                                            <h4><i class="fa fa-plus-square"></i> Sumas aseguradas</h4>
                                                        </div>
                                                    </div>
                                                    <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                                    <div class="form-row">

                                                        <!-- sAEdificio Numeric -->
                                                        <div class='col-sm-12 col-md-6'>
                                                            <div class='form-group'>
                                                                <label class='control-label' for='sAEdificio'>Edificio<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                                <input type='text' id='sAEdificio' name='sAEdificio' class='form-control text-right' size='21' maxlength='21' disabled />
                                                            </div>
                                                        </div>
                                                        <!-- sAObjetosvaliosos Numeric -->
                                                        <div class='col-sm-12 col-md-6'>
                                                            <div class='form-group'>
                                                                <label class='control-label' for='sAObjetosvaliosos'>Objetos valiosos<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                                <input type='text' id='sAObjetosvaliosos' name='sAObjetosvaliosos' class='form-control text-right' size='21' maxlength='21' disabled />
                                                            </div>
                                                        </div>
                                                        <!-- sADomocristalmarmolgranito Numeric -->
                                                        <div class='col-sm-12 col-md-6'>
                                                            <div class='form-group'>
                                                                <label class='control-label' for='sADomocristalmarmolgranito'>Domo, cristal, mármol, granito<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                                <input type='text' id='sADomocristalmarmolgranito' name='sADomocristalmarmolgranito' class='form-control text-right' size='21' maxlength='21' disabled />
                                                            </div>
                                                        </div>
                                                        <!-- sAGastosalquiler Numeric -->
                                                        <div class='col-sm-12 col-md-6'>
                                                            <div class='form-group'>
                                                                <label class='control-label' for='sAGastosalquiler'>Gastos alquiler<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                                <input type='text' id='sAGastosalquiler' name='sAGastosalquiler' class='form-control text-right' size='21' maxlength='21' disabled />
                                                            </div>
                                                        </div>
                                                        <!-- sAPerdidaderentas Numeric -->
                                                        <div class='col-sm-12 col-md-6'>
                                                            <div class='form-group'>
                                                                <label class='control-label' for='sAPerdidaderentas'>Pérdida de rentas<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                                <input type='text' id='sAPerdidaderentas' name='sAPerdidaderentas' class='form-control text-right' size='21' maxlength='21' disabled />
                                                            </div>
                                                        </div>
                                                        <!-- sARespcivil DropDownList -->
                                                        <div class='col-sm-12 col-md-6'>
                                                            <div class='form-group'>
                                                                <label class='control-label' for='sARespcivil'>Responsabilidad civil<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                                <select id='sARespcivil' name='sARespcivil' class='form-control' disabled></select>
                                                            </div>
                                                        </div>

                                                        <!-- sAMobiliario Numeric -->
                                                        <div class='col-sm-12 col-md-6'>
                                                            <div class='form-group'>
                                                                <label class='control-label' for='sAMobiliario'>Mobiliario<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                                <input type='text' id='sAMobiliario' name='sAMobiliario' class='form-control text-right' size='21' maxlength='21' disabled />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>

                                    <!-- Notificaciones  -->
                                    <div id="quoteNotify">
                                    </div>
                                    <!-- Botonera -->
                                    <div class="form-row">
                                        <div class='col-md-12'>
                                            <div class="modal-footer">
                                                <button id="cotizar" type="button" class="btn  btn-primary" data-doing="Cotizando...">
                                                    Cotizar
                                                </button>
                                                <button id="limpiar" type="button" class="btn btn-default" data-doing="Limpiando...">
                                                    Limpiar
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- plandepago Grid -->
                                    <div class="form-row d-none" id="plandepagoRow">
                                        <div class="col-lg-12">
                                            <div class="form-row">
                                                <div class='col'>
                                                    <h4>Plan de pago</h4>
                                                </div>
                                                <div class='col-auto'>
                                                    <button type="button" class="btn btn-sm btn-white d-none" title="Al hacer click permite agregar un nuevo Plan de pago" data-toggle="modal" id="plandepagoNew"> <i class="fa fa-plus"></i> </button>
                                                </div>
                                            </div>
                                            <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                            <div class="form-row">
                                                <div class='col-md-12' style="padding-bottom: 20px">
                                                    <div class="table-responsive">
                                                        <table id="plandepagoTbl" style="font-size: 11px;">
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>


                                </fieldset>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="quoteBlock" class="col-md-3 animated bounceInRight d-none">

        <div class="ibox">
            <div class="ibox-title text-center float-right">
                <div class="quote-title">
                    <h4><i class="fa fa-file-text-o"></i> Resumen de la cotización</h4>
                    <span class="label label-success" style="font-size: small;">Presupuesto #<span id="presupuesto"></span></span>
                </div>
            </div>
            <div class="ibox-content">

                <div class="row">
                    <div class="col-7 col-md-6">
                        <span>
                            Importe total
                        </span>
                        <h2 class="font-bold">
                            <span id="importetotal">0,00</span>
                        </h2>
                    </div>
                    <div class="col-5 col-md-6">
                        <table class="text-muted small">
                            <tr><td style="text-align:right"><span id="primaneta">0,00</span></td><td>Prima neta</td></tr>
                            <tr><td style="text-align:right"><span id="iva">0,00</span></td><td>IVA</td></tr>
                            <tr><td style="text-align:right"><span id="recardoporfraccionamiento">0,00</span></td><td>Recargo</td></tr>
                            <tr class=""><td style="text-align:right"><span id="cuotas">0</span></td><td><a href="#plandepagoRow" title="Ver detalle de las cuotas">Cuotas</a></td></tr>
                        </table>
                    </div>
                </div>
                <hr>
                <div class="m-t-sm">
                    <div class="btn-group">
                        <a id="emitir" href="#" class="btn btn-primary btn-sm"><i class="fa fa-check"></i> Emisión</a>
                        <a id="print" href="#" class="btn btn-white btn-sm"><i class="fa fa-print"></i> Imprimir</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="ibox">
            <div class="ibox-title">
                <h5>Importe por fraccionamiento de pago</h5>
            </div>
            <div class="ibox-content text-center">
                <div class="form-row">
                    <div class='col-md-12' style="padding-bottom: 20px">
                        <div class="table-responsive">
                            <table id="plandepagoporfrecuenciaTbl" style="font-size: 11px;">
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jsCRUD")
    <script src="@Url.Content("~/Scripts/Cotizacion.js")"></script>
    <script src="@Url.Content("~/Scripts/Cotizacion.HogarTotal.js")"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            app.HogarTotal.Init();
        });
    </script>
}