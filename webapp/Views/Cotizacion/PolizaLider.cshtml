@{
    Layout = "~/Views/_Layout.cshtml";
}
@Styles.Render("~/Content/cssCRUD")
<div class="row">
    <div id="mainBlock" class="col-md-12 p-0">
        <div class="ibox">
            <div class="ibox-title p-0">
                <div class="Title_Prin py-2">
                    <div class="title_design T1">
                        <h5><i class="fa fa-car"></i> <span id="PageTitle">Nueva póliza líder</span></h5><br>
                        <small class="m-l-sm"><span id="PageSubTitle"> Cotización.</span></small>
                    </div>
                    <div class="title_partner T2">
                        <p class="text-muted small">En MAPFRE Costa Rica hemos creado una amplia variedad de opciones con excelentes coberturas y valores agregados, pensados para todas las necesidades de los costarricenses.</p>
                    </div>
                    <div class="title_partner T3 text-center">
                        <a href="https://www.mapfre.cr/seguros-cr/seguros/autos/poliza-lider/" target="_blank">Seguro nueva póliza líder</a>
                        <p class="mt-2 text-center">
                            El seguro que le ofrece diferentes coberturas desde responsabilidad civil, colisión y/o vuelco, robo, y coberturas adicionales, entre otras.
                        </p>
                    </div>
                </div>

            </div>
            <div class="ibox-content box_design">
                <div class="sk-spinner sk-spinner-wave">
                    <div class="sk-rect1"></div>
                    <div class="sk-rect2"></div>
                    <div class="sk-rect3"></div>
                    <div class="sk-rect4"></div>
                    <div class="sk-rect5"></div>
                </div>

                <div id="generalNotify">
                </div>

                <!-- Edit Form -->
                <div class='form-row'>
                    <!-- Opciones -->
                    <div class="ibox-tools">
                        <a class="fullscreen-link">
                            <i class="fa fa-expand"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-user">
                            <li>
                                <a href="#" class="dropdown-item tool-refresh"><i class="fa fa-refresh"></i> Recargar la información</a>
                            </li>
                            <li>
                                <a href="#" class="dropdown-item tool-filter"><i class="fa fa-file-excel-o"></i> Exportar a Excel...</a>
                            </li>
                        </ul>
                    </div>
                    <div class='col-md-12 m-2'>
                        <div id="VisualizationsEdt" class="animated fadeInRight">
                            <form id='VisualizationsEdtForm' class='form-horizontal' data-toggle='validator'>
                                <fieldset>
                                    <!-- datosgenerales Zone -->
                                    <div class="form-row">
                                        <div class="col-lg-12">
                                            <h4><i class="fa fa-list"></i> Datos generales</h4>
                                            <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                            <div class="form-row">

                                                <!-- cod_mon DropDownList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='cod_mon'>Moneda<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <select id='cod_mon' name='cod_mon' class='form-control'></select>
                                                    </div>
                                                </div>

                                                <!-- cod_fracc_pago DropDownList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='cod_fracc_pago'>Fraccionamiento de pago<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <select id='cod_fracc_pago' name='cod_fracc_pago' class='form-control'></select>
                                                    </div>
                                                </div>

                                                <!-- fec_efec_poliza DatePicker -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='fec_efec_poliza'>Inicio de vigencia<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <div class='input-group date' id='fec_efec_poliza_group'>
                                                            <input type='text' id='fec_efec_poliza' name='fec_efec_poliza' class='form-control' size='10' maxlength='10' placeholder='día/mes/año' />
                                                            <span class='input-group-addon'>
                                                                <span class='glyphicon glyphicon-calendar'></span>
                                                            </span>
                                                        </div>
                                                        <div id='fec_efec_poliza_validate'></div>
                                                    </div>
                                                </div>

                                                <!-- fec_vcto_poliza DatePicker -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='fec_vcto_poliza'>Fin de vigencia<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <div class='input-group date' id='fec_vcto_poliza_group'>
                                                            <input type='text' id='fec_vcto_poliza' name='fec_vcto_poliza' class='form-control' size='10' maxlength='10' placeholder='día/mes/año' />
                                                            <span class='input-group-addon'>
                                                                <span class='glyphicon glyphicon-calendar'></span>
                                                            </span>
                                                        </div>
                                                        <div id='fec_vcto_poliza_validate'></div>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>

                                    <!-- datosdelvehiculo Zone -->
                                    <div class="form-row">
                                        <div class="col-lg-12">
                                            <h4><i class="fa fa-car"></i> Datos del vehículo</h4>
                                            <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                            <div class="form-row">

                                                <!-- COD_PLAN_AUTO DropDownList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='COD_PLAN_AUTO'>Plan<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <select id='COD_PLAN_AUTO' name='COD_PLAN_AUTO' class='form-control'></select>
                                                    </div>
                                                </div>

                                                <!-- COD_MARCA DropDownList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='COD_MARCA'>Marca<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <select id='COD_MARCA' name='COD_MARCA' class='form-control'></select>
                                                    </div>
                                                </div>

                                                <!-- COD_MODELO DropDownList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='COD_MODELO'>Modelo<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <select id='COD_MODELO' name='COD_MODELO' class='form-control'></select>
                                                    </div>
                                                </div>

                                                <!-- PCT_DCTO_AUTO_PAR DropDownList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='PCT_DCTO_AUTO_PAR'>% de descuento familiar<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <select id='PCT_DCTO_AUTO_PAR' name='PCT_DCTO_AUTO_PAR' class='form-control'></select>
                                                    </div>
                                                </div>

                                                <!-- COD_TIP_VEHI DropDownList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='COD_TIP_VEHI'>Clase del vehículo<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <select id='COD_TIP_VEHI' name='COD_TIP_VEHI' class='form-control'></select>
                                                    </div>
                                                </div>

                                                <!-- COD_USO_VEHI DropDownList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='COD_USO_VEHI'>Uso del vehículo<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <select id='COD_USO_VEHI' name='COD_USO_VEHI' class='form-control'></select>
                                                    </div>
                                                </div>

                                                <!-- ANIO_SUB_MODELO Numeric -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='ANIO_SUB_MODELO'>Año de fabricación<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <input type='text' id='ANIO_SUB_MODELO' name='ANIO_SUB_MODELO' class='form-control text-right' size='4' maxlength='4' />
                                                    </div>
                                                </div>
                                                <!-- MCA_VR RadioButtonList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='MCA_VR'>Tipo de valoración</label>
                                                        <div style="padding-top: 6px;">
                                                            <div class="custom-control custom-radio custom-control-inline">
                                                                <input type="radio" class="custom-control-input" id="MCA_VR_1" name="MCA_VR" value="1">
                                                                <label class="custom-control-label" for="MCA_VR_1">VR</label>
                                                            </div><div class="custom-control custom-radio custom-control-inline">
                                                                <input type="radio" class="custom-control-input" id="MCA_VR_2" name="MCA_VR" value="2">
                                                                <label class="custom-control-label" for="MCA_VR_2">PRA</label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- MCA_DESC_CLIENTE_NUEVO RadioButtonList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='MCA_DESC_CLIENTE_NUEVO'>¿Es cliente nuevo?</label>
                                                        <div style="padding-top: 6px;">
                                                            <div class="custom-control custom-radio custom-control-inline">
                                                                <input type="radio" class="custom-control-input" id="MCA_DESC_CLIENTE_NUEVO_1" name="MCA_DESC_CLIENTE_NUEVO" value="1">
                                                                <label class="custom-control-label" for="MCA_DESC_CLIENTE_NUEVO_1">Si</label>
                                                            </div><div class="custom-control custom-radio custom-control-inline">
                                                                <input type="radio" class="custom-control-input" id="MCA_DESC_CLIENTE_NUEVO_2" name="MCA_DESC_CLIENTE_NUEVO" value="2">
                                                                <label class="custom-control-label" for="MCA_DESC_CLIENTE_NUEVO_2">No </label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- MCA_CERO_KM RadioButtonList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='MCA_CERO_KM'>¿Es cero km?</label>
                                                        <div style="padding-top: 6px;">
                                                            <div class="custom-control custom-radio custom-control-inline">
                                                                <input type="radio" class="custom-control-input" id="MCA_CERO_KM_1" name="MCA_CERO_KM" value="1">
                                                                <label class="custom-control-label" for="MCA_CERO_KM_1">Si</label>
                                                            </div><div class="custom-control custom-radio custom-control-inline">
                                                                <input type="radio" class="custom-control-input" id="MCA_CERO_KM_2" name="MCA_CERO_KM" value="2">
                                                                <label class="custom-control-label" for="MCA_CERO_KM_2">No </label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- MCA_AUTO_GPS RadioButtonList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='MCA_AUTO_GPS'>¿Tiene GPS?</label>
                                                        <div style="padding-top: 6px;">
                                                            <div class="custom-control custom-radio custom-control-inline">
                                                                <input type="radio" class="custom-control-input" id="MCA_AUTO_GPS_1" name="MCA_AUTO_GPS" value="1">
                                                                <label class="custom-control-label" for="MCA_AUTO_GPS_1">Si</label>
                                                            </div><div class="custom-control custom-radio custom-control-inline">
                                                                <input type="radio" class="custom-control-input" id="MCA_AUTO_GPS_2" name="MCA_AUTO_GPS" value="2">
                                                                <label class="custom-control-label" for="MCA_AUTO_GPS_2">No </label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- mca_HogarTotal RadioButtonList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='mca_HogarTotal'>¿Tiene póliza "Hogar Total"?</label>
                                                        <div style="padding-top: 6px;">
                                                            <div class="custom-control custom-radio custom-control-inline">
                                                                <input type="radio" class="custom-control-input" id="mca_HogarTotal_1" name="mca_HogarTotal" value="1">
                                                                <label class="custom-control-label" for="mca_HogarTotal_1">Si</label>
                                                            </div><div class="custom-control custom-radio custom-control-inline">
                                                                <input type="radio" class="custom-control-input" id="mca_HogarTotal_2" name="mca_HogarTotal" value="2">
                                                                <label class="custom-control-label" for="mca_HogarTotal_2">No</label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- MCA_AUTO_GPS_CMS RadioButtonList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='MCA_AUTO_GPS_CMS'>¿Tiene GPS con convenio?</label>
                                                        <div style="padding-top: 6px;">
                                                            <div class="custom-control custom-radio custom-control-inline">
                                                                <input type="radio" class="custom-control-input" id="MCA_AUTO_GPS_CMS_1" name="MCA_AUTO_GPS_CMS" value="1">
                                                                <label class="custom-control-label" for="MCA_AUTO_GPS_CMS_1">Si</label>
                                                            </div><div class="custom-control custom-radio custom-control-inline">
                                                                <input type="radio" class="custom-control-input" id="MCA_AUTO_GPS_CMS_2" name="MCA_AUTO_GPS_CMS" value="2">
                                                                <label class="custom-control-label" for="MCA_AUTO_GPS_CMS_2">No </label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-row">
                                        <div class='col-sm-9 col-md-8'>
                                            <!-- coberturas Grid -->
                                            <div class="form-row">
                                                <div class="col-lg-12">
                                                    <div class="form-row">
                                                        <div class='col'>
                                                            <h4>
                                                                <i class="fa fa-check-square"></i> Coberturas
                                                                <label id="coberturasTbl-validate" class="float-right d-none LabelValidate"></label>
                                                            </h4>

                                                        </div>
                                                    </div>
                                                    <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                                    <div class="form-row">
                                                        <div class='col-md-12' style="padding-bottom: 20px">

                                                            <div class="table-responsive">
                                                                <table id="coberturasTbl" style="font-size: 11px;">
                                                                </table>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                        <div class='col-sm-3 col-md-4'>
                                            <!-- sumasaseguradas Zone -->
                                            <div class="form-row">
                                                <div class="col-lg-12">
                                                    <div class="form-row">
                                                        <div class='col'>
                                                            <h4><i class="fa fa-plus-square"></i> Sumas aseguradas</h4>
                                                        </div>
                                                    </div>
                                                    <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                                    <div class="form-row">

                                                        <!-- Resp_civilSA DropDownList -->
                                                        <div class='col-md-6'>
                                                            <div class='form-group'>
                                                                <label class='control-label' for='Resp_civilSA'>Responsabilidad civil<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                                <select id='Resp_civilSA' name='Resp_civilSA' class='form-control' disabled></select>
                                                            </div>
                                                        </div>

                                                        <!-- Gast_medicSA DropDownList -->
                                                        <div class='col-md-6'>
                                                            <div class='form-group'>
                                                                <label class='control-label' for='Gast_medicSA'>Gastos médicos de ocupantes<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                                <select id='Gast_medicSA' name='Gast_medicSA' class='form-control' disabled></select>
                                                            </div>
                                                        </div>

                                                        <!-- Acc_ConducSA DropDownList -->
                                                        <div class='col-md-6'>
                                                            <div class='form-group'>
                                                                <label class='control-label' for='Acc_ConducSA'>Accidentes al conductor<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                                <select id='Acc_ConducSA' name='Acc_ConducSA' class='form-control' disabled></select>
                                                            </div>
                                                        </div>

                                                        <!-- Valor_VehiSA Numeric -->
                                                        <div class='col-md-6'>
                                                            <div class='form-group'>
                                                                <label class='control-label' for='Valor_VehiSA'>Valor del vehículo asegurado<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                                <input type='text' id='Valor_VehiSA' name='Valor_VehiSA' class='form-control text-right' size='21' maxlength='21' disabled />
                                                            </div>
                                                        </div>
                                                        <!-- Equi_EspeSA Numeric -->
                                                        <div class='col-md-6'>
                                                            <div class='form-group'>
                                                                <label class='control-label' for='Equi_EspeSA'>Equipo especial<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                                <input type='text' id='Equi_EspeSA' name='Equi_EspeSA' class='form-control text-right' size='21' maxlength='21' disabled />
                                                            </div>
                                                        </div>
                                                        <!-- IMP_AUTO_CRI DropDownList -->
                                                        <div class='col-md-6'>
                                                            <div class='form-group'>
                                                                <label class='control-label' for='IMP_AUTO_CRI'>Rotura de cristales<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                                <select id='IMP_AUTO_CRI' name='IMP_AUTO_CRI' class='form-control' disabled></select>
                                                            </div>
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>



                                    <!-- Notificaciones  -->
                                    <div id="quoteNotify">
                                    </div>
                                    <!-- Botonera -->
                                    <div class="form-row">
                                        <div class='col-md-12'>
                                            <div class="modal-footer">
                                                <button id="cotizar" type="button" class="btn  btn-primary" data-doing="Cotizando...">
                                                    Cotizar
                                                </button>
                                                <button id="limpiar" type="button" class="btn btn-default" data-doing="Limpiando...">
                                                    Limpiar
                                                </button>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- plandepago Grid -->
                                    <div class="form-row d-none" id="plandepagoRow">
                                        <div class="col-lg-12">
                                            <div class="form-row">
                                                <div class='col'>
                                                    <h4>Plan de pago</h4>
                                                </div>

                                            </div>
                                            <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                            <div class="form-row">
                                                <div class='col-md-12' style="padding-bottom: 20px">
                                                    <div class="table-responsive">
                                                        <table id="plandepagoTbl" style="font-size: 11px;">
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>
                            </form>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div id="quoteBlock" class="col-md-3 animated bounceInRight d-none">

        <div class="ibox">
            <div class="ibox-title text-center float-right">
                <div class="quote-title">
                    <h4>Resumen de la cotización</h4>
                </div>
            </div>
            <div class="ibox-content">

                <div class="row">
                    <div class="col-7 col-md-6">
                        <span>
                            Importe total
                        </span>
                        <h2 class="font-bold">
                            <span id="importetotal">0,00</span>
                        </h2>
                    </div>
                    <div class="col-5 col-md-6">
                        <table class="text-muted small">
                            <tr><td style="text-align:right"><span id="primaneta">0,00</span></td><td>Prima neta</td></tr>
                            <tr><td style="text-align:right"><span id="iva">0,00</span></td><td>IVA</td></tr>
                            <tr><td style="text-align:right"><span id="recardoporfraccionamiento">0,00</span></td><td>Recargo</td></tr>
                            <tr class=""><td style="text-align:right"><span id="cuotas">0</span></td><td><a href="#plandepagoRow" title="Ver detalle de las cuotas">Cuotas</a></td></tr>
                        </table>
                    </div>
                </div>
                <hr>
                <div class="m-t-sm">
                    <div class="btn-group">
                        <a id="print" href="#" class="btn btn-white btn-sm"><i class="fa fa-print"></i> Imprimir</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="ibox">
            <div class="ibox-title">
                <h5>Importe por fraccionamiento de pago</h5>
            </div>
            <div class="ibox-content text-center">
                <div class="form-row">
                    <div class='col-md-12' style="padding-bottom: 20px">
                        <div class="table-responsive">
                            <table id="plandepagoporfrecuenciaTbl" style="font-size: 11px;">
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jsCRUD")
    <script src="@Url.Content("~/Scripts/Cotizacion.js")"></script>
    <script src="@Url.Content("~/Scripts/Cotizacion.PolizaLider.js")"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            app.CotizacionPolizaLider.Init();
        });
    </script>
}
