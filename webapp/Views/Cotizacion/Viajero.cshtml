@{
    Layout = "~/Views/_Layout.cshtml";
}
@Styles.Render("~/Content/cssCRUD")
<!-- RoleMember -->
    <div class="row">
        <div id="mainBlock" class="col-md-12">
            <div class="ibox">
                <div class="ibox-title">

                    <h5><span id="PageTitle">Seguro de Viaje</span><small class="m-l-sm"><span id="PageSubTitle">   </span></small> </h5>
                    <button id="cotizar" type="button" class="btn  btn-primary" data-doing="Cotizando...">
                        Cotizar
                    </button>
                    <!-- Opciones -->
                    <div class="ibox-tools">
                        <a class="fullscreen-link">
                            <i class="fa fa-expand"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-user">
                            <li>
                                <a href="#" class="dropdown-item tool-refresh"><i class="fa fa-refresh"></i> Recargar la información</a>
                            </li>
                            <li>
                                <a href="#" class="dropdown-item tool-filter"><i class="fa fa-file-excel-o"></i> Exportar a Excel...</a>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="ibox-content">
                    <div class="sk-spinner sk-spinner-wave">
                        <div class="sk-rect1"></div>
                        <div class="sk-rect2"></div>
                        <div class="sk-rect3"></div>
                        <div class="sk-rect4"></div>
                        <div class="sk-rect5"></div>
                    </div>
                    <div id="generalNotify">
                    </div>
                    <!-- Edit Form -->
                    <div class='form-row'>
                        <div class='col-md-12'>
                            <div id="VisualizationsEdt" class="animated fadeInRight">
                                <form id='VisualizationsEdtForm' class='form-horizontal' data-toggle='validator'>
                                    <fieldset>
                                        <!-- datosgenerales Zone -->
                                        <div class="form-row">
                                            <div class="col-lg-12">
                                                <h4>Datos generales</h4>
                                                <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                                <div class="form-row">

                                                    <!-- cod_mon DropDownList -->
                                                    <div class='col-sm-3 col-md-3'>
                                                        <div class='form-group'>
                                                            <label class='control-label' for='cod_mon'>Moneda<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                            <select id='cod_mon' name='cod_mon' class='form-control'>
                                                            </select>
                                                        </div>
                                                    </div>

                                                    <!-- cod_fracc_pago DropDownList -->
                                                    <div class='col-sm-3 col-md-3'>
                                                        <div class='form-group'>
                                                            <label class='control-label' for='cod_fracc_pago'>Fraccionamiento de pago<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                            <select id='cod_fracc_pago' name='cod_fracc_pago' class='form-control'>
                                                            </select>
                                                        </div>
                                                    </div>

                                                    <!-- fec_efec_poliza DatePicker -->
                                                    <div class='col-sm-3 col-md-3'>
                                                        <div class='form-group'>
                                                            <label class='control-label' for='fec_efec_poliza'>Inicio de vigencia<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                            <div class='input-group date' id='fec_efec_poliza_group'>
                                                                <input type='text' id='fec_efec_poliza' name='fec_efec_poliza' class='form-control' size='10' maxlength='10' placeholder='día/mes/año' />
                                                                <span class='input-group-addon'>
                                                                    <span class='glyphicon glyphicon-calendar'></span>
                                                                </span>
                                                            </div>
                                                            <div id='fec_efec_poliza_validate'></div>
                                                        </div>
                                                    </div>

                                                    <!-- fec_vcto_poliza DatePicker -->
                                                    <div class='col-sm-3 col-md-3'>
                                                        <div class='form-group'>
                                                            <label class='control-label' for='fec_vcto_poliza'>Fin de vigencia<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                            <div class='input-group date' id='fec_vcto_poliza_group'>
                                                                <input type='text' id='fec_vcto_poliza' name='fec_vcto_poliza' class='form-control' size='10' maxlength='10' placeholder='día/mes/año' />
                                                                <span class='input-group-addon'>
                                                                    <span class='glyphicon glyphicon-calendar'></span>
                                                                </span>
                                                            </div>
                                                            <div id='fec_vcto_poliza_validate'></div>
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>

                                        <!-- datosdelviaje Zone -->
                                        <div class="form-row">
                                            <div class="col-lg-12">
                                                <h4>Datos del viaje</h4>
                                                <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                                <div class="form-row">

                                                    <!-- TIP_PLAN DropDownList -->
                                                    <div class='col-sm-4 col-md-4'>
                                                        <div class='form-group'>
                                                            <label class='control-label' for='TIP_PLAN'>Plan<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                            <select id='TIP_PLAN' name='TIP_PLAN' class='form-control'>
                                                            </select>
                                                        </div>
                                                    </div>

                                                    <!-- TIP_VIAJE DropDownList -->
                                                    <div class='col-sm-4 col-md-4'>
                                                        <div class='form-group'>
                                                            <label class='control-label' for='TIP_VIAJE'>Tipo de viaje<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                            <select id='TIP_VIAJE' name='TIP_VIAJE' class='form-control'>
                                                            </select>
                                                        </div>
                                                    </div>

                                                    <!-- FEC_VIAJE DatePicker -->
                                                    <div class='col-sm-4 col-md-4'>
                                                        <div class='form-group'>
                                                            <label class='control-label' for='FEC_VIAJE'>Fecha de inicio del viaje<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                            <div class='input-group date' id='FEC_VIAJE_group'>
                                                                <input type='text' id='FEC_VIAJE' name='FEC_VIAJE' class='form-control' size='10' maxlength='10' placeholder='día/mes/año' />
                                                                <span class='input-group-addon'>
                                                                    <span class='glyphicon glyphicon-calendar'></span>
                                                                </span>
                                                            </div>
                                                            <div id='FEC_VIAJE_validate'></div>
                                                        </div>
                                                    </div>

                                                    <!-- DES_DESTINO Text -->
                                                    <div class='col-sm-4 col-md-4'>
                                                        <div class='form-group'>
                                                            <label class='control-label' for='DES_DESTINO'>Lugar de destino<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                            <input type='text' id='DES_DESTINO' name='DES_DESTINO' class='form-control' size='50' maxlength='50' />
                                                        </div>
                                                    </div>
                                                    <!-- FEC_NACIMIENTO DatePicker -->
                                                    <div class='col-sm-4 col-md-4'>
                                                        <div class='form-group'>
                                                            <label class='control-label' for='FEC_NACIMIENTO'>Fecha de nacimiento<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                            <div class='input-group date' id='FEC_NACIMIENTO_group'>
                                                                <input type='text' id='FEC_NACIMIENTO' name='FEC_NACIMIENTO' class='form-control' size='10' maxlength='10' placeholder='día/mes/año' />
                                                                <span class='input-group-addon'>
                                                                    <span class='glyphicon glyphicon-calendar'></span>
                                                                </span>
                                                            </div>
                                                            <div id='FEC_NACIMIENTO_validate'></div>
                                                        </div>
                                                    </div>

                                                    <!-- COD_MODALIDAD DropDownList -->
                                                    <div class='col-sm-4 col-md-4'>
                                                        <div class='form-group'>
                                                            <label class='control-label' for='COD_MODALIDAD'>Modalidad<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                            <select id='COD_MODALIDAD' name='COD_MODALIDAD' class='form-control'>
                                                            </select>
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>

                                        <!-- coberturas Grid -->
                                        <div class="form-row">
                                            <div class="col-lg-12">
                                                <div class="form-row">
                                                    <div class='col'>
                                                        <h4>Coberturas<label id="coberturasTbl-error" class="float-right d-none" style="color: #cc5965;display: inline-block;font-size: 11px;font-weight: normal;"></label></h4>
                                                    </div>

                                                </div>
                                                <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                                <div class="form-row">
                                                    <div class='col-md-12' style="padding-bottom: 20px">
                                                        <div class="table-responsive">
                                                            <table id="coberturasTbl" style="font-size: 11px;">
                                                            </table>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- plandepago Grid -->
                                        <div class="form-row">
                                            <div class="col-lg-12">
                                                <div class="form-row">
                                                    <div class='col'>
                                                        <h4>Plan de pago<label id="plandepagoTbl-error" class="float-right d-none" style="color: #cc5965;display: inline-block;font-size: 11px;font-weight: normal;"></label></h4>
                                                    </div>

                                                </div>
                                                <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                                <div class="form-row">
                                                    <div class='col-md-12' style="padding-bottom: 20px">
                                                        <div class="table-responsive">
                                                            <table id="plandepagoTbl" style="font-size: 11px;">
                                                            </table>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>


                                        @*@ibox-content-footer@*@
                                    </fieldset>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Edit Form End -->
                </div>
            </div>
        </div>
        <div id="quoteBlock" class="col-md-3 animated bounceInRight d-none">

            <div class="ibox">
                <div class="ibox-title">
                    <h5>Resumen de la cotización</h5>
                </div>
                <div class="ibox-content">

                    <div class="row">
                        <div class="col-7 col-md-6">
                            <span>
                                Importe total
                            </span>
                            <h2 class="font-bold">
                                <span id="importetotal">0,00</span>
                            </h2>
                        </div>
                        <div class="col-5 col-md-6">
                            <table class="text-muted small">
                                <tr><td style="text-align:right"><span id="primaneta">0,00</span></td><td>Prima neta</td></tr>
                                <tr><td style="text-align:right"><span id="iva">0,00</span></td><td>IVA</td></tr>
                                <tr><td style="text-align:right"><span id="recardoporfraccionamiento">0,00</span></td><td>Recargo</td></tr>
                                <tr class=""><td style="text-align:right"><span id="cuotas">0</span></td><td><a href="#plandepagoRow" title="Ver detalle de las cuotas">Cuotas</a></td></tr>
                            </table>
                        </div>
                    </div>
                    <hr>
                    <div class="m-t-sm">
                        <div class="btn-group">
                            <a id="emitir" href="#" class="btn btn-primary btn-sm"><i class="fa fa-check"></i> Emisión</a>
                            <a id="print" href="#" class="btn btn-white btn-sm"><i class="fa fa-print"></i> Imprimir</a>
                        </div>
                    </div>
                </div>
            </div>

            @*<div class="ibox">
                <div class="ibox-title">
                    <h5>Importe por fraccionamiento de pago</h5>
                </div>
                <div class="ibox-content text-center">
                    <div class="form-row">
                        <div class='col-md-12' style="padding-bottom: 20px">
                            <div class="table-responsive">
                                <table id="plandepagoporfrecuenciaTbl" style="font-size: 11px;">
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>*@

        </div>
    </div>
                    @section Scripts {
                        @Scripts.Render("~/bundles/jsCRUD")
                        <script src="@Url.Content("~/Scripts/Cotizacion.Viajero.js")"></script>
                        <script type="text/javascript">
                            $(document).ready(function () {
                                app.CotizacionViajero.Init();
                            });
                        </script>
                    }
