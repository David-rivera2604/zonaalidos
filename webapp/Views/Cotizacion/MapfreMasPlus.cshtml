@{
    Layout = "~/Views/_Layout.cshtml";
}
@Styles.Render("~/Content/cssCRUD")
<div class="row">
    <div id="mainBlock" class="col-md-12">
        <div class="ibox">
            <div class="ibox-title">
                <h5><span id="PageTitle">Mapfre Más Plus</span><small class="m-l-sm"><span id="PageSubTitle"> Cotización</span></small> </h5>
                <!-- Opciones -->
                <div class="ibox-tools">
                    <a class="fullscreen-link">
                        <i class="fa fa-expand"></i>
                    </a>
                    <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                        <i class="fa fa-wrench"></i>
                    </a>
                    <ul class="dropdown-menu dropdown-user">
                        <li>
                            <a href="#" class="dropdown-item tool-refresh"><i class="fa fa-refresh"></i> Recargar la información</a>
                        </li>
                        <li>
                            <a href="#" class="dropdown-item tool-filter"><i class="fa fa-file-excel-o"></i> Exportar a Excel...</a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="ibox-content">
                <p class="text-muted small">En MAPFRE Costa Rica hemos creado una amplia variedad de opciones con excelentes coberturas y valores agregados, pensados para todas las necesidades de los costarricenses. <a href="https://www.mapfre.cr/seguros-cr/seguros/autos/" target="_blank">Seguro MAPFRE MÁS PLUS</a>, El seguro que le ofrece diferentes coberturas desde responsabilidad civil, colisión y/o vuelco, robo, y coberturas adicionales.</p>
                <div class="sk-spinner sk-spinner-wave">
                    <div class="sk-rect1"></div>
                    <div class="sk-rect2"></div>
                    <div class="sk-rect3"></div>
                    <div class="sk-rect4"></div>
                    <div class="sk-rect5"></div>
                </div>
                <div id="generalNotify">
                </div>
                <!-- Edit Form -->
                <div class='form-row'>
                    <div class='col-md-12'>
                        <div id="VisualizationsEdt" class="animated fadeInRight">
                            <form id='VisualizationsEdtForm' class='form-horizontal' data-toggle='validator'>
                                <fieldset>
                                    <!-- tipodeproducto Zone -->
                                    <div class="form-row">
                                        <div class="col-md-4 tipodeproductoZone role-Purdy-notvisible">
                                            <h4>Tipo de producto</h4>
                                            <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                            <div class="form-row">

                                                <!-- tipo_prod RadioButtonList -->
                                                <div class='col-sm-12 col-md-12'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='tipo_prod'>Tipo de producto</label>
                                                        <div style="padding-top: 6px;">
                                                            <div class="custom-control custom-radio custom-control-inline">
                                                                <input type="radio" class="custom-control-input" id="tipo_prod_1" name="tipo_prod" value="basico">
                                                                <label class="custom-control-label" for="tipo_prod_1">Básico</label>
                                                            </div>
                                                            <div class="custom-control custom-radio custom-control-inline">
                                                                <input type="radio" class="custom-control-input" id="tipo_prod_2" name="tipo_prod" value="amplio">
                                                                <label class="custom-control-label" for="tipo_prod_2">Amplio</label>
                                                            </div>
                                                            <div class="custom-control custom-radio custom-control-inline">
                                                                <input type="radio" class="custom-control-input" id="tipo_prod_3" name="tipo_prod" value="plus">
                                                                <label class="custom-control-label" for="tipo_prod_3">Plus</label>
                                                            </div>
                                                            <div class="custom-control custom-radio custom-control-inline">
                                                                <input type="radio" class="custom-control-input" id="tipo_prod_4" name="tipo_prod" value="oro">
                                                                <label class="custom-control-label" for="tipo_prod_4">Oro</label>
                                                            </div>
                                                            <div class="custom-control custom-radio custom-control-inline">
                                                                <input type="radio" class="custom-control-input" id="tipo_prod_5" name="tipo_prod" value="plata">
                                                                <label class="custom-control-label" for="tipo_prod_5">Plata</label>
                                                            </div>
                                                            <div class="custom-control custom-radio custom-control-inline">
                                                                <input type="radio" class="custom-control-input" id="tipo_prod_6" name="tipo_prod" value="trebol">
                                                                <label class="custom-control-label" for="tipo_prod_6">Trébol</label>
                                                            </div>
                                                            <div class="custom-control custom-radio custom-control-inline">
                                                                <input type="radio" class="custom-control-input" id="tipo_prod_7" name="tipo_prod" value="trebolrc">
                                                                <label class="custom-control-label" for="tipo_prod_7">Trébol RC</label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>

                                        <!-- datosdelcontratante Zone -->
                                        <div class="col-md-8 contratanteZone">
                                            <h4><i class="fa fa-user-o"></i> Datos del contratante</h4>
                                            <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                            <div class="form-row">

                                                <!-- edad Numeric -->
                                                <div class='col-sm-2 col-md-2'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='edad'>Edad<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <input type='text' id='edad' name='edad' class='form-control text-right' size='14' maxlength='14' />
                                                    </div>
                                                </div>
                                                <!-- mca_sexo DropDownList -->
                                                <div class='col-sm-4 col-md-4'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='mca_sexo'>Sexo<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <select id='mca_sexo' name='mca_sexo' class='form-control'></select>
                                                    </div>
                                                </div>

                                                <!-- nombredelcontratante Text -->
                                                <div class='col-sm-6 col-md-6'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='nombredelcontratante'>Nombre</label>
                                                        <input type='text' id='nombredelcontratante' name='nombredelcontratante' class='form-control' size='40' maxlength='40' />
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>

                                    <!-- datosgenerales Zone -->
                                    <div class="form-row">
                                        <div class="col-lg-12">
                                            <h4><i class="fa fa-list"></i> Datos generales</h4>
                                            <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                            <div class="form-row">

                                                <!-- cod_mon DropDownList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='cod_mon'>Moneda<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <select id='cod_mon' name='cod_mon' class='form-control'></select>
                                                    </div>
                                                </div>

                                                <!-- cod_fracc_pago DropDownList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='cod_fracc_pago'>Fraccionamiento de pago<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <select id='cod_fracc_pago' name='cod_fracc_pago' class='form-control'></select>
                                                    </div>
                                                </div>

                                                <!-- fec_efec_poliza DatePicker -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='fec_efec_poliza'>Inicio de vigencia<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <div class='input-group date' id='fec_efec_poliza_group'>
                                                            <input type='text' id='fec_efec_poliza' name='fec_efec_poliza' class='form-control' size='10' maxlength='10' placeholder='día/mes/año' />
                                                            <span class='input-group-addon'>
                                                                <span class='glyphicon glyphicon-calendar'></span>
                                                            </span>
                                                        </div>
                                                        <div id='fec_efec_poliza_validate'></div>
                                                    </div>
                                                </div>

                                                <!-- fec_vcto_poliza DatePicker -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='fec_vcto_poliza'>Fin de vigencia<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <div class='input-group date' id='fec_vcto_poliza_group'>
                                                            <input type='text' id='fec_vcto_poliza' name='fec_vcto_poliza' class='form-control' size='10' maxlength='10' placeholder='día/mes/año' disabled />
                                                            <span class='input-group-addon'>
                                                                <span class='glyphicon glyphicon-calendar'></span>
                                                            </span>
                                                        </div>
                                                        <div id='fec_vcto_poliza_validate'></div>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>

                                    <!-- polizagrupo Zone -->
                                    <div class="form-row d-none" id="polizagrupoZone">
                                        <div class="col-lg-12">
                                            <h4><i class="fa fa-building"></i> Información de póliza grupo</h4>
                                            <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                            <div class="form-row">

                                                <!-- contrato DropDownList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='contrato'>Contrato<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <select id='contrato' name='contrato' class='form-control' data-autoselect='false'></select>
                                                    </div>
                                                </div>

                                                <!-- subcontrato DropDownList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='subcontrato'>Sub contrato<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <select id='subcontrato' name='subcontrato' class='form-control' data-autoselect='false' disabled></select>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- datosdelvehiculo Zone -->
                                    <div class="form-row">
                                        <div class="col-lg-12">
                                            <h4><i class="fa fa-car"></i> Datos del vehículo</h4>
                                            <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                            <div class="form-row">



                                                <!-- COD_PLAN_AUTO DropDownList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='COD_PLAN_AUTO'>Plan<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <select id='COD_PLAN_AUTO' name='COD_PLAN_AUTO' class='form-control'></select>
                                                    </div>
                                                </div>

                                                <!-- cod_zona_circul DropDownList -->
                                                <div class='col-sm-3 col-md-3 role-Purdy-notvisible'>
