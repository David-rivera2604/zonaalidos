                                                                <label class="custom-control-label" for="MCA_AUTO_GPS_1">Si</label>
                                                            </div><div class="custom-control custom-radio custom-control-inline">
                                                                <input type="radio" class="custom-control-input" id="MCA_AUTO_GPS_2" name="MCA_AUTO_GPS" value="2">
                                                                <label class="custom-control-label" for="MCA_AUTO_GPS_2">No</label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- MCA_AUTO_GPS_CMS RadioButtonList -->
                                                <div class='col-sm-3 col-md-3 role-Purdy-notvisible'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='MCA_AUTO_GPS_CMS'>¿GPS con convenio del ministerio?</label>
                                                        <div style="padding-top: 6px;">
                                                            <div class="custom-control custom-radio custom-control-inline">
                                                                <input type="radio" class="custom-control-input" id="MCA_AUTO_GPS_CMS_1" name="MCA_AUTO_GPS_CMS" value="1">
                                                                <label class="custom-control-label" for="MCA_AUTO_GPS_CMS_1">Si</label>
                                                            </div><div class="custom-control custom-radio custom-control-inline">
                                                                <input type="radio" class="custom-control-input" id="MCA_AUTO_GPS_CMS_2" name="MCA_AUTO_GPS_CMS" value="2">
                                                                <label class="custom-control-label" for="MCA_AUTO_GPS_CMS_2">No</label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- MCA_MONITOREO_GPS RadioButtonList -->
                                                <div class='col-sm-3 col-md-3 role-Purdy-notvisible'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='MCA_MONITOREO_GPS'>¿GPS con monitoreo?</label>
                                                        <div style="padding-top: 6px;">
                                                            <div class="custom-control custom-radio custom-control-inline">
                                                                <input type="radio" class="custom-control-input" id="MCA_MONITOREO_GPS_1" name="MCA_MONITOREO_GPS" value="1">
                                                                <label class="custom-control-label" for="MCA_MONITOREO_GPS_1">Si</label>
