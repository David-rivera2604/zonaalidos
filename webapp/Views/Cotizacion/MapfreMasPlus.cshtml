                                                                <a href="#" id="VehicleModelHelper">
                                                                    <i class="fa fa-filter" aria-hidden="true"></i>
                                                                </a>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- cod_modelo DropDownList -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='cod_modelo'>Modelo<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <select id='cod_modelo' name='cod_modelo' class='form-control'></select>
                                                    </div>
                                                </div>
                                                <!-- cod_sub_modelo DropDownList -->
                                                <div class='col-sm-3 col-md-3 d-none role-Purdy-notvisible'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='cod_sub_modelo'>Sub modelo<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <select id='cod_sub_modelo' name='cod_sub_modelo' class='form-control'></select>
                                                    </div>
                                                </div>

                                                <!-- ANIO_SUB_MODELO Numeric -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='ANIO_SUB_MODELO'>Año del vehículo<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <input type='text' id='ANIO_SUB_MODELO' name='ANIO_SUB_MODELO' class='form-control text-right' size='4' maxlength='4' />
                                                    </div>
                                                </div>

                                                <!-- IMP_VR Numeric -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='IMP_VR'>Valor del vehículo asegurado<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <input type='text' id='IMP_VR' name='IMP_VR' class='form-control text-right' size='21' maxlength='21' />
                                                    </div>
                                                </div>

                                                <!-- NUM_MATRICULA Text -->
                                                <div class='col-sm-3 col-md-3'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='NUM_MATRICULA'>Número de placa</label>
