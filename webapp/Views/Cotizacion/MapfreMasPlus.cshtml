                                                        <label class='control-label' for='cod_marcaHelper'>Marca<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <div class='input-group'>
                                                            <input id='cod_marcaHelper' class="form-control typeahead" type="text" placeholder="Indique el detalle...">
                                                            <span class='input-group-addon' title="Ayuda para ubicar la marca y el modelo">
                                                                <a href="#" id="VehicleModelHelperCancel">
                                                                    <i class="fa fa-level-up" aria-hidden="true"></i>
                                                                </a>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                                <!-- cod_marca DropDownList -->
                                                <div class='col-sm-3 col-md-3 handler-marca'>
                                                    <div class='form-group'>
                                                        <label class='control-label' for='cod_marca'>Marca<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                        <div class='input-group'>
                                                            <select id='cod_marca' name='cod_marca' class='form-control'></select>
