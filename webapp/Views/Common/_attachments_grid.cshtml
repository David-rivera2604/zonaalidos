<!-- Attachment Grid -->
<div class="form-row AttachmentGrid">
    <div class="col-lg-12">
        <div class="form-row">
            <div class='col'>
                <h4><i class="fa fa-file-o"></i> Adjuntos<label id="AttachmentTbl-error" class="float-right d-none LabelValidate"></label></h4>
            </div>
            <div class='col-auto'>
                <button type="button" class="btn btn-sm btn-white" title="Al hacer click permite agregar un nuevo adjunto" data-toggle="modal" id="AttachmentNew"> <i class="fa fa-plus"></i> </button>
                <button type="button" class="btn btn-sm btn-white" title="Al hacer click permite agregar multiples adjuntos"  id="MultiAttachments"> <i class="fa fa-files-o"></i> </button>
            </div>
        </div>
        <div class="hr-line-dashed" style="border-top: 2px solid #e7eaec; margin: 10px 0;"></div>
        <div class="form-row">
            <div class='col-md-12' style="padding-bottom: 20px">
                <div class="table-responsive animated bounceInRight">
                    <table id="AttachmentGridTbl" style="font-size: 12px" class="table table-bordered table-hover table-index"></table>
                </div>
            </div>
        </div>
    </div>
</div>