<div class="chat-activity-list">
</div>
<div class="chat-form">
    <form role="form">
        <div class="form-group">
            <textarea id="newNote" class="form-control"
                      placeholder="Escriba aquí el texto de la nota"
                      style="font-size: 12px;" rows="3"></textarea>
            <div class="d-flex flex-wrap align-items-center justify-content-between" style="gap: 15px;">
                <div class="d-flex flex-wrap " style="gap: 15px;">
                    <div class="custom-control custom-checkbox contactNotify d-none" style="padding-top: 7px;">
                        <input type="checkbox" class="custom-control-input" id="contactNotify">
                        <label class="custom-control-label control-label" for="contactNotify" style="padding-top: 4px; padding-left: 0px; font-weight: normal" title="Enviar notificación al contacto por correo electrónico">Notificar al contacto</label>
                    </div>
                    <div class="custom-control custom-checkbox responsibleNotify d-none" style="padding-top: 7px;">
                        <input type="checkbox" class="custom-control-input" id="responsibleNotify">
                        <label class="custom-control-label control-label" for="responsibleNotify" style="padding-top: 4px; padding-left: 0px; font-weight: normal"  title="Enviar notificación a los responsables de atención por correo electrónico">Notificar a los responsables de atención</label>
                    </div>
                </div>
                <button id="saveNote" type="button"
                        class="btn btn-sm btn-primary m-t-n-xs">
                    <strong>Enviar nota</strong>
                </button>
            </div>


        </div>
    </form>
</div>