                                                        <span class='glyphicon glyphicon-calendar'></span>
                                                    </span>
                                                </div>
                                                <div id='BirthDate_validate'></div>
                                            </div>
                                        </div>
                                        <!-- Gender DropDownList -->
                                        <div class='col-sm-3 col-md-3'>
                                            <div class='form-group'>
                                                <label class='control-label' for='Gender'>Sexo<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                <select id='Gender' name='Gender' class='form-control'></select>
                                            </div>
                                        </div>
                                        <!-- Height Numeric -->
