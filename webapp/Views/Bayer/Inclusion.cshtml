                                        </div>

                                        <!-- Canton DropDownList -->
                                        <div class='col-sm-2 col-md-2'>
                                            <div class='form-group'>
                                                <label class='control-label' for='Canton'>Cantón<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                <select id='Canton' name='Canton' class='form-control'></select>
                                            </div>
                                        </div>

                                        <!-- District DropDownList -->
                                        <div class='col-sm-2 col-md-2'>
                                            <div class='form-group'>
                                                <label class='control-label' for='District'>Distrito<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                <select id='District' name='District' class='form-control'></select>
                                            </div>
                                        </div>

                                        <!-- AddressDetail Text -->
                                        <div class='col-sm-6 col-md-6'>
                                            <div class='form-group'>
                                                <label class='control-label' for='AddressDetail'>Dirección<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                <input type='text' id='AddressDetail' name='AddressDetail' class='form-control' size='60' maxlength='60' />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

