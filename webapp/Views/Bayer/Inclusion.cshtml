                                        <div class='col-sm-2 col-md-2'>
                                            <div class='form-group'>
                                                <label class='control-label' for='RefundBankCode'>Banco<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                <select id='RefundBankCode' name='RefundBankCode' class='form-control'></select>
                                            </div>
                                        </div>

                                        <!-- RefundBankAccount Text -->
                                        <div class='col-sm-4 col-md-4'>
                                            <div class='form-group'>
                                                <label class='control-label' for='RefundBankAccount'>N° cuenta IBAN<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
