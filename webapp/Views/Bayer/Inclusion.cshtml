@{
    Layout = "~/Views/_Layout.cshtml";
}
@Styles.Render("~/Content/cssCRUD")
<!-- RoleMember -->
<div class="ibox">
    <div class="ibox-title p-0">
        <div class='Title_Prin'>
            <div class='title_design T1'>
                <h5><i class="fa fa-clipboard"></i> <span id="PageTitle">Solicitud de inclusión</span></h5>
                <br />
                <small class="m-l-sm"><span id="PageSubTitle">Seguro colectivo y gastos medicos</span></small>
            </div>
            <!-- Opciones -->
            <div class="ibox-tools">
                <a id="print" href="" class="btn btn-primary btn-xs d-none" title="Permite imprimir la solicitud">Imprimir</a>
                <a class="fullscreen-link">
                    <i class="fa fa-expand"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="ibox-content">
        <div class="sk-spinner sk-spinner-wave">
            <div class="sk-rect1"></div>
            <div class="sk-rect2"></div>
            <div class="sk-rect3"></div>
            <div class="sk-rect4"></div>
            <div class="sk-rect5"></div>
        </div>
        <div id="generalNotify">
        </div>
        <!-- Edit Form -->
        <div class='form-row'>
            <div class='col-md-12'>
                <div id="VisualizationsEdt" class="animated fadeInRight">
                    <form id='VisualizationsEdtForm' class='form-horizontal' data-toggle='validator'>
                        <fieldset disabled>

                            <!-- Notificaciones  -->
                            <div id="quoteNotify">
                            </div>

                            <div id="acceptedNotify" class="alert alert-dismissable animated fadeInDown alert-info d-none" role="alert">
                                <p>Su solicitud ya fue aceptada por el personal de RRHH, la misma fue enviada a su correo en forma de un archivo PDF para su respectiva firma digital, según la preferencia indicado por usted al momento de enviar la solicitud a RRHH.</p>
                                <p>Una vez que reciba el correo mencionado, por favor proceda a firma digitalmente el archivo anexo, para luego cargar a este sistema el documento firmado usando el botón de nombre “Cargar la solicitud firmada” que se encuentra en la parte superior de la solicitud.</p>
                            </div>

                            <div class="form-row">
                                <!-- datosdelapoliza Zone -->
                                <div class="col-md">
                                    <h4><i class="fa fa-file-text"></i> Datos de la póliza</h4>
                                    <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                    <div class="form-row">
                                        <!-- ContractorName DropDownList -->
                                        <div class='col-sm-4 col-md-4'>
                                            <div class='form-group'>
                                                <label class='control-label' for='ContractorName'>Filial<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                <select id='ContractorName' name='ContractorName' class='form-control role-Revisor-enabled-bayer'></select>
                                            </div>
                                        </div>
                                        <!-- MainPolicyId Text -->
                                        <div class='col-sm-4 col-md-4'>
                                            <div class='form-group'>
                                                <label class='control-label' for='MainPolicyId'>N° de póliza</label>
                                                <select id='MainPolicyId' name='MainPolicyId' class='form-control' disabled></select>
                                            </div>
                                        </div>
                                        <!-- IssueDate DatePicker -->
                                        <div class='col-sm-4 col-md-4'>
                                            <div class='form-group'>
                                                <label class='control-label' for='IssueDate'>Fecha de ingreso a la póliza<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                <div class='input-group date role-Revisor-enabled-bayer' id='IssueDate_group'>
                                                    <input type='text' id='IssueDate' name='IssueDate' class='form-control role-Revisor-enabled-bayer' size='10' maxlength='10' placeholder='día/mes/año' />
                                                    <span class='input-group-addon'>
                                                        <span class='glyphicon glyphicon-calendar'></span>
                                                    </span>
                                                </div>
                                                <div id='IssueDate_validate'></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Clase Zone -->
                                <div class="col-md-3 role-Revisor-visible d-none">
                                    <h4><i class="fa fa-th-large"></i> Clase</h4>
                                    <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                    <div class="form-row">
                                        <!-- IsLife DropDownList -->
                                        <div class='col tenant-bayer-visible d-none'>
                                            <div class='form-group'>
                                                <label class='control-label' for='IsLife'>Vida<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                <select id='IsLife' name='IsLife' class='form-control role-Revisor-enabled'>
                                                    <option value=""></option>
                                                    <option value="A">A</option>
                                                    <option value="B">B</option>
                                                    <option value="C">C</option>
                                                </select>
                                            </div>
                                        </div>
                                        <!-- IsHealth DropDownList -->
                                        <div class='col'>
                                            <div class='form-group'>
                                                <label class='control-label' for='IsHealth'>Salud<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                <select id='IsHealth' name='IsHealth' class='form-control role-Revisor-enabled'>
                                                    <option value=""></option>
                                                    <option value="A">A</option>
                                                    <option value="B">B</option>
                                                    <option value="C">C</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- datosdelasegurado Zone -->
                            <div class="form-row">
                                <div class="col-lg-12">
                                    <h4><i class="fa fa-user-o"></i> Datos del asegurado</h4>
                                    <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
                                    <div class="form-row">

                                        <!-- DocumentNumber Text -->
                                        <div class='col-sm-3 col-md-3'>
                                            <div class='form-group'>
                                                <label class='control-label' for='DocumentNumber'>Identificación<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                <div class='input-group'>
                                                    <span class='input-group-addon'>
                                                        <span class='glyphicon glyphicon-barcode'></span>
                                                    </span>
                                                    <div class="input-group-prepend">
                                                        <button class="btn btn-default dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-value='1' id="DocumentNumberType">
                                                            Cédula
                                                        </button>
                                                        <div class="dropdown-menu" id="DocumentNumberTypeMenu">
                                                            <a class="dropdown-item active" href="#" data-value='1'>Cédula</a>
                                                            <a class="dropdown-item" href="#" data-value='2'>DIMEX</a>
                                                            <a class="dropdown-item" href="#" data-value='3'>Pasaporte</a>
                                                            <a class="dropdown-item" href="#" data-value='4'>Cédula jurídica</a>
                                                        </div>
                                                    </div>
                                                    <input id='DocumentNumber' name='DocumentNumber'
                                                           type='text' class='form-control' size='20'
                                                           maxlength='20' placeholder="XXXXXXXXX">

                                                </div>
                                                <div id='DocumentNumber_validate'></div>
                                            </div>
                                        </div>
                                        <!-- FirstName Text -->
                                        <div class='col-sm-3 col-md-3'>
                                            <div class='form-group'>
                                                <label class='control-label' for='FirstName'>Nombres<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                <input type='text' id='FirstName' name='FirstName' class='form-control' size='60' maxlength='60' />
                                            </div>
                                        </div>
                                        <!-- LastName Text -->
                                        <div class='col-sm-3 col-md-3'>
                                            <div class='form-group'>
                                                <label class='control-label' for='LastName'>Apellidos<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                <input type='text' id='LastName' name='LastName' class='form-control' size='60' maxlength='60' />
                                            </div>
                                        </div>
                                        <!-- BirthDate DatePicker -->
                                        <div class='col-sm-3 col-md-3'>
                                            <div class='form-group'>
                                                <label class='control-label' for='BirthDate'>Fecha de nacimiento<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
