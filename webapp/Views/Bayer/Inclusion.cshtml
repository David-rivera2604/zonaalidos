                                                        <small class="text-muted">lbs</small>
                                                    </span>
                                                </div>
                                                <div id='Weight_validate'></div>
                                            </div>
                                        </div>
                                        <!-- CivilStatus DropDownList -->
                                        <div class='col-sm-3 col-md-3'>
                                            <div class='form-group'>
                                                <label class='control-label' for='CivilStatus'>Estado civil</label>
                                                <select id='CivilStatus' name='CivilStatus' class='form-control'></select>
                                            </div>
                                        </div>

                                        <!-- CountryOfNationality DropDownList -->
                                        <div class='col-sm-3 col-md-3'>
                                            <div class='form-group'>
                                                <label class='control-label' for='CountryOfNationality'>Nacionalidad<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                <select id='CountryOfNationality' name='CountryOfNationality' class='form-control'></select>
                                            </div>
                                        </div>

                                        <!-- SocialSecurity Text -->
                                        <div class='col-sm-3 col-md-3'>
                                            <div class='form-group'>
                                                <label class='control-label' for='SocialSecurity'>Seguro Social</label>
                                                <input type='text' id='SocialSecurity' name='SocialSecurity' class='form-control' size='60' maxlength='60' />
                                            </div>
                                        </div>
                                        <!-- DominantMember RadioButtonList -->
                                        <div class='col-sm-3 col-md-3'>
                                            <div class='form-group'>
                                                <label class='control-label' for='DominantMember'>Miembro dominante<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                <div style="padding-top: 6px;">
                                                    <div class="custom-control custom-radio custom-control-inline">
                                                        <input type="radio" class="custom-control-input" id="DominantMember_1" name="DominantMember" value="1">
                                                        <label class="custom-control-label" for="DominantMember_1">Izquierdo</label>
                                                    </div><div class="custom-control custom-radio custom-control-inline">
                                                        <input type="radio" class="custom-control-input" id="DominantMember_2" name="DominantMember" value="2">
                                                        <label class="custom-control-label" for="DominantMember_2">Derecho</label>
                                                    </div>
                                                </div>
                                                <div id='DominantMember_validate'></div>
                                            </div>
                                        </div>
                                        <!-- Doctor Text -->
                                        <div class='col-sm-3 col-md-3'>
                                            <div class='form-group'>
                                                <label class='control-label' for='Doctor'>Médico de cabecera</label>
                                                <input type='text' id='Doctor' name='Doctor' class='form-control' size='60' maxlength='60' />
                                            </div>
                                        </div>
                                        <!-- Occupation Text -->
                                        <div class='col-sm-3 col-md-3'>
                                            <div class='form-group'>
                                                <label class='control-label' for='Occupation'>Ocupación</label>
                                                <input type='text' id='Occupation' name='Occupation' class='form-control' size='60' maxlength='60' />
                                            </div>
                                        </div>
                                        <!-- DateEntryWork DatePicker -->
                                        <div class='col-sm-3 col-md-3'>
                                            <div class='form-group'>
                                                <label class='control-label' for='DateEntryWork'>Fecha de Ingreso a trabajar<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                <div class='input-group date role-Revisor-enabled-bayer' id='DateEntryWork_group'>
                                                    <input type='text' id='DateEntryWork' name='DateEntryWork' class='form-control role-Revisor-enabled-bayer' size='10' maxlength='10' placeholder='día/mes/año' disabled />
                                                    <span class='input-group-addon'>
                                                        <span class='glyphicon glyphicon-calendar'></span>
                                                    </span>
                                                </div>
                                                <div id='DateEntryWork_validate'></div>
                                            </div>
                                        </div>
                                        <!-- Número de empleado Text -->
                                        <div class='col-sm-3 col-md-3 role-Revisor-visible d-none'>
                                            <div class='form-group'>
                                                <label class='control-label' for='EmployeeNumber'>Número de empleado</label>
                                                <input type='text' id='EmployeeNumber' name='EmployeeNumber' class='form-control role-Revisor-enabled' size='30' maxlength='30' />
                                            </div>
                                        </div>
                                        <!-- ContinuityDate DatePicker -->
                                        <div class='col-sm-3 col-md-3'>
                                            <div class='form-group'>
                                                <label class='control-label' for='ContinuityDate' title="Continuidad de cobertura">Fecha de continuidad</label>
                                                <div class='input-group date' id='ContinuityDate_group'>
                                                    <input type='text' id='ContinuityDate' name='ContinuityDate' class='form-control' size='10' maxlength='10' placeholder='día/mes/año' />
                                                    <span class='input-group-addon'>
                                                        <span class='glyphicon glyphicon-calendar'></span>
                                                    </span>
                                                </div>
                                                <div id='ContinuityDate_validate'></div>
                                            </div>
                                        </div>

                                        <!-- MonthlySalary Numeric -->
                                        <div class='col-sm-3 col-md-3 tenant-bayer-visible d-none'>
                                            <div class='form-group'>
                                                <label class='control-label' for='MonthlySalary'>Salario mensual<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                <input type='text' id='MonthlySalary' name='MonthlySalary' class='form-control text-right role-Revisor-enabled-bayer' size='21' maxlength='21' />
                                            </div>
                                        </div>

                                        <!-- InsuredAmount Numeric -->
                                        <div class='col-sm-3 col-md-3 role-Revisor-visible d-none'>
                                            <div class='form-group'>
                                                <label class='control-label' for='InsuredAmount'>Suma asegurada<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                <input type='text' id='InsuredAmount' name='InsuredAmount' class='form-control text-right' size='21' maxlength='21' disabled />
                                            </div>
                                        </div>


                                        <!-- PhoneNumber Text -->
                                        <div class='col-sm-3 col-md-3'>
                                            <div class='form-group'>
                                                <label class='control-label' for='PhoneNumber'>Teléfono<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                <div class='input-group'>
                                                    <span class='input-group-addon'>
                                                        <span class='glyphicon glyphicon-earphone'></span>
                                                    </span>
                                                    <div class="input-group-prepend">
                                                        <button class="btn btn-default dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" id="PhoneNumberType" data-value='1'>
                                                            Celular
                                                        </button>
                                                        <div class="dropdown-menu" id="PhoneNumberTypeMenu">
                                                            <a class="dropdown-item active" data-value='1' href="#">Celular</a>
                                                            <a class="dropdown-item" data-value='2' href="#">Habitación</a>
                                                            <a class="dropdown-item" data-value='3' href="#">Oficina</a>
                                                            <a class="dropdown-item" data-value='4' href="#">Fax</a>
                                                        </div>
                                                    </div>
                                                    <input id='PhoneNumber' name='PhoneNumber' type='text' class='form-control' size='9' maxlength='9'>
                                                </div>
                                                <div id='PhoneNumber_validate'></div>
                                            </div>
                                        </div>
                                        <!-- PrimaryEmailAddress Text -->
                                        <div class='col-sm-3 col-md-3'>
                                            <div class='form-group'>
                                                <label class='control-label' for='PrimaryEmailAddress'>Correo electrónico<span class='required-mark' title='Este campo debe ser llenado de forma obligatoria'>*</span></label>
                                                <div class='input-group'>
                                                    <span class='input-group-addon'>
                                                        <span class='glyphicon glyphicon-envelope'></span>
                                                    </span>
                                                    <input id='PrimaryEmailAddress' name='PrimaryEmailAddress' type='text' class='form-control' size='80' maxlength='80'>
                                                </div>
                                                <div id='PrimaryEmailAddress_validate'></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- direccionderesidencia Zone -->
                            <div class="form-row">
                                <div class="col-lg-12">
                                    <h4><i class='fa fa-map-marker'></i> Dirección de residencia</h4>
                                    <div class="hr-line-dashed" style="border-top: 1px solid #e7eaec; margin: 10px 0;"></div>
