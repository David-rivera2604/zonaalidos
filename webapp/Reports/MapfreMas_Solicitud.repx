                  <Cells>
                    <Item1 Ref="1451" ControlType="XRTableCell" Name="tableCell19" Weight="1.4846173517738079" Multiline="true" Text="Correo electrónico autorizado para comunicaciones:" TextAlignment="MiddleLeft" Font="Calibri, 12pt" Padding="2,2,8,0,100">
                      <StylePriority Ref="1452" UseFont="false" UsePadding="false" UseTextAlignment="false" />
                    </Item1>
                    <Item2 Ref="1453" ControlType="XRTableCell" Name="tableCell23" Weight="1.5153826482261921" Multiline="true" TextAlignment="MiddleLeft" Font="Calibri, 12pt" Padding="6,2,8,0,100">
                      <ExpressionBindings>
