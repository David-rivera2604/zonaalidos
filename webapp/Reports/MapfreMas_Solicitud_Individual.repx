            </Item140>
            <Item141 Ref="1231" ControlType="XRLabel" Name="label27" Text="Propósito de relación comercial (Indicar el tipo de seguro que está adquiriendo):" SizeF="366.1161,16" LocationFloat="27.0517349,811.965149" Font="Times New Roman, 8pt" Padding="3,0,0,0,100" Borders="Left, Bottom">
              <StylePriority Ref="1232" UseFont="false" UsePadding="false" UseBorders="false" />
            </Item141>
            <Item142 Ref="1233" ControlType="XRLabel" Name="label26" Text="DESCRIPCIÓN DE LA PÓLIZA" TextAlignment="MiddleCenter" SizeF="699.99,18" LocationFloat="23.0702114,789.964844" ForeColor="White" BackColor="Red" />
            <Item143 Ref="1234" ControlType="XRLabel" Name="label25" Multiline="true" Text="Para efectos del presente contrato declaro expresamente lo siguiente: 1.Tanto mi actividad, como profesión u oficio, son lícitos y los ejerzo dentro de los marcos legales. 2.Los dineros con los que adquirí los bienes relacionados y los utilizados para pagar la prima del presente contrato no provienen de ninguna actividad ílicita de las contempladas en la legislación costarricense. 3.Las declaraciones contenidas en este documento son exactas, completas y verídicas en la forma que aparecen descritas; por lo tanto, la falsedad, omisión o error en ellas, tendrán las consecuencias estipuladas por la ley. 4.Me obligo con la compañía a mantener actualizada la información suministrada, de acuerdo con los procedimientos que para tal efecto tenga dispuesta la compañía. 5.Autorizo a (NOMBRE DE LA ENTIDAD ASEGURADORA), en forma expresa, para reportar,procesar, solicitar, suministrar o divulgar, únicamente a las entidades legalmente autorizadas, de conformidad con la Ley 8204, todo lo relativo a mi información." TextAlignment="TopJustify" SizeF="698.1105,60.95959" LocationFloat="22.070219,929.964844" Font="Times New Roman, 6pt, charSet=0" Padding="2,2,0,0,100">
              <StylePriority Ref="1235" UseFont="false" UseTextAlignment="false" />
            </Item143>
            <Item144 Ref="1236" ControlType="XRLabel" Name="label24" Multiline="true" Text="Lugar y fecha" TextAlignment="TopCenter" SizeF="153.0193,16.48962" LocationFloat="44.69847,1004.47449" Font="Times New Roman, 8pt" Padding="2,2,3,0,100" Borders="Top">
              <StylePriority Ref="1237" UseFont="false" UsePadding="false" UseBorders="false" UseTextAlignment="false" />
            </Item144>
          </Controls>
        </Item1>
      </Bands>
      <ExpressionBindings>
        <Item1 Ref="1238" EventName="BeforePrint" PropertyName="Visible" Expression="[titular].[DocumentNumberType]==4&#xA;" />
      </ExpressionBindings>
    </Item5>
    <Item6 Ref="1239" ControlType="DetailReportBand" Name="UsoDatosPersonales" Level="6" Expanded="false" PageBreak="BeforeBand">
      <Bands>
        <Item1 Ref="1240" ControlType="DetailBand" Name="Detail4" Expanded="false" HeightF="882.209656">
          <Controls>
            <Item1 Ref="1241" ControlType="XRPictureBox" Name="pictureBox3" ImageSource="img," Sizing="Cover" SizeF="295.116333,35.4525833" LocationFloat="247.042969,90.35212" />
            <Item2 Ref="1242" ControlType="XRTable" Name="table2" SizeF="685.3502,630.999939" LocationFloat="32.10642,159.96405" Font="Calibri, 9.75pt" Padding="2,2,0,0,96">
              <Rows>
                <Item1 Ref="1243" ControlType="XRTableRow" Name="tableRow4" Weight="1.9339061531091142">
                  <Cells>
                    <Item1 Ref="1244" ControlType="XRTableCell" Name="tableCell10" Weight="3" Multiline="true" Text="MAPFRE SEGUROS COSTA RICA, S.A.&#xD;&#xA;DECLARACIÓN DE CONSENTIMIENTO PARA USO DE DATOS PERSONALES&#xD;&#xA;(AUTODETERMINACIÓN INFORMATIVA)" TextAlignment="TopCenter" Font="Calibri, 16pt, style=Bold">
                      <StylePriority Ref="1245" UseFont="false" UseTextAlignment="false" />
                    </Item1>
                  </Cells>
                </Item1>
                <Item2 Ref="1246" ControlType="XRTableRow" Name="tableRow5" Weight="1.0636483934472782">
                  <Cells>
                    <Item1 Ref="1247" ControlType="XRTableCell" Name="tableCell13" Weight="3" Multiline="true" TextTrimming="None" Text="En virtud de lo establecido en la Ley No. 8968 “Protección de la persona frente al tratamiento de sus datos personales”, declaro que:" TextAlignment="TopJustify" Font="Calibri, 12pt">
                      <StylePriority Ref="1248" UseFont="false" UseTextAlignment="false" />
                    </Item1>
                  </Cells>
                </Item2>
                <Item3 Ref="1249" ControlType="XRTableRow" Name="tableRow6" Weight="1.6438202663988901">
                  <Cells>
                    <Item1 Ref="1250" ControlType="XRTableCell" Name="tableCell11" Weight="3" Multiline="true" Text="He sido explícitamente informado que los datos proporcionados para la constitución de pólizas de seguro serán procesados internamente para su debido trámite, administración y seguimiento en una base de datos propia de MAPFRE SEGUROS COSTA RICA, S.A., según lo establecido en el Inciso i) del Art. No. 3 de la Ley 8968." TextAlignment="TopJustify" Font="Calibri, 12pt" Padding="18,2,0,0,100">
                      <StylePriority Ref="1251" UseFont="false" UsePadding="false" UseTextAlignment="false" />
                    </Item1>
                  </Cells>
                </Item3>
                <Item4 Ref="1252" ControlType="XRTableRow" Name="tableRow7" Weight="2.7074686560949464">
                  <Cells>
                    <Item1 Ref="1253" ControlType="XRTableCell" Name="tableCell12" Weight="3" Multiline="true" Text="Comprendo que esta información será utilizada únicamente para los fines arriba mencionados y que cualquier condición de cambio será informada debidamente por las vías de comunicación consignadas en la información de la póliza de seguro. De igual forma, adquiero el compromiso directo de comunicar a la Aseguradora sobre cualquier cambio en los mismos y acepto que la omisión en este paso pueda eventualmente conllevar a la extinción del contrato de seguro, según lo establecido en las cláusulas de su contrato." TextAlignment="TopJustify" Font="Calibri, 12pt" Padding="18,2,0,0,100">
                      <StylePriority Ref="1254" UseFont="false" UsePadding="false" UseTextAlignment="false" />
                    </Item1>
                  </Cells>
                </Item4>
                <Item5 Ref="1255" ControlType="XRTableRow" Name="tableRow8" Weight="2.1272968116482893">
                  <Cells>
                    <Item1 Ref="1256" ControlType="XRTableCell" Name="tableCell14" Weight="3" Multiline="true" Text="MAPFRE Seguros Costa Rica, S.A. informa que su base de datos se administra en forma directa por medio de su Unidad de Tecnología de Información y que, en el momento en que sea requerido, este departamento puede brindarle un detalle de los datos personales que permanezcan en la misma según lo confiere la Ley No. 8968 en su Art. 7. Esta solicitud deberá realizarse al siguiente correo electrónico info@mapfre.co.cr mediante nota firmada." TextAlignment="TopJustify" Font="Calibri, 12pt">
                      <StylePriority Ref="1257" UseFont="false" UseTextAlignment="false" />
                    </Item1>
                  </Cells>
                </Item5>
                <Item6 Ref="1258" ControlType="XRTableRow" Name="tableRow9" Weight="0.792901543654217">
                  <Cells>
                    <Item1 Ref="1259" ControlType="XRTableCell" Name="tableCell15" Weight="3" Multiline="true" Text="En acuerdo con la declaración anterior, firmo en San José, Costa Rica al" TextAlignment="TopJustify" Font="Calibri, 12pt" Padding="2,2,8,0,100">
                      <StylePriority Ref="1260" UseFont="false" UsePadding="false" UseTextAlignment="false" />
                    </Item1>
                  </Cells>
                </Item6>
                <Item7 Ref="1261" ControlType="XRTableRow" Name="tableRow10" Weight="0.48347654573124016" TextAlignment="MiddleLeft">
                  <Cells>
                    <Item1 Ref="1262" ControlType="XRTableCell" Name="tableCell16" Weight="0.2888207005644936" Multiline="true" Text="Nombre:" TextAlignment="MiddleLeft" Font="Calibri, 12pt" Padding="2,2,8,0,100">
                      <StylePriority Ref="1263" UseFont="false" UsePadding="false" UseTextAlignment="false" />
                    </Item1>
                    <Item2 Ref="1264" ControlType="XRTableCell" Name="tableCell20" Weight="2.7111792994355062" Multiline="true" TextAlignment="MiddleLeft" Font="Calibri, 12pt" Padding="6,2,8,0,100">
                      <ExpressionBindings>
                        <Item1 Ref="1265" EventName="BeforePrint" PropertyName="Text" Expression="[titular].[nombre] + ' ' + [titular].[apellido1] + ' ' + [titular].[apellido2]&#xA;" />
                      </ExpressionBindings>
                      <StylePriority Ref="1266" UseFont="false" UsePadding="false" UseTextAlignment="false" />
                    </Item2>
                  </Cells>
                  <StylePriority Ref="1267" UseTextAlignment="false" />
                </Item7>
                <Item8 Ref="1268" ControlType="XRTableRow" Name="tableRow12" Weight="0.48347656766384706" TextAlignment="MiddleLeft">
                  <Cells>
                    <Item1 Ref="1269" ControlType="XRTableCell" Name="tableCell18" Weight="0.2888207005644936" Multiline="true" Text="ID:" TextAlignment="MiddleLeft" Font="Calibri, 12pt" Padding="2,2,8,0,100">
                      <StylePriority Ref="1270" UseFont="false" UsePadding="false" UseTextAlignment="false" />
