              <Rows>
                <Item1 Ref="1293" ControlType="XRTableRow" Name="tableRow179" Weight="0.38629872328187892" BackColor="255,192,0,0" Padding="6,2,0,0,100">
                  <Cells>
                    <Item1 Ref="1294" ControlType="XRTableCell" Name="tableCell439" Weight="2.979437223333731" CanGrow="false" Multiline="true" Text="USO EXCLUSIVO DE MAPFRE | COSTA RICA" SnapLineMargin="14,0,0,0,100" TextAlignment="MiddleLeft" Font="Calibri, 12pt, style=Bold" ForeColor="White">
                      <StylePriority Ref="1295" UseFont="false" UseForeColor="false" UseTextAlignment="false" />
                    </Item1>
                  </Cells>
                  <StylePriority Ref="1296" UseBackColor="false" UsePadding="false" />
                </Item1>
                <Item2 Ref="1297" ControlType="XRTableRow" Name="tableRow180" Weight="0.25753244535572661" Font="Calibri, 9.75pt, style=Bold" Borders="All">
