                    <Item2 Ref="1271" ControlType="XRTableCell" Name="tableCell21" Weight="2.7111792994355062" Multiline="true" TextAlignment="MiddleLeft" Font="Calibri, 12pt" Padding="6,2,8,0,100">
                      <ExpressionBindings>
