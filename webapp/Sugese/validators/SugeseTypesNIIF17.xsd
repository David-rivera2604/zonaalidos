<?xml version="1.0" encoding="utf-8"?>
<xs:schema targetNamespace="urn:cap:ties:ressugesetypes:v1" xmlns:res="urn:cap:ties:ressugesetypes:v1" attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:simpleType name="TextoDeDoceCaracteres">
    <xs:annotation>
      <xs:documentation xml:lang="es">
        Corresponde a un texto con doce caracteres exactos
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:minLength value="12"/>
      <xs:maxLength value="12"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TextoDeUnoACincuentaCaracteres">
    <xs:annotation>
      <xs:documentation xml:lang="es">
        Corresponde a un texto un rango de 1 carácter a 50 carácteres.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="50"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="MontoPositivo">
    <xs:annotation>
      <xs:documentation xml:lang="es">
        Monto positivo con dos decimales separado por punto.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0" />
      <xs:fractionDigits value="2"/>
      <xs:totalDigits value="20"/>
      <xs:whiteSpace value="collapse"/>
      <xs:maxInclusive value="999999999999999999.99" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="MontoPositivo15digitos">
    <xs:annotation>
      <xs:documentation xml:lang="es">
        Monto positivo de 15 dígitos con dos decimales separado por punto.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0" />
      <xs:totalDigits value="15"/>
      <xs:fractionDigits value="2"/>
      <xs:whiteSpace value="collapse"/>
      <xs:maxInclusive value="9999999999999.99" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="MontoNegativo">
    <xs:annotation>
      <xs:documentation xml:lang="es">
        Monto no positivo con dos decimales separado por punto.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="-999999999999999999.99" />
      <xs:fractionDigits value="2"/>
      <xs:totalDigits value="20"/>
      <xs:whiteSpace value="collapse"/>
      <xs:maxInclusive value="0" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Monto">
    <xs:annotation>
      <xs:documentation xml:lang="es">
        Monto positivo o no positivo con dos decimales separado por punto.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="-999999999999999999.99" />
      <xs:fractionDigits value="2"/>
      <xs:totalDigits value="20"/>
      <xs:whiteSpace value="collapse"/>
      <xs:maxInclusive value="999999999999999999.99" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="CodEntidad">
    <xs:annotation>
      <xs:documentation xml:lang="es">
        Corresponde al tipo de licencia de una Aseguradora supervisada ej: (A99).
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="A\d{2}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name='Periodicidad'>
    <xs:annotation>
      <xs:documentation xml:lang="es">
        Corresponde a los tipos de enumeración que pueden ser sumistrados en modelos de información.
        A = Anual
        T = Trimestral,
        M = Mensual
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base='xs:string'>
      <xs:enumeration value="M"/>
      <xs:enumeration value="T"/>
      <xs:enumeration value="A"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Fecha">
    <xs:annotation>
      <xs:documentation xml:lang="es">
        Formato de fecha aceptado en los modelos de información (yyyy-MM-dd).
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:date">
      <xs:pattern value="((2[0])\d{2})\-(0[1-9]|1[012])\-(0[1-9]|[12][0-9]|3[01])"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name='TextoNoVacio'>
    <xs:annotation>
      <xs:documentation xml:lang="es">
        Formato de texto que no puede ser vacío.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base='xs:string'>
      <xs:minLength value='1'/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name='CodMoneda'>
    <xs:annotation>
      <xs:documentation xml:lang="es">
        Códigos de monedas aceptados en los modelos de información.
        1 = Colón Costarricense.
        2 = Dólares.
        3 = Colones y Dolares.
        4 = Real brasileño.
        5 = Peso chileno.
        6 = Euro.
        7 = Quetzal.
        8 = Lempira.
        9 = Nuevo peso mexicano.
        10 = Córdoba.
        11 = Yen.
        12 = Ecu.
        13 = Unidades de desarrollo.
        14 = Dólar canadiense.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base='xs:nonNegativeInteger'>
      <xs:enumeration value='1'/>
      <xs:enumeration value='2'/>
      <xs:enumeration value='3'/>
      <xs:enumeration value='4'/>
      <xs:enumeration value='5'/>
      <xs:enumeration value='6'/>
      <xs:enumeration value='7'/>
      <xs:enumeration value='8'/>
      <xs:enumeration value='9'/>
      <xs:enumeration value='10'/>
      <xs:enumeration value='11'/>
      <xs:enumeration value='12'/>
      <xs:enumeration value='13'/>
      <xs:enumeration value='14'/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name='TextoNoVacioStr180'>
    <xs:annotation>
      <xs:documentation xml:lang="es">
        Texto no vacío y con un máximo de 180 caracteres.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base='xs:string'>
      <xs:minLength value='1'/>
      <xs:maxLength value='180'/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name='TextoNoVacioStr20'>
    <xs:annotation>
      <xs:documentation xml:lang="es">
        Texto no vacío y con un máximo de 20 caracteres.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base='xs:string'>
      <xs:minLength value='1'/>
      <xs:maxLength value='20'/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name='TextoNoVacioStr15'>
    <xs:annotation>
      <xs:documentation xml:lang="es">
        Texto no vacío y con un máximo de 15 caracteres.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base='xs:string'>
      <xs:minLength value='1'/>
      <xs:maxLength value='15'/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name='TextoNoVacioStr10'>
    <xs:annotation>
      <xs:documentation xml:lang="es">
        Texto no vacío y con un máximo de 10 caracteres.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base='xs:string'>
      <xs:minLength value='1'/>
      <xs:maxLength value='10'/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="EnteroPositivo">
    <xs:annotation>
      <xs:documentation xml:lang="es">
        Número entero positivo sin decimales.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:integer">
      <xs:fractionDigits value="0"/>
      <xs:minInclusive value="0" />
      <xs:maxInclusive value="999999999999999999"/>
      <xs:whiteSpace value="collapse" />
      <xs:totalDigits value="18"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="EnteroPositivoMayorACero">
    <xs:annotation>
      <xs:documentation xml:lang="es">
        Número entero positivo sin decimales y mayor a cero.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:integer">
      <xs:fractionDigits value="0"/>
      <xs:minInclusive value="1" />
      <xs:maxInclusive value="999999999999999999"/>
      <xs:whiteSpace value="collapse" />
      <xs:totalDigits value="18"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Porcentaje">
    <xs:annotation>
      <xs:documentation xml:lang="es">
        Número posivito con expresión de porcentaje y con 2 decimales.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:fractionDigits value="2"/>
      <xs:pattern value='\d{3}\.\d{2}'/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name='Anno'>
    <xs:annotation>
      <xs:documentation xml:lang='es'>
        Fórmato númerico para referirse al año (yyyy)
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base='xs:positiveInteger'>
      <xs:pattern value='2(\d{3})'/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name='CodCuenta'>
    <xs:annotation>
      <xs:documentation xml:lang="es">
        Fórmato para el código de cuenta
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base='xs:string'>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="MontoPositivoCeroNoIncluido">
    <xs:annotation>
      <xs:documentation xml:lang="es">
        Monto mayor a cero con dos decimales separado por punto.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:minExclusive value="0" />
      <xs:fractionDigits value="2"/>
      <xs:totalDigits value="20"/>
      <xs:whiteSpace value="collapse"/>
      <xs:maxInclusive value="999999999999999999.99" />
    </xs:restriction>
  </xs:simpleType>
</xs:schema>